---
import Base from '../layouts/Base.astro';
---
<Base lang="en" title="404 | Shin Lin" description="Page not found">
  <main style="min-height:100vh;display:grid;place-items:center;text-align:center;padding:16px;position:relative;z-index:1">
    <div>
      <p style="font-family:var(--mono);color:var(--accent);margin:0">HTTP 404 · incident opened</p>
      <h1 style="font-size:64px;margin:8px 0">Not Found</h1>
      <p style="color:var(--muted)">這個頁面不存在 / This page doesn't exist.</p>
      <p><a href="/">← 回首頁</a> · <a href="/en/">Home (EN)</a></p>
    </div>
  </main>
</Base>
