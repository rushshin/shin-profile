---
import { profile, type Lang } from '../data/profile';
import { skillUse } from '../data/visuals';
import { chapters, storyUi } from '../data/story';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const short: Record<string, Record<Lang, string>> = {
  syscom: { zh: '凌群', en: 'SYSCOM' }, 'alpha-networks': { zh: '明泰', en: 'Alpha' }, playsee: { zh: 'Playsee', en: 'Playsee' },
  cathay: { zh: '國泰', en: 'Cathay' }, metamec: { zh: 'MetaMEC', en: 'MetaMEC' },
};
const allSkills = profile.skills.flatMap((g) => g.items);
const firstStop = (skill: string) => chapters.findIndex((c) => skillUse[skill]?.[c.slug]);
const stops = chapters.map((c, i) => ({
  ...c,
  exp: profile.experience.find((e) => e.slug === c.slug)!,
  skills: allSkills.filter((s) => firstStop(s) === i),
}));

// World units; the camera pans across this world with a scroll-driven viewBox.
const G = 540;
const XS = [200, 500, 800, 1100, 1380];
let seed = 23;
const rand = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const pick = <T,>(a: T[]) => a[Math.floor(rand() * a.length)];
type Win = { x: number; y: number; on: number };
const windowsFor = (x: number, y: number, w: number, h: number, base: number, step = 14): Win[] => {
  const out: Win[] = [];
  for (let wy = y + 8; wy < y + h - 9; wy += step) for (let wx = x + 6; wx < x + w - 8; wx += 10) out.push({ x: wx, y: wy, on: base + Math.floor(rand() * 3) });
  return out;
};
const warm = ['#f1dfbf', '#e8c9a0', '#d9a07c', '#c98f8f', '#b7a6cf', '#9cc3a0', '#8fb8b2', '#e8c27a'];
const crowns = ['flat', 'gable', 'step', 'antenna', 'garden', 'dome'] as const;
type Crown = (typeof crowns)[number];
type Bld = { x: number; w: number; h: number; fill: string; on: number; crown: Crown; wins: Win[]; up?: { h: number; on: number; fill: string; crown: Crown; wins: Win[] } };
// Filler buildings sit left of each stop; the right of each stop is kept for its set-piece.
const fillerZones: [number, number, number][] = [[60, 150, 0], [360, 460, 1], [640, 700, 2], [960, 1040, 3], [1230, 1270, 4]];
const fillers: Bld[] = [];
for (const [from, to, i] of fillerZones) {
  let x = from;
  while (x < to) {
    const small = i === 0;
    const w = small ? 30 + Math.round(rand() * 8) : 28 + Math.round(rand() * 18);
    const h = small ? 30 + Math.round(rand() * 12) : 60 + i * 22 + Math.round(rand() * 50);
    const fill = pick(warm);
    const b: Bld = { x, w, h, fill, on: i, crown: small ? 'gable' : pick([...crowns]), wins: windowsFor(x, G - h, w, h, i) };
    if (!small && rand() > 0.35) {
      const uh = 22 + Math.round(rand() * 18);
      b.up = { h: uh, on: i + 1 + Math.floor(rand() * 2), fill: pick(warm), crown: pick([...crowns]), wins: windowsFor(x + 3, G - h - uh, w - 6, uh + 4, i + 1) };
    }
    fillers.push(b);
    x += w + 4 + Math.round(rand() * 5);
  }
}
const skyline = Array.from({ length: 46 }, (_, k) => {
  const x = 10 + k * 34 + Math.round(rand() * 8);
  const w = 24 + Math.round(rand() * 16);
  const h = 50 + Math.round(rand() * 80) + Math.floor(x / 300) * 16;
  const on = Math.max(1, Math.min(4, Math.floor(x / 300)));
  return { x, w, h, on, wins: windowsFor(x, G - 40 - h, w, h, on + 1, 16) };
});
const crownPath = (x: number, y: number, w: number, c: Crown) => {
  if (c === 'gable') return `M${x - 3} ${y} L${x + w / 2} ${y - 13} L${x + w + 3} ${y}Z`;
  if (c === 'step') return `M${x + 4} ${y} V${y - 8} H${x + w - 4} V${y}Z M${x + 10} ${y - 8} V${y - 15} H${x + w - 10} V${y - 8}Z`;
  if (c === 'dome') return `M${x + 3} ${y} A${w / 2 - 3} ${w / 2 - 3} 0 0 1 ${x + w - 3} ${y}Z`;
  if (c === 'garden') return `M${x + 2} ${y} q${w / 4} -10 ${w / 2} 0 q${w / 4} -10 ${w / 2 - 4} 0Z`;
  return '';
};
const crownFill: Record<Crown, string> = { flat: 'none', gable: '#b5654f', step: '#8c7a6b', antenna: 'none', dome: '#7f9db8', garden: '#6fa36c' };
const trees = Array.from({ length: 24 }, (_, k) => ({ x: 30 + k * 64 + Math.round(rand() * 24), r: 8 + Math.round(rand() * 5), on: Math.min(4, Math.floor(k / 5)) }));
const stars = Array.from({ length: 110 }, () => ({ x: Math.round(rand() * 1700) - 50, y: Math.round(rand() * 520) - 380, r: rand() > 0.85 ? 1.8 : 1 }));
const sleepers = Array.from({ length: 140 }, (_, k) => -400 + k * 18);
const arches = Array.from({ length: 34 }, (_, k) => -360 + k * 70);
const reflections = Array.from({ length: 70 }, () => ({ x: Math.round(rand() * 1600), y: G + 80 + Math.round(rand() * 60), w: 10 + Math.round(rand() * 22) }));

// Fibre trunks from stop 2 run back to stop 1 and forward along the line.
// Trunks drop from the first building into a conduit on the viaduct, then rise into each later stop.
const fibre = (dy: number) => `M${XS[0] + 112 + dy} ${G + 40 + dy} H${XS[4] - 60 + dy}`;
// Each stop's riser only appears when that stop is reached, and sits behind the buildings and road.
const risers = [[XS[0] + 112, 1, G - 150], [XS[1] + 70, 1, G - 88], [XS[2] + 120, 2, G - 100], [XS[3] - 30, 3, G - 100], [XS[4] - 60, 4, G - 82]].map(([x, on, top]) => ({ on, d: (dy: number) => `M${x + dy} ${G + 40 + dy} V${top}` }));
const fibres = [{ d: fibre(0), c: '#4fd1e8', dy: 0 }, { d: fibre(5), c: '#f6b44b', dy: 5 }, { d: fibre(10), c: '#e879a6', dy: 10 }];
const terrace = { x: XS[2] - 46, w: 136, y: G - 58 };
const people = Array.from({ length: 12 }, (_, k) => ({ x: terrace.x + 16 + (k % 6) * 20 + Math.round(rand() * 4), y: terrace.y - Math.floor(k / 6) * 15, c: pick(['#e07a5f', '#5b8bd9', '#f2c14e', '#81b29a', '#b07bc9']) }));
const lanterns = Array.from({ length: 34 }, (_, k) => { const x = XS[0] + 20 + k * 22; return { x, y: G - 150 + Math.sin(((k % 8) / 7) * Math.PI) * 14, c: pick(['#ff8a65', '#ffd54f', '#ff7043']) }; });
const vault = { x: XS[3] - 10, w: 130, top: G - 172 };
const campus = { x: XS[4] - 130, w: 170 };
const spire = { x: XS[4] + 58, top: G - 255 };
const prism = { x: spire.x + 14, y: spire.top - 10 };
const heroTops = [[XS[0] + 127, G - 178], [XS[1] + 80, G - 236], [XS[2] + 136, G - 212], [vault.x + vault.w / 2, vault.top]];
// Arcs stay low so they never pass behind the text card on the left.
const arcs = heroTops.map(([x, y]) => `M${prism.x} ${prism.y} C${prism.x - 60} ${G - 30} ${x + 80} ${G - 30} ${x} ${y}`);
const cards = [0, 1, 2, 3].map((k) => `M${XS[2] + 102} ${G - 150 + (k % 2) * 30} Q${XS[2] + 60 - k * 14} ${G - 220} ${terrace.x + 26 + k * 30} ${terrace.y - 36 - (k % 2) * 14}`);
const gate = { x: vault.x - 34, y: G - 112 };
const payPath = `M${XS[2] + 176} ${G - 112} H${vault.x + 6}`;
const routeStops = [...stops.map((s) => short[s.slug][lang]), t(storyUi.end)];
---
<section id="story" class="city-story" data-city>
  <div class="intro-head">
    <h2 class="reveal"><span>01</span>{t(storyUi.title)}</h2>
    <p class="cap reveal">{t(storyUi.caption)}</p>
  </div>

  <div class="track">
    <div class="stage">
      <svg viewBox="0 0 1600 640" preserveAspectRatio="xMidYMax slice" role="img" aria-label={t(storyUi.caption)} data-tod="0">
        <defs>
          <linearGradient id="sky-dawn" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#3c4f8f" /><stop offset=".5" stop-color="#f4a28c" /><stop offset="1" stop-color="#fde2c4" /></linearGradient>
          <linearGradient id="sky-morning" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7ec8e3" /><stop offset="1" stop-color="#eaf4f4" /></linearGradient>
          <linearGradient id="sky-noon" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#4ea8de" /><stop offset="1" stop-color="#caf0f8" /></linearGradient>
          <linearGradient id="sky-gold" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5a4e9c" /><stop offset=".55" stop-color="#f08a5d" /><stop offset="1" stop-color="#fcbf49" /></linearGradient>
          <linearGradient id="sky-night" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0d1b2a" /><stop offset=".8" stop-color="#1b2a4a" /><stop offset="1" stop-color="#2b3560" /></linearGradient>
          <linearGradient id="aurora" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#5ef2c2" stop-opacity="0" /><stop offset=".3" stop-color="#5ef2c2" stop-opacity=".5" /><stop offset=".65" stop-color="#8a7dff" stop-opacity=".42" /><stop offset="1" stop-color="#8a7dff" stop-opacity="0" /></linearGradient>
          <linearGradient id="river" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#7fb6d1" /><stop offset="1" stop-color="#4f8bb0" /></linearGradient>
          <linearGradient id="glass" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#bfe3f2" /><stop offset="1" stop-color="#6fa8c9" /></linearGradient>
          <linearGradient id="spire" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#3b4a72" /><stop offset=".5" stop-color="#6d82b8" /><stop offset="1" stop-color="#3b4a72" /></linearGradient>
          <radialGradient id="sunglow"><stop offset="0" stop-color="#fff3c4" stop-opacity=".9" /><stop offset="1" stop-color="#ffb37a" stop-opacity="0" /></radialGradient>
          <radialGradient id="dawnglow" cx=".5" cy="1" r=".8"><stop offset="0" stop-color="#ffb38a" stop-opacity=".9" /><stop offset="1" stop-color="#ffb38a" stop-opacity="0" /></radialGradient>
          <radialGradient id="beam"><stop offset="0" stop-color="#e6f6ff" stop-opacity=".95" /><stop offset="1" stop-color="#9fd3ff" stop-opacity="0" /></radialGradient>
          <radialGradient id="lantern"><stop offset="0" stop-color="#ffe7a8" stop-opacity=".9" /><stop offset="1" stop-color="#ffb74d" stop-opacity="0" /></radialGradient>
          <filter id="soft"><feGaussianBlur stdDeviation="6" /></filter>
        </defs>

        <rect x="-400" y="-4400" width="2400" height="5440" fill="url(#sky-dawn)" />
        <rect x="-400" y="-4400" width="2400" height="5440" fill="url(#sky-morning)" class="fade" data-on="1" />
        <rect x="-400" y="-4400" width="2400" height="5440" fill="url(#sky-noon)" class="fade" data-on="2" />
        <rect x="-400" y="-4400" width="2400" height="5440" fill="url(#sky-gold)" class="fade" data-on="3" />
        <rect x="-400" y="-4400" width="2400" height="5440" fill="url(#sky-night)" class="fade" data-on="4" />

        <g class="fade fade-out" data-on="-1" data-off="1"><circle cx="260" cy="440" r="110" fill="url(#sunglow)" /><circle cx="260" cy="440" r="32" fill="#ffd27a" /></g>
        <g class="fade fade-out" data-on="1" data-off="3"><circle cx="780" cy="90" r="120" fill="url(#sunglow)" opacity=".55" /><circle cx="780" cy="90" r="30" fill="#fff4c2" /></g>
        <g class="fade fade-out" data-on="3" data-off="4"><circle cx="1180" cy="420" r="140" fill="url(#sunglow)" /><circle cx="1180" cy="420" r="38" fill="#ffb86b" /></g>
        <g class="fade" data-on="4">
          {stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" class="twinkle" />)}
          <circle cx="980" cy="20" r="26" fill="#fff6d8" />
          <g class="aurora" filter="url(#soft)">
            <path d="M-200 -20 C200 -120 500 60 900 -40 S1500 -100 1900 0 L1900 70 C1500 -20 1200 120 900 30 S300 -50 -200 60Z" fill="url(#aurora)" />
            <path d="M-100 -140 C300 -220 700 -60 1100 -150 S1600 -170 1900 -100 L1900 -50 C1500 -120 1100 -30 800 -90 S200 -170 -100 -70Z" fill="url(#aurora)" opacity=".7" />
          </g>
        </g>
        <ellipse cx="1560" cy={G} rx="460" ry="300" fill="url(#dawnglow)" class="fade" data-on="5" />
        <ellipse cx="1560" cy={G} rx="200" ry="120" fill="url(#dawnglow)" class="fade" data-on="5" />

        <g class="terrain">
          <g class="cloud" style="--d:80s"><ellipse cx="200" cy="160" rx="70" ry="20" /><ellipse cx="240" cy="146" rx="44" ry="20" /></g>
          <g class="cloud" style="--d:110s;--o:-40s"><ellipse cx="900" cy="70" rx="80" ry="18" /><ellipse cx="860" cy="58" rx="40" ry="16" /></g>
          <g class="cloud" style="--d:95s;--o:-70s"><ellipse cx="1300" cy="190" rx="60" ry="16" /></g>
          <path d="M-400 400 L-200 300 L0 360 L180 270 L380 350 L560 285 L760 350 L960 275 L1160 340 L1360 265 L1560 330 L1800 285 L2000 360 V640 H-400Z" fill="#b9c4d8" opacity=".55" />
          <path d="M-400 430 Q-100 340 200 390 T700 370 T1200 360 T1700 382 T2000 370 V640 H-400Z" fill="#a9c3b0" opacity=".7" />
        </g>
        {[1150, 1270, 1490].map((x, k) => (
          <g class="fade" data-on="4" transform={`translate(${x} ${G - 170 - (k % 2) * 18}) scale(${0.8 + (k % 2) * 0.15})`}>
            <path d="M-2 0 L-4 96 H4 L2 0Z" fill="#c9d3e6" stroke="#ffffff" stroke-width=".8" />
            <g class="spin"><path d="M0 0 L-4 -46 L0 -50 L4 -46Z M0 0 L42 20 L44 25 L38 26Z M0 0 L-40 24 L-42 29 L-36 28Z" fill="#dfe6f3" stroke="#ffffff" stroke-width="1" /><circle r="4" fill="#ffffff" /></g>
          </g>
        ))}
        <path class="terrain" d="M-400 480 Q0 440 400 462 T1100 452 T1800 466 T2000 460 V640 H-400Z" fill="#8fb894" />

        <g>{skyline.map((s) => (
          <g class="fade" data-on={s.on}>
            <rect x={s.x} y={G - 40 - s.h} width={s.w} height={s.h + 40} rx="2" class="far-bld" />
            {s.wins.map((w) => <rect x={w.x} y={w.y} width="4" height="6" class="win far" data-on={w.on + 3} />)}
          </g>
        ))}</g>

        <g class="fade-out pins" data-off="0">
          <path d={`M${XS[0]} ${G - 190} ${XS.slice(1).map((x, i) => `Q${(XS[i] + x) / 2} ${G - 250} ${x} ${G - 190}`).join(' ')}`} fill="none" stroke="#c8553d" stroke-width="5" stroke-dasharray="3 12" stroke-linecap="round" />
          {XS.map((x, i) => (
            <g>
              <path d={`M${x} ${G - 150} L${x - 12} ${G - 178} A18 18 0 1 1 ${x + 12} ${G - 178}Z`} fill="#c8553d" />
              <circle cx={x} cy={G - 190} r="11" fill="#fff" />
              <text x={x} y={G - 184} class="route-num">{i + 1}</text>
              <rect x={x - 42} y={G - 146} width="84" height="24" rx="12" fill="#fffaf0" stroke="#c8553d" stroke-width="1.5" />
              <text x={x} y={G - 129} class="pin-label">{short[stops[i].slug][lang]}</text>
            </g>
          ))}
        </g>
        <g class="fade" data-on="0">{trees.filter((tr) => tr.on <= 1 && (tr.x < XS[0] + 30 || tr.x > XS[0] + 220)).map((tr) => <g><rect x={tr.x - 1.5} y={G - 14} width="3" height="14" fill="#6b4f3a" /><circle cx={tr.x} cy={G - 14 - tr.r * 0.6} r={tr.r} fill="#6fa36c" /></g>)}</g>

        <g class="fade" data-on="2">
          <path d={`M${XS[0] + 20} ${G - 150} ${lanterns.map((l) => `L${l.x} ${l.y - 4}`).join(' ')}`} fill="none" stroke="#6b4f3a" stroke-width="1" />
          {lanterns.map((l) => <g><circle cx={l.x} cy={l.y + 4} r="9" fill="url(#lantern)" class="fade" data-on="3" /><rect x={l.x - 3} y={l.y} width="6" height="8" rx="2.5" fill={l.c} /></g>)}
        </g>

        {risers.map((r) => <g class="rise" data-on={r.on} style={`transform-origin: 0 ${G + 40}px`}>{fibres.map((f) => <path d={r.d(f.dy)} fill="none" stroke={f.c} stroke-width="2.4" />)}</g>)}

        {fillers.map((b) => (
          <g class="rise" data-on={b.on} style={`transform-origin: ${b.x + b.w / 2}px ${G}px`}>
            <rect x={b.x} y={G - b.h} width={b.w} height={b.h} rx="2" fill={b.fill} stroke="#5a4a3c" stroke-opacity=".22" />
            {crownPath(b.x, G - b.h, b.w, b.crown) && <path d={crownPath(b.x, G - b.h, b.w, b.crown)} fill={crownFill[b.crown]} />}
            {b.crown === 'antenna' && <rect x={b.x + b.w / 2 - 1} y={G - b.h - 18} width="2" height="18" fill="#5a4a3c" />}
            {b.wins.map((w) => <rect x={w.x} y={w.y} width="5" height="7" rx="1" class="win" data-on={w.on} />)}
            {b.up && (
              <g class="rise" data-on={b.up.on} style={`transform-origin: ${b.x + b.w / 2}px ${G - b.h}px`}>
                <rect x={b.x + 3} y={G - b.h - b.up.h} width={b.w - 6} height={b.up.h + 1} rx="2" fill={b.up.fill} stroke="#5a4a3c" stroke-opacity=".22" />
                {crownPath(b.x + 3, G - b.h - b.up.h, b.w - 6, b.up.crown) && <path d={crownPath(b.x + 3, G - b.h - b.up.h, b.w - 6, b.up.crown)} fill={crownFill[b.up.crown]} />}
                {b.up.wins.map((w) => <rect x={w.x} y={w.y} width="5" height="6" rx="1" class="win" data-on={w.on} />)}
              </g>
            )}
          </g>
        ))}

        {/* Stop 1 — groundwork: stepped excavation, piers and an open steel frame that is clad at stop 2. */}
        <g class="rise" data-on="0" style={`transform-origin: ${XS[0] + 120}px ${G}px`}>
          {[0, 1, 2, 3].map((k) => <rect x={XS[0] + 75 + k * 32} y={G - 150} width="6" height="150" fill="#c0563f" />)}
          {[0, 1, 2, 3, 4].map((k) => <rect x={XS[0] + 72} y={G - 150 + k * 30} width="108" height="5" fill="#c0563f" />)}
          {[0, 1, 2].map((k) => <path d={`M${XS[0] + 81 + k * 32} ${G - 145 + k * 0} L${XS[0] + 107 + k * 32} ${G - 120}`} stroke="#a8432f" stroke-width="2" />)}
        </g>
        <g class="fade" data-on="1">
          <rect x={XS[0] + 70} y={G - 154} width="114" height="124" rx="3" fill="#f1dfbf" stroke="#5a4a3c" stroke-opacity=".25" />
          {windowsFor(XS[0] + 70, G - 154, 114, 124, 1).map((w) => <rect x={w.x} y={w.y} width="6" height="8" rx="1" class="win" data-on={w.on} />)}
          <rect x={XS[0] + 66} y={G - 162} width="122" height="8" rx="2" fill="#c0563f" />
          <path d={`M${XS[0] + 118} ${G - 162} v-16 m-8 0 h16`} stroke="#5a4a3c" stroke-width="2" />
        </g>
        <g class="crane fade fade-out" data-on="0" data-off="1" aria-hidden="true">
          <path d={`M${XS[0] + 236} ${G} V${G - 230} M${XS[0] + 248} ${G} V${G - 230} ${Array.from({ length: 11 }, (_, k) => `M${XS[0] + 236} ${G - k * 21} L${XS[0] + 248} ${G - k * 21 - 21}`).join(' ')}`} stroke="#e0a43c" stroke-width="2.5" fill="none" />
          <path d={`M${XS[0] + 90} ${G - 236} H${XS[0] + 290} M${XS[0] + 90} ${G - 228} H${XS[0] + 290} M${XS[0] + 242} ${G - 260} L${XS[0] + 90} ${G - 236} M${XS[0] + 242} ${G - 260} L${XS[0] + 290} ${G - 236}`} stroke="#e0a43c" stroke-width="2.5" fill="none" />
          <rect x={XS[0] + 270} y={G - 228} width="22" height="16" fill="#8c7a6b" />
          <g class="hoist">
            <line x1={XS[0] + 128} y1={G - 228} x2={XS[0] + 128} y2={G - 206} stroke="#5a4a3c" stroke-width="1.5" />
            <path d={`M${XS[0] + 128} ${G - 206} L${XS[0] + 114} ${G - 190} M${XS[0] + 128} ${G - 206} L${XS[0] + 142} ${G - 190}`} stroke="#5a4a3c" stroke-width="1.2" />
            <path d={`M${XS[0] + 124} ${G - 210} h8 l-4 4z`} fill="#3d3d3d" />
            <rect x={XS[0] + 112} y={G - 190} width="32" height="16" rx="2" fill="#4fa3c9" class="module" />
          </g>
          <circle cx={XS[0] + 242} cy={G - 262} r="3" fill="#ff6b5b" class="blink" />
        </g>

        {/* Stop 2 — infrastructure: a glass edge substation under a trussed signal arch. */}
        <g class="rise" data-on="1" style={`transform-origin: ${XS[1] + 80}px ${G}px`}>
          <path d={`M${XS[1] + 20} ${G} L${XS[1] + 60} ${G - 210} M${XS[1] + 140} ${G} L${XS[1] + 100} ${G - 210} M${XS[1] + 60} ${G - 210} Q${XS[1] + 80} ${G - 236} ${XS[1] + 100} ${G - 210}`} stroke="#c0563f" stroke-width="5" fill="none" stroke-linecap="round" />
