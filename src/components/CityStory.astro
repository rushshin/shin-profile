          <circle cx="76" cy={G - 26} r="4" fill="#ffd98a" />
        </g>
        {stops.map((s, i) => (
          <g class="fade" data-on="0">
            <rect x={XS[i] - 46} y={G + 42} width="92" height="24" rx="4" class="sign" />
            <text x={XS[i]} y={G + 58.5} class="sign-text">{short[s.slug][lang]}</text>
          </g>
        ))}

        <g class="train" aria-hidden="true">
          <g class="smoke"><circle cx="30" cy="-48" r="7" /><circle cx="36" cy="-60" r="10" /><circle cx="44" cy="-74" r="13" /></g>
          <rect x="-130" y="-32" width="50" height="26" rx="4" fill="#f3e3c3" stroke="#5a4a3c" stroke-opacity=".4" />
          <rect x="-122" y="-26" width="12" height="9" rx="1" class="cabin-win" /><rect x="-102" y="-26" width="12" height="9" rx="1" class="cabin-win" />
          <g class="fade" data-on="1"><rect x="-124" y="-50" width="34" height="18" rx="2" fill="#2f4a68" stroke="#9fc3df" stroke-width="1" />{[0, 1, 2].map((r) => <g><rect x="-120" y={-47 + r * 5} width="26" height="3" rx="1" fill="#1d2c40" /><circle cx="-97" cy={-45.5 + r * 5} r="1.2" class="led" /></g>)}</g>
          <rect x="-74" y="-32" width="50" height="26" rx="4" fill="#8fb8b2" stroke="#5a4a3c" stroke-opacity=".4" />
          <rect x="-66" y="-26" width="12" height="9" rx="1" class="cabin-win" /><rect x="-46" y="-26" width="12" height="9" rx="1" class="cabin-win" />
          <rect x="-16" y="-36" width="58" height="30" rx="5" fill="#c8553d" />
          <rect x="-13" y="-52" width="22" height="18" rx="3" fill="#a8432f" />
          <rect x="-9" y="-48" width="13" height="9" rx="1" class="cabin-win" />
          <rect x="24" y="-50" width="9" height="15" fill="#3d3d3d" />
          <circle cx="44" cy="-18" r="4" fill="#ffe08a" />
          <path d="M46 -18 L96 -28 V-8Z" fill="#ffe08a" opacity=".16" class="fade" data-on="4" />
          {[-118, -92, -62, -36, -4, 26].map((cx) => <circle cx={cx} cy="-4" r="6" fill="#3d3d3d" />)}
        </g>
      </svg>

      <div class="bubbles">
        <div class="bubble intro" data-bubble="-1">
          <p class="label">{t(storyUi.route)}</p>
          <h3>{t(storyUi.title)}</h3>
          <p class="line">{t(storyUi.routeHint)}</p>
          <ol class="route-list">{stops.map((s, i) => <li><b>{i + 1}</b>{short[s.slug][lang]}<span>{s.exp.period.slice(0, 4)}</span></li>)}</ol>
        </div>
        {stops.map((s, i) => (
          <div class="bubble" data-bubble={i}>
            <p class="label">{t(s.label)} · {s.exp.period}</p>
            <h3>{t(s.title)}</h3>
            <p class="where">{t(s.exp.company)} — {t(s.exp.role)}</p>
            <p class="line">{t(s.line)}</p>
            {s.skills.length > 0 && (
              <div class="new">
                <span>{t(storyUi.newSkills)}</span>
                <div class="chips">{s.skills.slice(0, 5).map((k) => <span class="chip">{k}</span>)}{s.skills.length > 5 && <span class="chip more">+{s.skills.length - 5}</span>}</div>
              </div>
            )}
          </div>
        ))}
        <div class="bubble epilogue" data-bubble="5">
          <p class="label">{t(storyUi.epilogueTitle)}</p>
          <h3>{t(storyUi.epilogue)}</h3>
        </div>
      </div>

      <nav class="route" aria-label={t(storyUi.route)}>
        <ol>{routeStops.map((name, i) => <li><button type="button" data-jump={i + 1}><i></i><span>{name}</span></button></li>)}</ol>
      </nav>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-city]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const track = root.querySelector<HTMLElement>('.track')!;
    const train = root.querySelector<SVGGElement>('.train')!;
    const lit = [...svg.querySelectorAll<SVGElement>('[data-on]')];
    const dark = [...svg.querySelectorAll<SVGElement>('[data-off]')];
    const bubbles = [...root.querySelectorAll<HTMLElement>('[data-bubble]')];
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('[data-jump]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const XS = [200, 500, 800, 1100, 1380];
    const HERO = [250, 560, 860, 1140, 1390];
    const G = 540;
    const trainX = [60, ...XS, 1470];
    let stage = -2;

    // Keyframes: the route from afar, each stop with its set-piece kept clear of the text bubble, then the city from afar.
    const cams = () => {
      const narrow = innerWidth < innerHeight;
      const close = narrow ? 300 : 780;
      const shift = narrow ? 0 : close * 0.16;
      const wide = narrow ? { cx: 820, w: 760 } : { cx: 780, w: 1700 };
      return [wide, ...HERO.map((x) => ({ cx: x - shift, w: close })), narrow ? { cx: 1250, w: 720 } : { cx: 840, w: 1720 }];
    };
    const ease = (f: number) => { const g = Math.min(1, Math.max(0, (f - 0.3) / 0.55)); return g * g * (3 - 2 * g); };

    const setStage = (s: number) => {
      if (s === stage) return;
      stage = s;
      svg.dataset.tod = String(Math.max(0, Math.min(4, s)));
      lit.forEach((el) => el.classList.toggle('on', Number(el.dataset.on) <= s));
      dark.forEach((el) => el.classList.toggle('gone', Number(el.dataset.off) <= s));
      jumps.forEach((b, i) => { b.classList.toggle('passed', i < s); b.classList.toggle('here', i === s); b.setAttribute('aria-current', String(i === s)); });
      if (s >= 0) dispatchEvent(new CustomEvent('bgm:chapter', { detail: s }));
    };

    const progress = () => {
      const r = track.getBoundingClientRect();
      const span = r.height - innerHeight;
      return { r, span, p: span > 0 ? Math.max(0, Math.min(1, -r.top / span)) : 0 };
    };

    const frame = () => {
      const k = progress().p * 6;
      const i = Math.min(5, Math.floor(k));
      const e = ease(k - i);
      const c = cams();
      const a = c[i], b = c[Math.min(6, i + 1)];
      const cx = a.cx + (b.cx - a.cx) * e;
      const w = a.w + (b.w - a.w) * e;
      const h = w * svg.clientHeight / Math.max(1, svg.clientWidth);
      // Bottom edge sits in the river so station plaques clear the route-map overlay.
      // Phones: pin the skyline just under the text card; desktop: keep the river at the bottom edge.
      const top = innerWidth < innerHeight ? (G - 275) - 0.3 * h : G + 130 + w * 0.03 - h;
      svg.setAttribute('viewBox', `${(cx - w / 2).toFixed(1)} ${top.toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`);
      const tx = trainX[i] + (trainX[Math.min(6, i + 1)] - trainX[i]) * e;
      train.style.transform = `translate(${tx.toFixed(1)}px, ${G + 30}px)`;
      setStage(Math.min(5, Math.floor(k - 0.35)));
      const near = Math.round(k);
      bubbles.forEach((el) => el.classList.toggle('show', Number(el.dataset.bubble) === near - 1 && Math.abs(k - near) < 0.32));
    };

    jumps.forEach((b) => b.addEventListener('click', () => {
      const { r, span } = progress();
      scrollTo({ top: scrollY + r.top + (Number(b.dataset.jump) / 6) * span, behavior: reduce ? 'auto' : 'smooth' });
    }));

    let raf = 0;
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; frame(); }); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    frame();
  });
</script>

<style>
  .city-story { position: relative; padding-top: 72px; scroll-margin-top: 64px; }
