---
import { profile, type Lang } from '../data/profile';
import { skillUse } from '../data/visuals';
import { chapters, storyUi } from '../data/story';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const short: Record<string, Record<Lang, string>> = {
  syscom: { zh: '凌群', en: 'SYSCOM' }, 'alpha-networks': { zh: '明泰', en: 'Alpha' }, playsee: { zh: 'Playsee', en: 'Playsee' },
  cathay: { zh: '國泰', en: 'Cathay' }, metamec: { zh: 'MetaMEC', en: 'MetaMEC' },
};
const allSkills = profile.skills.flatMap((g) => g.items);
const firstStop = (skill: string) => chapters.findIndex((c) => skillUse[skill]?.[c.slug]);
const stops = chapters.map((c, i) => ({
  ...c,
  exp: profile.experience.find((e) => e.slug === c.slug)!,
  skills: allSkills.filter((s) => firstStop(s) === i),
}));

// World units; the camera pans across this world with a scroll-driven viewBox.
const W = 1600;
const GROUND = 540;
const XS = [190, 490, 790, 1090, 1400];
let seed = 11;
const rand = () => { seed = (seed * 16807) % 2147483647; return (seed - 1) / 2147483646; };
const palette = ['#f1dfbf', '#d99a76', '#8fb8b2', '#a9b4c8', '#e8c27a', '#c98f8f', '#b7a6cf', '#9cc3a0'];
type Win = { x: number; y: number; on: number };
type Floor = { x: number; y: number; w: number; h: number; on: number; wins: Win[] };
type Bld = { x: number; w: number; h: number; fill: string; on: number; roof: boolean; wins: Win[]; floors: Floor[] };
const windowsFor = (x: number, y: number, w: number, h: number, base: number): Win[] => {
  const out: Win[] = [];
  for (let wy = y + 9; wy < y + h - 10; wy += 15) for (let wx = x + 6; wx < x + w - 8; wx += 11) out.push({ x: wx, y: wy, on: base + Math.floor(rand() * 3) });
  return out;
};
const districts = XS.map((cx, i) => {
  const blds: Bld[] = [];
  const count = i === 4 ? 4 : 6;
  let x = cx - 140;
  for (let b = 0; b < count; b++) {
    const house = i < 2 && rand() > 0.5;
    const w = house ? 32 + Math.round(rand() * 10) : 34 + Math.round(rand() * 24);
    const h = house ? 34 + Math.round(rand() * 18) : 50 + i * 22 + Math.round(rand() * 60);
    const floors: Floor[] = [];
    let top = GROUND - h;
    for (let f = 1; f <= 2; f++) {
      if (house || rand() < 0.35) continue;
      const fh = 18 + Math.round(rand() * 10);
      top -= fh;
      floors.push({ x: x + 3, y: top, w: w - 6, h: fh, on: i + f, wins: windowsFor(x + 3, top, w - 6, fh + 6, i + f) });
    }
    blds.push({ x, w, h, fill: palette[(i * 3 + b) % palette.length], on: i, roof: house || rand() > 0.7, wins: windowsFor(x, GROUND - h, w, h, i), floors });
    x += w + 5 + Math.round(rand() * 8);
    if (i === 4 && b === 1) x += 170;
  }
  return { cx, i, blds };
});
const trees = Array.from({ length: 26 }, (_, k) => {
  const x = 40 + k * 60 + Math.round(rand() * 24);
  const near = XS.reduce((best, cx, i) => (Math.abs(cx - x) < Math.abs(XS[best] - x) ? i : best), 0);
  return { x, r: 9 + Math.round(rand() * 6), on: near + 1 };
});
const lamps = Array.from({ length: 22 }, (_, k) => ({ x: 70 + k * 70, on: Math.min(4, Math.floor(k / 4.4)) + 1 }));
const stars = Array.from({ length: 70 }, () => ({ x: Math.round(rand() * W), y: Math.round(rand() * 360) - 200, r: rand() > 0.85 ? 1.8 : 1 }));
const sleepers = Array.from({ length: Math.ceil(W / 18) }, (_, k) => k * 18);
const tower = { x: XS[4] + 150, w: 56, h: 330 };
const towerWins = windowsFor(tower.x, GROUND - tower.h + 20, tower.w, tower.h - 20, 4).map((w) => ({ ...w, on: 4 + (w.on % 2) }));
const dc = { x: XS[4] - 50, w: 180, h: 70 };
const routeStops = [...stops.map((s) => short[s.slug][lang]), t(storyUi.end)];
---
<section id="story" class="city-story" data-city>
  <div class="intro-head">
    <h2 class="reveal"><span>01</span>{t(storyUi.title)}</h2>
    <p class="cap reveal">{t(storyUi.caption)}</p>
  </div>

  <div class="track">
    <div class="stage">
      <svg viewBox="0 0 1600 640" preserveAspectRatio="xMidYMax slice" role="img" aria-label={t(storyUi.caption)}>
        <defs>
          <linearGradient id="sky-day" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#9fd2ee" /><stop offset="1" stop-color="#fbeed3" /></linearGradient>
          <linearGradient id="sky-dusk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#6c7fbd" /><stop offset=".65" stop-color="#f2a98a" /><stop offset="1" stop-color="#fcd9a4" /></linearGradient>
          <linearGradient id="sky-night" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#0f1530" /><stop offset=".75" stop-color="#28365e" /><stop offset="1" stop-color="#46497a" /></linearGradient>
          <radialGradient id="beam"><stop offset="0" stop-color="#fff3c4" stop-opacity=".95" /><stop offset="1" stop-color="#fff3c4" stop-opacity="0" /></radialGradient>
          <radialGradient id="lampglow"><stop offset="0" stop-color="#ffd98a" stop-opacity=".8" /><stop offset="1" stop-color="#ffd98a" stop-opacity="0" /></radialGradient>
        </defs>

        <rect x="-400" y="-4400" width="2400" height="5040" fill="url(#sky-day)" />
        <rect x="-400" y="-4400" width="2400" height="5040" fill="url(#sky-dusk)" class="fade" data-on="2" />
        <rect x="-400" y="-4400" width="2400" height="5040" fill="url(#sky-night)" class="fade" data-on="3" />
        <g class="fade" data-on="3">{stars.map((s) => <circle cx={s.x} cy={s.y} r={s.r} fill="#fff" class="twinkle" />)}</g>
        <circle cx="1240" cy="120" r="30" fill="#fff6d8" class="fade" data-on="3" />
        <circle cx="300" cy="110" r="34" fill="#ffe7a8" class="fade-out" data-off="3" />

        <g class="clouds">
          <g class="cloud" style="--d:80s"><ellipse cx="200" cy="140" rx="70" ry="20" /><ellipse cx="240" cy="126" rx="44" ry="20" /></g>
          <g class="cloud" style="--d:110s;--o:-40s"><ellipse cx="900" cy="90" rx="80" ry="18" /><ellipse cx="860" cy="78" rx="40" ry="16" /></g>
          <g class="cloud" style="--d:95s;--o:-70s"><ellipse cx="1300" cy="170" rx="60" ry="16" /></g>
        </g>
        <g class="balloon fade" data-on="2"><ellipse cx="700" cy="200" rx="18" ry="22" fill="#e07a5f" /><path d="M690 218 L696 232 H704 L710 218" fill="none" stroke="#5a4a3c" stroke-width="1" /><rect x="695" y="232" width="10" height="7" fill="#b5654f" /></g>

        <path d="M-400 420 Q-100 330 200 380 T700 360 T1200 350 T1700 372 T2000 360 V640 H-400Z" fill="#a9c3b0" opacity=".55" />
        <path d="M-400 470 Q0 420 400 452 T1100 440 T1800 456 T2000 450 V640 H-400Z" fill="#8fb894" opacity=".8" />

        <g class="fade" data-on="1">{trees.filter((tr) => tr.on <= 2).map((tr) => <g><rect x={tr.x - 1.5} y={GROUND - 14} width="3" height="14" fill="#6b4f3a" /><circle cx={tr.x} cy={GROUND - 14 - tr.r * 0.6} r={tr.r} fill="#6fa36c" /></g>)}</g>

        {districts.map((d) => (
          <g class="district">
            {d.blds.map((b) => (
              <g class="rise" data-on={b.on} style={`transform-origin: ${b.x + b.w / 2}px ${GROUND}px`}>
                <rect x={b.x} y={GROUND - b.h} width={b.w} height={b.h} rx="3" fill={b.fill} stroke="#5a4a3c" stroke-opacity=".25" />
                {b.roof && <path d={`M${b.x - 3} ${GROUND - b.h} L${b.x + b.w / 2} ${GROUND - b.h - 13} L${b.x + b.w + 3} ${GROUND - b.h}Z`} fill="#b5654f" />}
                {b.wins.map((w) => <rect x={w.x} y={w.y} width="5" height="7" rx="1" class="win" data-on={w.on} />)}
                {b.floors.map((f) => (
                  <g class="rise" data-on={f.on} style={`transform-origin: ${f.x + f.w / 2}px ${f.y + f.h}px`}>
                    <rect x={f.x} y={f.y} width={f.w} height={f.h + 1} rx="2" fill="#f7eedd" stroke="#5a4a3c" stroke-opacity=".25" />
                    {f.wins.map((w) => <rect x={w.x} y={w.y} width="5" height="6" rx="1" class="win" data-on={w.on} />)}
                  </g>
                ))}
              </g>
            ))}
          </g>
        ))}

        <g class="rise" data-on="0" style={`transform-origin: ${XS[0] + 120}px ${GROUND}px`}>
          <path d={`M${XS[0] + 96} ${GROUND} V${GROUND - 70} H${XS[0] + 146} V${GROUND} M${XS[0] + 96} ${GROUND - 35} H${XS[0] + 146} M${XS[0] + 96} ${GROUND - 70} L${XS[0] + 146} ${GROUND} M${XS[0] + 146} ${GROUND - 70} L${XS[0] + 96} ${GROUND}`} fill="none" stroke="#c9a46a" stroke-width="2" class="fade-out" data-off="2" />
        </g>
        <g class="rise" data-on="1" style={`transform-origin: ${XS[1] + 120}px ${GROUND}px`}>
          <path d={`M${XS[1] + 105} ${GROUND} L${XS[1] + 120} ${GROUND - 170} L${XS[1] + 135} ${GROUND} M${XS[1] + 109} ${GROUND - 40} H${XS[1] + 131} M${XS[1] + 113} ${GROUND - 90} H${XS[1] + 127} M${XS[1] + 116} ${GROUND - 130} H${XS[1] + 124}`} fill="none" stroke="#8a8f9e" stroke-width="2.5" />
          <circle cx={XS[1] + 120} cy={GROUND - 172} r="4" fill="#ff6b5b" class="blink" />
          <path d={`M${XS[1] + 104} ${GROUND - 160} q16 -14 32 0 M${XS[1] + 98} ${GROUND - 168} q22 -22 44 0`} fill="none" stroke="#ff9b8f" stroke-width="1.5" class="blink" />
        </g>
        <g class="rise" data-on="2" style={`transform-origin: ${XS[2] + 40}px ${GROUND}px`}>
          <rect x={XS[2] + 10} y={GROUND - 210} width="66" height="40" rx="4" fill="#2b2f45" />
          <rect x={XS[2] + 14} y={GROUND - 206} width="58" height="32" rx="2" class="screen" />
          <path d={`M${XS[2] + 38} ${GROUND - 198} l14 8 l-14 8z`} fill="#fff" />
          <rect x={XS[2] + 41} y={GROUND - 170} width="4" height="40" fill="#2b2f45" />
        </g>
        <g class="rise" data-on="3" style={`transform-origin: ${XS[3] + 20}px ${GROUND}px`}>
          <path d={`M${XS[3] - 40} ${GROUND - 92} L${XS[3] + 20} ${GROUND - 122} L${XS[3] + 80} ${GROUND - 92}Z`} fill="#e9e1cf" stroke="#5a4a3c" stroke-opacity=".3" />
          <rect x={XS[3] - 36} y={GROUND - 92} width="112" height="10" fill="#e9e1cf" />
          {[0, 1, 2, 3, 4].map((k) => <rect x={XS[3] - 30 + k * 22} y={GROUND - 82} width="10" height="72" fill="#f4eee0" stroke="#5a4a3c" stroke-opacity=".2" />)}
          <rect x={XS[3] - 40} y={GROUND - 10} width="120" height="10" fill="#d8cfbb" />
          <path d={`M${XS[3] + 12} ${GROUND - 116} h16 v6 c0 6 -8 10 -8 10 c0 0 -8 -4 -8 -10z`} fill="#c9a03c" />
        </g>
        <g class="rise" data-on="4" style={`transform-origin: ${dc.x + dc.w / 2}px ${GROUND}px`}>
          <rect x={dc.x} y={GROUND - dc.h} width={dc.w} height={dc.h} rx="4" fill="#4a5578" />
          {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => <g>{[0, 1, 2, 3].map((r) => <rect x={dc.x + 12 + k * 21} y={GROUND - dc.h + 12 + r * 13} width="14" height="6" rx="1" class="win ai" data-on={4 + ((k + r) % 2)} />)}</g>)}
          <rect x={dc.x + 6} y={GROUND - dc.h - 8} width={dc.w - 12} height="8" rx="2" fill="#5d6990" />
        </g>
        <g class="rise" data-on="4" style={`transform-origin: ${tower.x + tower.w / 2}px ${GROUND}px`}>
          <rect x={tower.x} y={GROUND - tower.h} width={tower.w} height={tower.h} rx="5" fill="#3d4a6b" />
          <rect x={tower.x + tower.w / 2 - 2} y={GROUND - tower.h - 46} width="4" height="46" fill="#3d4a6b" />
          {towerWins.map((w) => <rect x={w.x} y={w.y} width="5" height="7" rx="1" class="win ai" data-on={w.on} />)}
          <text x={tower.x + tower.w / 2} y={GROUND - tower.h + 15} class="ai-label">AI</text>
        </g>
        <g class="fade" data-on="4">
          <circle cx={tower.x + tower.w / 2} cy={GROUND - tower.h - 48} r="70" fill="url(#beam)" class="pulse" />
          <circle cx={tower.x + tower.w / 2} cy={GROUND - tower.h - 48} r="5" fill="#fff3c4" />
        </g>

        <g class="fade" data-on="2">{trees.filter((tr) => tr.on > 2).map((tr) => <g><rect x={tr.x - 1.5} y={GROUND - 14} width="3" height="14" fill="#6b4f3a" /><circle cx={tr.x} cy={GROUND - 14 - tr.r * 0.6} r={tr.r} fill="#5e9460" /></g>)}</g>

        <g class="crane fade" data-on="0" aria-hidden="true">
          <rect x="-3" y="-230" width="6" height="230" fill="#e0a43c" />
          <rect x="-60" y="-230" width="130" height="6" fill="#e0a43c" />
          <line x1="50" y1="-224" x2="50" y2="-170" stroke="#5a4a3c" stroke-width="1.5" class="hook" />
          <rect x="41" y="-170" width="18" height="12" fill="#d99a76" class="hook" />
        </g>

        <rect x="-400" y={GROUND} width="2400" height={640 - GROUND + 10} fill="#7fae7c" />
        <rect x="-400" y={GROUND + 4} width="2400" height="18" fill="#9a9a9a" class="fade" data-on="1" />
        <g class="fade" data-on="1">{Array.from({ length: 50 }, (_, k) => <rect x={-380 + k * 50} y={GROUND + 12} width="22" height="2" fill="#f3f3f3" />)}</g>
        <g class="cars fade" data-on="2">
          <g class="car" style="--d:22s"><rect x="0" y={GROUND + 5} width="22" height="9" rx="3" fill="#e07a5f" /><rect x="5" y={GROUND + 1} width="12" height="6" rx="2" fill="#f2c4b4" /></g>
          <g class="car rev" style="--d:28s"><rect x="0" y={GROUND + 9} width="22" height="9" rx="3" fill="#5b8bd9" /><rect x="5" y={GROUND + 5} width="12" height="6" rx="2" fill="#c9daf5" /></g>
          <g class="car" style="--d:35s;--o:-12s"><rect x="0" y={GROUND + 5} width="26" height="9" rx="3" fill="#f2c14e" /></g>
        </g>
        <g>{lamps.map((l) => <g class="fade" data-on={l.on}><rect x={l.x} y={GROUND - 34} width="2" height="34" fill="#5a4a3c" /><circle cx={l.x + 1} cy={GROUND - 36} r="3" class="lamp" /><circle cx={l.x + 1} cy={GROUND - 36} r="14" fill="url(#lampglow)" class="fade" data-on="3" /></g>)}</g>

        <rect x="-400" y={GROUND + 30} width="2400" height="4" fill="#6b4f3a" />
        {sleepers.map((x) => <rect x={x} y={GROUND + 28} width="9" height="10" rx="1" fill="#8a6a50" opacity=".6" />)}
        <rect x="-400" y={GROUND + 38} width="2400" height="3" fill="#6b4f3a" />

        <g class="route-line fade-out" data-off="0">
          <path d={`M${XS[0]} ${GROUND - 60} H${XS[4]}`} fill="none" stroke="#c8553d" stroke-width="5" stroke-dasharray="2 12" stroke-linecap="round" />
          {XS.map((x, i) => <g><circle cx={x} cy={GROUND - 60} r="14" fill="#fff" stroke="#c8553d" stroke-width="4" /><text x={x} y={GROUND - 54} class="route-num">{i + 1}</text></g>)}
        </g>

        {stops.map((s, i) => (
          <g>
            <rect x={XS[i] - 36} y={GROUND + 24} width="72" height="5" rx="2" fill="#e9dcc3" />
            <rect x={XS[i] - 40} y={GROUND + 50} width="80" height="22" rx="5" class="sign" />
            <text x={XS[i]} y={GROUND + 65} class="sign-text">{short[s.slug][lang]}</text>
          </g>
        ))}

        <g class="train" aria-hidden="true">
          <g class="smoke"><circle cx="30" cy="-48" r="7" /><circle cx="36" cy="-60" r="10" /><circle cx="44" cy="-74" r="13" /></g>
          <rect x="-130" y="-32" width="50" height="26" rx="4" fill="#f3e3c3" stroke="#5a4a3c" stroke-opacity=".4" />
          <rect x="-122" y="-26" width="12" height="9" rx="1" class="cabin-win" /><rect x="-102" y="-26" width="12" height="9" rx="1" class="cabin-win" />
          <rect x="-74" y="-32" width="50" height="26" rx="4" fill="#8fb8b2" stroke="#5a4a3c" stroke-opacity=".4" />
          <rect x="-66" y="-26" width="12" height="9" rx="1" class="cabin-win" /><rect x="-46" y="-26" width="12" height="9" rx="1" class="cabin-win" />
          <rect x="-16" y="-36" width="58" height="30" rx="5" fill="#c8553d" />
          <rect x="-13" y="-52" width="22" height="18" rx="3" fill="#a8432f" />
          <rect x="-9" y="-48" width="13" height="9" rx="1" class="cabin-win" />
          <rect x="24" y="-50" width="9" height="15" fill="#3d3d3d" />
          <circle cx="44" cy="-18" r="4" fill="#ffe08a" />
          {[-118, -92, -62, -36, -4, 26].map((cx) => <circle cx={cx} cy="-4" r="6" fill="#3d3d3d" />)}
        </g>
      </svg>

      <div class="bubbles">
        <div class="bubble intro" data-bubble="-1">
          <p class="label">{t(storyUi.route)}</p>
          <h3>{t(storyUi.title)}</h3>
          <p class="line">{t(storyUi.routeHint)}</p>
        </div>
        {stops.map((s, i) => (
          <div class="bubble" data-bubble={i}>
            <p class="label">{t(s.label)} · {s.exp.period}</p>
            <h3>{t(s.title)}</h3>
            <p class="where">{t(s.exp.company)} — {t(s.exp.role)}</p>
            <p class="line">{t(s.line)}</p>
            {s.skills.length > 0 && (
              <div class="new">
                <span>{t(storyUi.newSkills)}</span>
                <div class="chips">{s.skills.slice(0, 8).map((k) => <span class="chip">{k}</span>)}{s.skills.length > 8 && <span class="chip more">+{s.skills.length - 8}</span>}</div>
              </div>
            )}
          </div>
        ))}
        <div class="bubble epilogue" data-bubble="5">
          <p class="label">{t(storyUi.epilogueTitle)}</p>
          <h3>{t(storyUi.epilogue)}</h3>
        </div>
      </div>

      <nav class="route" aria-label={t(storyUi.route)}>
        <ol>{routeStops.map((name, i) => <li><button type="button" data-jump={i + 1}><i></i><span>{name}</span></button></li>)}</ol>
      </nav>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-city]').forEach((root) => {
    const svg = root.querySelector('svg')!;
    const track = root.querySelector<HTMLElement>('.track')!;
    const train = root.querySelector<SVGGElement>('.train')!;
    const crane = root.querySelector<SVGGElement>('.crane')!;
    const lit = [...svg.querySelectorAll<SVGElement>('[data-on]')];
    const dark = [...svg.querySelectorAll<SVGElement>('[data-off]')];
    const bubbles = [...root.querySelectorAll<HTMLElement>('[data-bubble]')];
    const jumps = [...root.querySelectorAll<HTMLButtonElement>('[data-jump]')];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const XS = [190, 490, 790, 1090, 1400];
    const GROUND = 540;
    const trainX = [-160, ...XS, 1560];
    const craneX = [XS[0] + 60, XS[1] + 40, XS[2] + 90, XS[3] + 110, XS[4] + 110, XS[4] + 110];
    let stage = -2;

    // Keyframes: bird's-eye route map, five stations up close, then the finished city from afar.
    const cams = () => {
      const narrow = innerWidth < innerHeight;
      const close = narrow ? 470 : 820;
      const wide = { cx: narrow ? 860 : 800, w: narrow ? 1150 : 1750 };
      return [wide, ...XS.map((x, i) => ({ cx: x + (i === 4 ? 70 : 20), w: close })), wide];
    };
    const ease = (f: number) => { const g = Math.min(1, Math.max(0, (f - 0.3) / 0.55)); return g * g * (3 - 2 * g); };

    const setStage = (s: number) => {
      if (s === stage) return;
      stage = s;
      lit.forEach((el) => el.classList.toggle('on', Number(el.dataset.on) <= s));
      dark.forEach((el) => el.classList.toggle('gone', Number(el.dataset.off) <= s));
      crane.style.transform = `translate(${craneX[Math.max(0, s)]}px, ${GROUND}px)`;
      crane.classList.toggle('done', s >= 5);
      jumps.forEach((b, i) => { b.classList.toggle('passed', i < s); b.classList.toggle('here', i === s); b.setAttribute('aria-current', String(i === s)); });
      if (s >= 0) dispatchEvent(new CustomEvent('bgm:chapter', { detail: s }));
    };

    const progress = () => {
      const r = track.getBoundingClientRect();
      const span = r.height - innerHeight;
      return { r, span, p: span > 0 ? Math.max(0, Math.min(1, -r.top / span)) : 0 };
    };

    const frame = () => {
      const k = progress().p * 6;
      const i = Math.min(5, Math.floor(k));
      const e = ease(k - i);
      const c = cams();
      const a = c[i], b = c[Math.min(6, i + 1)];
      const cx = a.cx + (b.cx - a.cx) * e;
      const w = a.w + (b.w - a.w) * e;
      const h = w * innerHeight / innerWidth;
      svg.setAttribute('viewBox', `${(cx - w / 2).toFixed(1)} ${(GROUND + 110 - h).toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`);
      const tx = trainX[i] + (trainX[Math.min(6, i + 1)] - trainX[i]) * e;
      train.style.transform = `translate(${tx.toFixed(1)}px, ${GROUND + 30}px)`;
      setStage(Math.min(5, Math.floor(k - 0.35)));
      const near = Math.round(k);
      bubbles.forEach((el) => el.classList.toggle('show', Number(el.dataset.bubble) === near - 1 && Math.abs(k - near) < 0.32));
    };

    jumps.forEach((b) => b.addEventListener('click', () => {
      const { r, span } = progress();
      const top = scrollY + r.top + (Number(b.dataset.jump) / 6) * span;
      scrollTo({ top, behavior: reduce ? 'auto' : 'smooth' });
    }));

    let raf = 0;
    const onScroll = () => { if (!raf) raf = requestAnimationFrame(() => { raf = 0; frame(); }); };
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    frame();
  });
</script>

