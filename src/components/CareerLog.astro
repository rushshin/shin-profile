---
import { profile, type Lang } from '../data/profile';
import { works } from '../data/work';

interface Props { lang: Lang }
const { lang } = Astro.props;
const workBySlug = new Map(works.map((work) => [work.slug, work]));
const shortHash = (slug: string) => {
  let hash = 0;
  for (const char of slug) hash = (Math.imul(hash, 31) + char.charCodeAt(0)) >>> 0;
  return hash.toString(16).padStart(7, '0').slice(-7);
};
---
<div class="career-log reveal">
  <div class="terminal-head"><span class="prompt">$</span> git log --graph --oneline</div>
  <div class="commits">
    {profile.experience.map((job) => (
      <a class="commit" href={`${lang === 'zh' ? '' : '/en'}/work/${job.slug}/`}>
        <span class:list={['graph', { current: job.current }]} aria-hidden="true"><span class="node"></span></span>
        <span class="commit-body">
          <span class="commit-main">
            <span class="hash">{shortHash(job.slug)}</span>
            {job.current && <span class="ref">(HEAD -&gt; main)</span>}
            <span class="subject"><span class="company">{job.company[lang]}</span> — {job.role[lang]}</span>
            <span class="period">{job.period}</span>
          </span>
          <span class="sections">{workBySlug.get(job.slug)?.sections.map((section) => section.title[lang]).join(' · ')}</span>
        </span>
      </a>
    ))}
  </div>
</div>

<style>
  .career-log { margin-top: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); overflow: hidden; min-width: 0; }
  .terminal-head { padding: 11px 18px; border-bottom: 1px solid var(--line); font: 12px var(--mono); color: var(--muted); }
  .prompt, .ref { color: var(--accent); }
  .company { color: var(--accent); font-weight: 700; font-size: 13px; }
  .commits { padding: 8px 0; }
  .commit { display: grid; grid-template-columns: 32px minmax(0, 1fr); padding: 0 18px; text-decoration: none; min-width: 0; }
  .commit:hover, .commit:focus-visible { background: var(--accent-soft); }
  .graph { position: relative; display: flex; align-items: flex-start; justify-content: center; padding-top: 19px; }
  .graph::before { content: ''; position: absolute; width: 2px; top: 0; bottom: 0; background: var(--accent); opacity: .65; }
  .node { position: relative; z-index: 1; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); }
  .graph.current .node { width: 12px; height: 12px; margin-top: -2px; box-shadow: 0 0 0 5px var(--accent-soft), 0 0 12px var(--accent); }
  .commit-body { display: block; min-width: 0; padding: 11px 0; font: 12px/1.6 var(--mono); }
  .commit-main { display: flex; align-items: baseline; flex-wrap: wrap; gap: 3px 10px; overflow-wrap: anywhere; }
  .hash { color: var(--muted); }
  .period, .sections { color: var(--muted); }
  .subject { color: var(--text); min-width: 0; overflow-wrap: anywhere; }
  .sections { display: block; margin-top: 3px; font-size: 11px; overflow-wrap: anywhere; }
  @media (max-width: 720px) {
    .commit { padding: 0 12px; grid-template-columns: 24px minmax(0, 1fr); }
    .commit-main { gap: 2px 8px; }
    .subject { flex-basis: 100%; }
  }
</style>
