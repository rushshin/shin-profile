---
const labels = { zh: '背景音樂', en: 'Background music' };
---

<button class="bgm-toggle waiting" type="button" data-bgm aria-pressed="true" aria-label={labels.zh} title={labels.zh}>
  <svg class="note" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18V5l11-2v13"/><ellipse cx="6" cy="18" rx="3" ry="2"/><ellipse cx="17" cy="16" rx="3" ry="2"/></svg>
  <span class="equalizer" aria-hidden="true"><i></i><i></i><i></i></span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-bgm]');
  if (button) {
    const labels = { zh: '背景音樂', en: 'Background music' };
    const label = document.documentElement.lang.startsWith('zh') ? labels.zh : labels.en;
    button.setAttribute('aria-label', label);
    button.title = label;

    type Chord = [number, 'major' | 'minor' | 'lydian'];
    const loops: Chord[][] = [
      [[48, 'major'], [55, 'major'], [57, 'minor'], [53, 'major']],
      [[50, 'major'], [57, 'major'], [59, 'minor'], [55, 'major']],
      [[53, 'major'], [60, 'major'], [62, 'minor'], [58, 'lydian']],
      [[55, 'major'], [50, 'major'], [52, 'minor'], [48, 'major']],
      [[57, 'major'], [52, 'major'], [54, 'minor'], [50, 'major']],
      [[48, 'major'], [53, 'major'], [55, 'major'], [48, 'major']],
    ];
    // Measured -44 dBFS RMS at 0.1; 1.0 lands near -24 dBFS, a soft background level.
    const TARGET = 1.0;
    const beat = 60 / 104;
    const sixteenth = beat / 4;
    // Only these events grant audio activation across Chrome, Safari and Firefox.
    const gestures = ['pointerup', 'pointerdown', 'mousedown', 'touchend', 'keydown', 'click'] as const;
    let context: AudioContext | undefined;
    let master: GainNode | undefined;
    let padBus: GainNode | undefined;
    let melodyBus: GainNode | undefined;
    let bassBus: GainNode | undefined;
    let percussionBus: GainNode | undefined;
    let noise: AudioBuffer | undefined;
    let timer: number | undefined;
    let desiredOn = true;
    let playing = false;
    let buttonGesturePending = false;
    let chapter = 0;
    let pendingChapter: number | undefined;
    let bar = 0;
    let step = 0;
    let nextStepTime = 0;
    let generation = 0;
    const midiHz = (midi: number) => 440 * 2 ** ((midi - 69) / 12);

    try { desiredOn = localStorage.getItem('bgm') !== 'off'; } catch {}
    button.setAttribute('aria-pressed', String(desiredOn));
    button.classList.toggle('waiting', desiredOn);

    const setup = () => {
      const audio = new AudioContext();
      const main = audio.createGain();
      main.gain.value = 0;
      const compressor = audio.createDynamicsCompressor();
      compressor.threshold.value = -18;
      compressor.ratio.value = 3;
      const pad = audio.createGain();
      const padFilter = audio.createBiquadFilter();
      padFilter.type = 'lowpass';
      padFilter.frequency.value = 1800;
      const melody = audio.createGain();
      const bass = audio.createGain();
      const percussion = audio.createGain();
      const delay = audio.createDelay(0.5);
      delay.delayTime.value = beat * 0.75;
      const feedback = audio.createGain();
      feedback.gain.value = 0.25;
      const wet = audio.createGain();
      wet.gain.value = 0.18;
      const hatFilter = audio.createBiquadFilter();
      hatFilter.type = 'highpass';
      hatFilter.frequency.value = 6500;
      const noiseBuffer = audio.createBuffer(1, Math.ceil(audio.sampleRate * 0.09), audio.sampleRate);
      const samples = noiseBuffer.getChannelData(0);
      for (let i = 0; i < samples.length; i++) samples[i] = Math.random() * 2 - 1;
      pad.connect(padFilter);
      padFilter.connect(main);
      melody.connect(main);
      melody.connect(delay);
      delay.connect(feedback);
      feedback.connect(delay);
      delay.connect(wet);
      wet.connect(main);
      bass.connect(main);
      hatFilter.connect(percussion);
      percussion.connect(main);
      main.connect(compressor);
      compressor.connect(audio.destination);
      audio.onstatechange = () => begin();
      context = audio;
      master = main;
      padBus = pad;
      melodyBus = melody;
      bassBus = bass;
      percussionBus = percussion;
      noise = noiseBuffer;
      hatOutput = hatFilter;
    };

    let hatOutput: BiquadFilterNode | undefined;

    const playPad = (chord: Chord, when: number) => {
      if (!context || !padBus) return;
      const [root, quality] = chord;
      const notes = [root, root + (quality === 'minor' ? 3 : 4), root + 7];
      const envelope = context.createGain();
      envelope.gain.setValueAtTime(0.0001, when);
      envelope.gain.linearRampToValueAtTime(0.045, when + 0.25);
      envelope.gain.setValueAtTime(0.045, when + beat * 2.5);
      envelope.gain.linearRampToValueAtTime(0.0001, when + beat * 4);
      envelope.connect(padBus);
      let ended = 0;
      notes.forEach((note) => {
        const oscillator = context!.createOscillator();
        oscillator.type = 'sine';
        oscillator.frequency.value = midiHz(note);
        oscillator.connect(envelope);
        oscillator.start(when);
        oscillator.stop(when + beat * 4 + 0.01);
        oscillator.onended = () => {
          oscillator.disconnect();
          if (++ended === notes.length) envelope.disconnect();
        };
      });
    };

    const playBass = (root: number, when: number, ghost = false) => {
      if (!context || !bassBus) return;
      const oscillator = context.createOscillator();
      const envelope = context.createGain();
      oscillator.type = 'triangle';
      oscillator.frequency.value = midiHz(root - 12);
      envelope.gain.setValueAtTime(0.0001, when);
      envelope.gain.linearRampToValueAtTime(ghost ? 0.12 : chapter === 3 ? 0.3 : 0.24, when + 0.015);
      envelope.gain.exponentialRampToValueAtTime(0.0001, when + (ghost ? 0.16 : 0.3));
      oscillator.connect(envelope);
      envelope.connect(bassBus);
      oscillator.start(when);
      oscillator.stop(when + (ghost ? 0.17 : 0.31));
      oscillator.onended = () => { oscillator.disconnect(); envelope.disconnect(); };
    };

    const playKick = (when: number) => {
      if (!context || !percussionBus) return;
      const oscillator = context.createOscillator();
      const envelope = context.createGain();
      oscillator.type = 'sine';
      oscillator.frequency.setValueAtTime(120, when);
      oscillator.frequency.exponentialRampToValueAtTime(50, when + 0.15);
      envelope.gain.setValueAtTime(0.0001, when);
      envelope.gain.linearRampToValueAtTime(0.18, when + 0.012);
      envelope.gain.exponentialRampToValueAtTime(0.0001, when + 0.15);
      oscillator.connect(envelope);
      envelope.connect(percussionBus);
      oscillator.start(when);
      oscillator.stop(when + 0.16);
      oscillator.onended = () => { oscillator.disconnect(); envelope.disconnect(); };
    };

    const playHat = (when: number, strong: boolean) => {
      if (!context || !noise || !hatOutput) return;
      const source = context.createBufferSource();
      const envelope = context.createGain();
      source.buffer = noise;
      envelope.gain.setValueAtTime(0.0001, when);
      envelope.gain.linearRampToValueAtTime(strong ? 0.035 : 0.02, when + 0.008);
      envelope.gain.exponentialRampToValueAtTime(0.0001, when + 0.065);
      source.connect(envelope);
      envelope.connect(hatOutput);
      source.start(when);
      source.stop(when + 0.07);
      source.onended = () => { source.disconnect(); envelope.disconnect(); };
    };

    const playMelody = (chord: Chord, when: number, position: number) => {
      if (!context || !melodyBus) return;
      const [root, quality] = chord;
      const scale = quality === 'minor' ? [0, 2, 3, 7, 9] : quality === 'lydian' ? [0, 2, 4, 6, 9] : [0, 2, 4, 7, 9];
      const phrase = [0, 4, 3, 2, 1, 0, 2, 4, 3, 2];
      const variation = bar % 4 === 2 && position === 3 ? 1 : 0;
      const note = root + 12 + scale[Math.min(4, phrase[position] + variation)] + (chapter === 5 && bar % 4 === 3 ? 12 : 0);
      const pan = context.createStereoPanner();
      pan.pan.value = position % 2 ? 0.18 : -0.18;
      const envelope = context.createGain();
      envelope.gain.setValueAtTime(0.0001, when);
      envelope.gain.linearRampToValueAtTime(0.17, when + 0.008);
      envelope.gain.exponentialRampToValueAtTime(0.0001, when + 0.52);
      envelope.connect(pan);
      pan.connect(melodyBus);
      let ended = 0;
      [1, 3].forEach((partial) => {
        const oscillator = context!.createOscillator();
        const partialGain = context!.createGain();
        oscillator.type = 'sine';
        oscillator.frequency.value = midiHz(note) * partial;
        partialGain.gain.value = partial === 1 ? 1 : 0.16;
        oscillator.connect(partialGain);
        partialGain.connect(envelope);
        oscillator.start(when);
        oscillator.stop(when + 0.53);
        oscillator.onended = () => {
          oscillator.disconnect();
          partialGain.disconnect();
          if (++ended === 2) { envelope.disconnect(); pan.disconnect(); }
        };
      });
    };

    const schedule = () => {
      if (!playing || !context || document.hidden) return;
      const horizon = context.currentTime + 0.12;
      while (nextStepTime < horizon) {
        if (step === 0 && pendingChapter !== undefined) {
          chapter = pendingChapter;
          pendingChapter = undefined;
          bar = 0;
        }
        const chord = loops[chapter][bar % 4];
        if (step === 0) playPad(chord, nextStepTime);
        if (step === 0 || step === 8 || step === 14) playBass(chord[0], nextStepTime, step === 14);
        if (step === 0 || step === 8) playKick(nextStepTime);
        if (step % 2 === 0) playHat(nextStepTime, step % 4 === 0);
        const motifStep = (bar % 2) * 16 + step;
        const motifPositions = [2, 5, 8, 11, 14, 18, 21, 24, 27, 30];
        const position = motifPositions.indexOf(motifStep);
        if (position >= 0 && !(bar % 4 === 3 && position === 6)) playMelody(chord, nextStepTime, position);
        nextStepTime += sixteenth;
        step = (step + 1) % 16;
        if (step === 0) bar++;
      }
      timer = window.setTimeout(schedule, 25);
    };

    const removeGestures = () => gestures.forEach((gesture) => window.removeEventListener(gesture, onGesture, true));
    const addGestures = () => gestures.forEach((gesture) => window.addEventListener(gesture, onGesture, { capture: true, passive: true }));

    const begin = () => {
      if (playing || !desiredOn || !context || context.state !== 'running') return;
      playing = true;
      removeGestures();
      button.classList.remove('waiting');
      const gain = master!.gain;
      gain.cancelScheduledValues(context.currentTime);
      gain.setValueAtTime(gain.value, context.currentTime);
      gain.linearRampToValueAtTime(TARGET, context.currentTime + 1.5);
      bar = 0;
      step = 0;
      nextStepTime = context.currentTime + 0.05;
      window.clearTimeout(timer);
      schedule();
    };

    // Must run synchronously inside the gesture handler, or browsers keep the context suspended.
    const start = () => {
      if (!desiredOn || playing || document.hidden) return;
      try {
        const session = (navigator as Navigator & { audioSession?: { type: string } }).audioSession;
        if (session) session.type = 'playback';
      } catch {}
      if (!context) setup();
      const audio = context!;
      const unlock = audio.createBufferSource();
      unlock.buffer = audio.createBuffer(1, 1, audio.sampleRate);
      unlock.connect(audio.destination);
      unlock.start();
      void audio.resume().then(begin, () => {});
      begin();
    };

    function onGesture(event: Event) {
      if (event.type === 'click' && button.contains(event.target as Node)) return;
      if (button.contains(event.target as Node)) buttonGesturePending = true;
      start();
    }

    const stop = () => {
      desiredOn = false;
      playing = false;
      ++generation;
      removeGestures();
      button.setAttribute('aria-pressed', 'false');
      button.classList.remove('waiting');
      window.clearTimeout(timer);
      if (context && master) {
        const ticket = generation;
        const gain = master.gain;
        gain.cancelScheduledValues(context.currentTime);
        gain.setValueAtTime(gain.value, context.currentTime);
        gain.linearRampToValueAtTime(0, context.currentTime + 1);
        window.setTimeout(() => { if (ticket === generation) void context?.suspend(); }, 1050);
      }
      try { localStorage.setItem('bgm', 'off'); } catch {}
    };

    button.addEventListener('click', () => {
      if (buttonGesturePending) {
        buttonGesturePending = false;
        return;
      }
      if (playing) {
        stop();
      } else if (desiredOn) {
        start();
      } else {
        desiredOn = true;
        button.setAttribute('aria-pressed', 'true');
        button.classList.add('waiting');
        try { localStorage.setItem('bgm', 'on'); } catch {}
        start();
      }
    });
    if (desiredOn) addGestures();

    window.addEventListener('bgm:chapter', (event) => {
      const next = (event as CustomEvent<number>).detail;
      if (!Number.isInteger(next) || next < 0 || next > 5) return;
      if (playing) pendingChapter = next;
      else { chapter = next; pendingChapter = undefined; }
    });
    document.addEventListener('visibilitychange', () => {
      if (!context || !playing) return;
      if (document.hidden) {
        window.clearTimeout(timer);
        void context.suspend();
      } else {
        void context.resume().then(() => {
          if (!playing || !context) return;
          step = 0;
          nextStepTime = context.currentTime + 0.02;
          schedule();
        });
      }
    });
  }
</script>

<style>
  .bgm-toggle { position: fixed; right: 20px; bottom: 20px; z-index: 70; display: grid; width: 44px; height: 44px; place-items: center; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: var(--surface); color: var(--accent); box-shadow: 0 4px 16px #0002; cursor: pointer; }
  .bgm-toggle:hover, .bgm-toggle:focus-visible { border-color: var(--accent); }
  .bgm-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .equalizer { display: none; align-items: center; gap: 3px; height: 18px; }
  .equalizer i { display: block; width: 3px; height: 9px; border-radius: 2px; background: currentColor; animation: bounce 850ms ease-in-out infinite alternate; }
  .equalizer i:nth-child(2) { height: 16px; animation-delay: 160ms; }
  .equalizer i:nth-child(3) { height: 12px; animation-delay: 320ms; }
  .bgm-toggle[aria-pressed="true"] .note { display: none; }
  .bgm-toggle[aria-pressed="true"] .equalizer { display: flex; }
  .bgm-toggle.waiting::after { position: absolute; inset: -5px; border: 1px solid var(--accent); border-radius: 50%; content: ''; animation: pulse 2.4s ease-out infinite; pointer-events: none; }
  @keyframes bounce { to { transform: scaleY(.4); } }
  @keyframes pulse { to { transform: scale(1.25); opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .equalizer i, .bgm-toggle.waiting::after { animation: none; } .bgm-toggle.waiting::after { display: none; } }
</style>
