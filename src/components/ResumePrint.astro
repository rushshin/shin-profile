---
import { profile, type Lang } from '../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const site = 'shin-profile.shin-lin.workers.dev';
const email = profile.links.find((l) => l.href.startsWith('mailto:'))?.href.slice(7);
const L = {
  summary: { zh: '簡介', en: 'Summary' },
  highlights: { zh: '重點', en: 'Highlights' },
  experience: { zh: '工作經歷', en: 'Experience' },
  skills: { zh: '技能', en: 'Skills' },
  education: { zh: '學歷', en: 'Education' },
};
---
<article class="sheet">
  <header>
    <div>
      <h1>{t(profile.name)}</h1>
      <p class="title">{t(profile.title)}</p>
    </div>
    <ul class="contact">
      <li>{t(profile.location)} · {t(profile.workMode)}</li>
      {email && <li><a href={`mailto:${email}`}>{email}</a></li>}
      {profile.links.filter((l) => !l.href.startsWith('mailto:')).map((l) => <li><a href={l.href}>{l.href.replace(/^https:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></li>)}
      <li><a href={`https://${site}${lang === 'zh' ? '/' : '/en/'}`}>{site}</a></li>
    </ul>
  </header>

  <section>
    <h2>{t(L.summary)}</h2>
    <p>{t(profile.intro)}</p>
  </section>

  <section>
    <h2>{t(L.highlights)}</h2>
    <ul class="hl">
      {profile.highlights.map((h) => <li><b>{t(h.title)}</b>{t(h.text)}</li>)}
    </ul>
  </section>

  <section>
    <h2>{t(L.experience)}</h2>
    {profile.experience.map((e) => (
      <div class="job">
        <div class="row">
          <h3>{t(e.company)} <span>· {t(e.role)}</span></h3>
          <span class="period">{e.period}</span>
        </div>
        {e.team && <p class="team">{t(e.team)}</p>}
        <ul>{e.points[lang].map((p) => <li>{p}</li>)}</ul>
        <p class="stack">{e.tags.join(' · ')}</p>
      </div>
    ))}
  </section>

  <section>
    <h2>{t(L.skills)}</h2>
    <dl class="skills">
      {profile.skills.map((g) => (<><dt>{t(g.group)}</dt><dd>{g.items.join(', ')}</dd></>))}
    </dl>
  </section>

  <section>
    <h2>{t(L.education)}</h2>
    {profile.education.map((ed) => (
      <div class="row edu"><span><b>{t(ed.school)}</b> · {t(ed.degree)}</span><span class="period">{ed.period}</span></div>
    ))}
  </section>
</article>

<style is:global>
  @page { size: A4; margin: 12mm 13mm; }
  body:has(.sheet) .progress, body:has(.sheet) .spotlight { display: none; }
  body:has(.sheet) { background: #e7e5e4; }
  @media print { body:has(.sheet) { background: #fff; } }
</style>

<style>
  .sheet { --ink: #1c1917; --mute: #57534e; --rule: #d6d3d1; --acc: #1d4ed8;
    max-width: 210mm; margin: 24px auto; padding: 14mm 15mm; background: #fff; color: var(--ink);
    font: 10pt/1.5 var(--font); box-shadow: 0 10px 40px -20px rgba(0,0,0,.35); color-scheme: light; }
  @media print { .sheet { margin: 0; padding: 0; box-shadow: none; max-width: none; } }
  a { color: var(--ink); text-decoration: none; }
  header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-end; padding-bottom: 10px; border-bottom: 2px solid var(--acc); }
  h1 { margin: 0; font-size: 24pt; line-height: 1.1; letter-spacing: -0.01em; }
  .title { margin: 4px 0 0; color: var(--acc); font-weight: 600; font-size: 11.5pt; }
  .contact { list-style: none; margin: 0; padding: 0; text-align: right; font-size: 8.5pt; color: var(--mute); }
  .contact a { color: var(--mute); }
  section { margin-top: 12px; }
  h2 { margin: 0 0 6px; font-size: 9pt; letter-spacing: .12em; text-transform: uppercase; color: var(--acc); border-bottom: 1px solid var(--rule); padding-bottom: 2px; }
  p { margin: 0; }
  .hl { margin: 0; padding-left: 16px; }
  .hl li { margin: 2px 0; }
  .hl b { margin-right: 6px; }
  .job { margin-bottom: 9px; break-inside: avoid; }
  .row { display: flex; justify-content: space-between; gap: 12px; align-items: baseline; }
  h3 { margin: 0; font-size: 10.5pt; }
  h3 span { font-weight: 500; color: var(--mute); }
  .period { font: 8.5pt var(--mono); color: var(--mute); white-space: nowrap; }
  .team { font-size: 8.5pt; color: var(--acc); }
  .job ul { margin: 3px 0 0; padding-left: 16px; }
  .job li { margin: 1px 0; }
  .stack { margin-top: 2px; font: 8pt var(--mono); color: var(--mute); }
  .skills { display: grid; grid-template-columns: max-content 1fr; gap: 2px 14px; margin: 0; font-size: 9pt; }
  .skills dt { font-weight: 600; }
  .skills dd { margin: 0; color: var(--mute); }
  .edu { font-size: 9.5pt; margin: 2px 0; }
  @media (max-width: 720px) {
    .sheet { margin: 0; padding: 20px 16px; }
    header { flex-direction: column; align-items: flex-start; }
    .contact { text-align: left; }
    .row { flex-direction: column; gap: 0; }
  }
</style>
