---
import type { Lang } from '../../data/profile';

interface Props {
  lang: Lang;
  mode?: 'dark' | 'legacy' | 'architected';
}

const { lang, mode = 'dark' } = Astro.props;
const zh = lang === 'zh';
const legacy = [
  { code: 'L3', name: zh ? '影子 AI / 散落腳本' : 'Shadow AI / Ad-hoc Scripts' },
  { code: 'L2', name: zh ? '人工維運 K8s / 漂移' : 'Manual K8s / Config Drift' },
  { code: 'L1', name: zh ? '單點 VM / 手動掛載' : 'Siloed VMs / Manual Storage' },
  { code: 'L0', name: zh ? '裸機等待人工上架' : 'Bare Metal · Manual Rack' },
];
const modern = [
  { code: 'L3', name: zh ? 'AI 工作流與團隊賦能' : 'AI Workflows & Team' },
  { code: 'L2', name: 'K8s HA · GitOps · PKI' },
  { code: 'L1', name: 'KubeVirt · Rook-Ceph' },
  { code: 'L0', name: zh ? '裸機 / DGX · Redfish PXE' : 'Bare Metal / DGX · PXE' },
];
const labels = mode === 'legacy' ? legacy : modern;
const drift = [-16, 12, -10, 14];
const aria =
  mode === 'legacy'
    ? zh ? '人工維運：平面錯位、工單排隊、設定漂移' : 'Manual operations: misaligned layers, ticket queue, config drift'
    : mode === 'architected'
      ? zh ? '架構後：各層對齊、GitOps 持續收斂、OTel 追蹤正常' : 'Architected: aligned layers, GitOps reconcile loop, OTel traces healthy'
      : zh ? '機房尚未啟動：四層平台全部離線' : 'Room not yet live: all four platform layers offline';
---

<svg class:list={['iso-stack', `mode-${mode}`]} viewBox="0 0 460 360" role="img" aria-label={aria}>
  <line x1="66" y1="48" x2="66" y2="306" class="dim-rail" />
  <line x1="394" y1="48" x2="394" y2="306" class="dim-rail" />
  <line x1="230" y1="26" x2="230" y2="334" class="center-beam" />

  {labels.map((layer, idx) => {
    const y = 62 + idx * 66;
    const dx = mode === 'legacy' ? drift[idx] : 0;
    const human = idx === 0 && mode === 'architected';
    return (
      <g class:list={['iso-layer', `layer-${idx}`]} style={`--idx:${idx};--dx:${dx}px`} transform={`translate(${dx} 0)`}>
        <polygon points={`230,${y - 34} 364,${y} 230,${y + 34} 96,${y}`} class:list={['plane', { human }]} />
        <circle cx="96" cy={y} r="2.5" class:list={['anchor', { human }]} />
        <text x={16 - dx} y={y + 4} class="layer-code">{layer.code}</text>
        <line x1="96" y1={y} x2={54 - dx} y2={y} class="leader" />
        <text x="230" y={y + 4} text-anchor="middle" class="layer-name">{layer.name}</text>
        {mode === 'architected' && (
          <g>
            <circle cx="182" cy={y} r="3" class:list={['node-dot', { human }]} />
            <circle cx="278" cy={y} r="3" class:list={['node-dot', { human }]} />
            <path d={`M 340 ${y - 4} l 4 5 l 8 -9`} class="check" />
          </g>
        )}
        {mode === 'legacy' && (
          <g class="warn-mark">
            <path d={`M 340 ${y + 6} l 8 -14 l 8 14 z`} />
            <text x="348" y={y + 3} text-anchor="middle">!</text>
          </g>
        )}
        {mode === 'dark' && <circle cx="278" cy={y} r="3" class="node-off" />}
      </g>
    );
  })}

  {mode === 'legacy' && (
    <g class="ticket-queue">
      {[0, 1, 2].map((i) => (
        <g class="ticket" style={`--i:${i}`} transform={`translate(${376 + i * 4} ${84 + i * 46})`}>
          <rect width="62" height="30" rx="4" />
          <text x="8" y="13">{zh ? '工單' : 'TICKET'}</text>
          <text x="8" y="24" class="ticket-sub">{zh ? '待人工' : 'manual'}</text>
        </g>
      ))}
      <text x="376" y="68" class="queue-label">{zh ? '排隊 ×3' : 'QUEUE ×3'}</text>
      <text x="230" y="344" text-anchor="middle" class="drift-label">{zh ? '期望 ≠ 實際 · 漂移中' : 'desired ≠ actual · drifting'}</text>
    </g>
  )}

  {mode === 'architected' && (
    <g>
      <line x1="230" y1="296" x2="230" y2="56" class="signal-up" />
      <g class="reconcile" transform="translate(412 322)">
        <circle r="16" class="rc-ring" />
        <text y="3" text-anchor="middle" class="rc-txt">git</text>
      </g>
      <text x="230" y="344" text-anchor="middle" class="ok-label">{zh ? '期望 = 實際 · GitOps 持續收斂 · OTel 追蹤中' : 'desired = actual · GitOps reconciling · OTel tracing'}</text>
    </g>
  )}

  {mode === 'dark' && (
    <g>
      <text x="230" y="344" text-anchor="middle" class="off-label">{zh ? '全部離線 · 等待有人把燈打開' : 'ALL OFFLINE · waiting for someone to switch it on'}<tspan class="cursor-blink"> _</tspan></text>
    </g>
  )}
</svg>

<style>
  .iso-stack { width: 100%; height: auto; display: block; overflow: visible; }
  .dim-rail { stroke: var(--grid); stroke-width: 1; stroke-dasharray: 3 4; }
  .center-beam { stroke: color-mix(in srgb, var(--signal) 28%, transparent); stroke-width: 1.2; stroke-dasharray: 4 5; }
  .mode-legacy .center-beam,
  .mode-dark .center-beam { stroke: color-mix(in srgb, var(--mute) 25%, transparent); }
  .plane {
    fill: rgba(62, 230, 255, 0.09);
    stroke: color-mix(in srgb, var(--signal) 60%, transparent);
    stroke-width: 1.2;
  }
  .plane.human { fill: rgba(255, 181, 71, 0.1); stroke: color-mix(in srgb, var(--human) 75%, transparent); }
  .mode-legacy .plane {
    fill: rgba(125, 139, 153, 0.08);
    stroke: color-mix(in srgb, var(--mute) 55%, transparent);
    stroke-dasharray: 4 4;
  }
  .mode-dark .plane {
    fill: rgba(125, 139, 153, 0.03);
    stroke: color-mix(in srgb, var(--mute) 28%, transparent);
    stroke-dasharray: 2 5;
  }
  .leader { stroke: var(--grid); stroke-width: 1; }
  .anchor { fill: var(--signal); }
  .anchor.human { fill: var(--human); }
  .mode-legacy .anchor,
  .mode-dark .anchor { fill: var(--mute); }
  .layer-code { font-family: var(--mono); font-size: 11px; font-weight: 700; fill: var(--mute); }
  .layer-name {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--ink);
    paint-order: stroke;
    stroke: #0b1018;
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .mode-legacy .layer-name { fill: #c9a37a; }
  .mode-dark .layer-name { fill: #566372; }
  .node-dot { fill: var(--ok); }
  .node-dot.human { fill: var(--human); }
  .node-off { fill: #2a3541; }
  .check { fill: none; stroke: var(--ok); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  .warn-mark path { fill: rgba(255, 123, 114, 0.14); stroke: var(--warn, #ff7b72); stroke-width: 1.4; stroke-linejoin: round; }
  .warn-mark text { font-family: var(--mono); font-size: 9px; font-weight: 700; fill: var(--warn, #ff7b72); }
  .mode-legacy .iso-layer { animation: drift 3.6s ease-in-out infinite alternate; animation-delay: calc(var(--idx) * -0.9s); }
  @keyframes drift { from { transform: translateX(var(--dx)); } to { transform: translateX(calc(var(--dx) + 7px)); } }
  .ticket rect { fill: rgba(255, 181, 71, 0.08); stroke: color-mix(in srgb, var(--human) 70%, transparent); stroke-dasharray: 3 3; }
  .ticket text { font-family: var(--mono); font-size: 8.5px; fill: var(--human); }
  .ticket .ticket-sub { fill: var(--mute); font-size: 7.5px; }
  .queue-label, .drift-label { font-family: var(--mono); font-size: 9.5px; fill: var(--warn, #ff7b72); letter-spacing: 0.06em; }
  .ok-label { font-family: var(--mono); font-size: 9.5px; fill: var(--ok); letter-spacing: 0.04em; }
  .off-label { font-family: var(--mono); font-size: 9.5px; fill: #566372; letter-spacing: 0.04em; }
  .cursor-blink { animation: blink 1.1s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .signal-up {
    stroke: var(--signal);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 22 218;
    animation: rise 2.8s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes rise { from { stroke-dashoffset: 0; } to { stroke-dashoffset: 240; } }
  .rc-ring { fill: rgba(92, 242, 154, 0.08); stroke: var(--ok); stroke-width: 1.4; stroke-dasharray: 8 5; transform-origin: center; animation: spin 7s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .rc-txt { font-family: var(--mono); font-size: 8px; fill: var(--ok); }

  .mode-dark .iso-layer { animation: bootIn 0.85s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc((3 - var(--idx)) * 120ms); }
  @keyframes bootIn { from { opacity: 0; } to { opacity: 1; } }

  @media (prefers-reduced-motion: reduce) {
    .signal-up, .rc-ring, .cursor-blink, .mode-legacy .iso-layer, .mode-dark .iso-layer { animation: none; }
  }
</style>
