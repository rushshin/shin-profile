---
import type { Lang } from '../../data/profile';
import { stops, journeyUi } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const xs = [110, 305, 500, 695, 890];
const ys = [262, 208, 208, 148, 88];
const pts = stops.map((s, i) => ({ s, x: xs[i], y: ys[i] }));
const path = pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${p.x} ${p.y}`).join(' ');
const last = stops.length - 1;
---

<section id="act-2" class="act act-stops" aria-labelledby="act2-title" data-ready="25">
  <span class="kicker">{t(journeyUi.act2.kicker)}</span>
  <h2 id="act2-title">{t(journeyUi.act2.headline)}</h2>
  <p class="subline">{t(journeyUi.act2.subline)}</p>

  <ol class="ladder" aria-label={lang === 'zh' ? '責任範圍升級' : 'Scope escalation'}>
    {journeyUi.act2.ladder.map((r) => (
      <li data-rung={r.id}>{t(r.label)}</li>
    ))}
  </ol>

  <div class="stage panel">
    <div class="stage-scroll">
      <svg id="stops-svg" class="stops-svg" viewBox="0 0 1000 340" role="group" aria-label={t(journeyUi.act2.groupLabel)}>
        <path d={path} class="stair-track" />
        <path d={path} class="stair-pulse" />
        {pts.map(({ s, x, y }, i) => (
          <g
            class="stop-node"
            data-stop={s.slug}
            data-scope={s.scope}
            data-index={i}
            tabindex={i === last ? 0 : -1}
            role="button"
            aria-pressed={i === last}
            aria-controls="stop-story"
            aria-label={`${s.code} · ${t(s.scene)} · ${t(s.scopeLabel)}`}
          >
            <rect x={x - 70} y={y - 72} width="140" height={324 - y + 72} fill="transparent" />
            <line x1={x} y1={y + 34} x2={x} y2="320" class="stop-leg" />
            <circle cx={x} cy={y} r="46" class="stop-glow" />
            <circle cx={x} cy={y} r="30" class="stop-core" />
            <text x={x} y={y + 5} text-anchor="middle" class="stop-num">{String(i + 1).padStart(2, '0')}</text>
            <text x={x} y={y - 52} text-anchor="middle" class="stop-scene">{t(s.scene)}</text>
          </g>
        ))}
      </svg>
    </div>

    <div id="stop-story" class="stop-story" aria-live="polite">
      {stops.map((s, i) => (
        <article class="story-card" data-story={s.slug} hidden={i !== last}>
          <span class:list={['scope-chip', s.scope]}>{t(s.scopeLabel)}</span>
          <h3>{t(s.scene)}</h3>
          <p>{t(s.story)}</p>
          <button type="button" class="toggle-btn" data-dossier-open={`dossier-stop-${s.slug}`} aria-haspopup="dialog" aria-controls="dossier">
            {t(journeyUi.dossier.openStop)}
          </button>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const svg = document.getElementById('stops-svg');
  const nodes = [...document.querySelectorAll<SVGGElement>('[data-stop]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-story]')];
  const rungs = [...document.querySelectorAll<HTMLElement>('[data-rung]')];

  const select = (node: SVGGElement, focus: boolean) => {
    nodes.forEach((n) => {
      const on = n === node;
      n.classList.toggle('active', on);
      n.setAttribute('aria-pressed', String(on));
      n.tabIndex = on ? 0 : -1;
    });
    cards.forEach((c) => (c.hidden = c.dataset.story !== node.dataset.stop));
    rungs.forEach((r) => r.classList.toggle('on', r.dataset.rung === node.dataset.scope));
    window.dispatchEvent(new CustomEvent('shin:stop-select', { detail: { index: Number(node.dataset.index) } }));
    if (focus) node.focus();
  };

  nodes.forEach((node, i) => {
    node.addEventListener('click', () => select(node, false));
    node.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select(node, false);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const step = e.key === 'ArrowRight' ? 1 : -1;
        select(nodes[(i + step + nodes.length) % nodes.length], true);
      }
    });
  });
  if (svg && nodes.length) select(nodes[nodes.length - 1], false);
</script>

<style>
  .act-stops { padding: clamp(36px, 6vh, 68px) 0; }
  .ladder {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .ladder li {
    padding: 5px 10px;
    border: 1px solid var(--grid);
    border-radius: 999px;
    color: var(--mute);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .ladder li:not(:last-child)::after { content: ' →'; color: var(--grid); }
  .ladder li.on { color: var(--human); border-color: var(--human); background: rgba(255, 181, 71, 0.1); }
  .stage-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .stops-svg { width: 100%; height: auto; display: block; }
  @media (max-width: 720px) { .stops-svg { min-width: 680px; } }
  .stair-track { fill: none; stroke: var(--grid); stroke-width: 2; }
  .stair-pulse {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 44 900;
    animation: flow 4.2s linear infinite;
  }
  @keyframes flow { from { stroke-dashoffset: 944; } to { stroke-dashoffset: 0; } }
  .stop-node { cursor: pointer; outline: none; }
  .journey-shell .stop-node:focus-visible { outline: none; }
  .stop-node:focus-visible .stop-core { stroke: var(--human); stroke-width: 3; }
  .stop-node:focus-visible .stop-glow { stroke: var(--human); stroke-dasharray: none; }
  .stop-leg { stroke: var(--grid); stroke-width: 1; stroke-dasharray: 3 4; }
  .stop-glow { fill: rgba(255, 181, 71, 0.03); stroke: var(--grid); stroke-dasharray: 3 4; transition: fill 0.3s ease, stroke 0.3s ease; }
  .stop-core { fill: #0d131c; stroke: color-mix(in srgb, var(--signal) 55%, var(--grid)); stroke-width: 1.5; transition: fill 0.3s ease, stroke 0.3s ease; }
  .stop-node:hover .stop-core,
  .stop-node.active .stop-core { stroke: var(--human); fill: rgba(255, 181, 71, 0.16); }
  .stop-node.active .stop-glow { fill: rgba(255, 181, 71, 0.1); stroke: color-mix(in srgb, var(--human) 55%, transparent); }
  .stop-num { font-family: var(--mono); font-size: 13px; font-weight: 700; fill: var(--ink); }
  .stop-scene { font-size: 12.5px; font-weight: 700; fill: var(--ink); }
  .stop-story { margin-top: 12px; border-top: 1px dashed var(--grid); padding-top: 14px; }
  .story-card { animation: fadeSlide 0.16s cubic-bezier(0.22, 1, 0.36, 1); }
  .story-card h3 { margin: 8px 0 6px; font-size: 19px; }
  .story-card p { margin: 0 0 14px; max-width: 62ch; font-size: 14.5px; line-height: 1.65; color: var(--ink); }
  .scope-chip {
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 6px;
    background: rgba(255, 181, 71, 0.12);
    color: var(--human);
  }
  @media (prefers-reduced-motion: reduce) { .stair-pulse { animation: none; } }
</style>
