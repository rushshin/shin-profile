---
import type { Lang } from '../../data/profile';
import { stops, journeyUi } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const xs = [110, 305, 500, 695, 890];
const baseY = 278;
const last = stops.length - 1;
---

<section id="act-2" class="act act-stops" aria-labelledby="act2-title" data-ready="25">
  <span class="kicker">{t(journeyUi.act2.kicker)}</span>
  <h2 id="act2-title">{t(journeyUi.act2.headline)}</h2>
  <p class="subline">{t(journeyUi.act2.subline)}</p>

  <ol class="ladder" aria-label={lang === 'zh' ? '責任範圍升級' : 'Scope escalation'}>
    {journeyUi.act2.ladder.map((r) => (
      <li data-rung={r.id}>{t(r.label)}</li>
    ))}
  </ol>

  <div class="stage panel">
    <div class="stage-scroll">
      <svg id="stops-svg" class="stops-svg" viewBox="0 0 1000 340" role="group" aria-label={t(journeyUi.act2.groupLabel)}>
        <!-- Shared urban ground plane & subsurface utility pipeline -->
        <line x1="36" y1={baseY} x2="964" y2={baseY} class="ground-line" />
        <path d={`M ${xs[0]} ${baseY + 18} L ${xs[4]} ${baseY + 18}`} class="pipe-track" />
        <path d={`M ${xs[0]} ${baseY + 18} L ${xs[4]} ${baseY + 18}`} class="pipe-pulse" />

        {stops.map((s, i) => {
          const x = xs[i];
          return (
            <g
              class="stop-node"
              data-stop={s.slug}
              data-scope={s.scope}
              data-index={i}
              tabindex={i === last ? 0 : -1}
              role="button"
              aria-pressed={i === last}
              aria-controls="stop-story"
              aria-label={`${s.code} · ${t(s.company)} · ${t(s.scene)}`}
            >
              <rect x={x - 78} y="24" width="156" height="304" fill="transparent" />
              <circle cx={x} cy={baseY + 18} r="5" class="pipe-joint" />

              {/* 01 Foundation slab & container blocks */}
              {i === 0 && (
                <g class="city-glyph">
                  <rect x={x - 42} y={baseY - 22} width="84" height="22" rx="3" />
                  <rect x={x - 30} y={baseY - 46} width="26" height="24" rx="2" />
                  <rect x={x + 4} y={baseY - 40} width="26" height="18" rx="2" />
                </g>
              )}

              {/* 02 Edge relay tower & branching signal waves */}
              {i === 1 && (
                <g class="city-glyph">
                  <rect x={x - 36} y={baseY - 30} width="72" height="30" rx="3" />
                  <polygon points={`${x - 14},${baseY - 30} ${x},${baseY - 96} ${x + 14},${baseY - 30}`} />
                  <circle cx={x} cy={baseY - 102} r="5" class="beacon" />
                  <path d={`M ${x - 22} ${baseY - 92} Q ${x - 32} ${baseY - 102} ${x - 22} ${baseY - 112}`} class="wave" />
                  <path d={`M ${x + 22} ${baseY - 92} Q ${x + 32} ${baseY - 102} ${x + 22} ${baseY - 112}`} class="wave" />
                </g>
              )}

              {/* 03 High-throughput twin towers & stream bridge */}
              {i === 2 && (
                <g class="city-glyph">
                  <rect x={x - 40} y={baseY - 114} width="32" height="114" rx="3" />
                  <rect x={x + 8} y={baseY - 92} width="32" height="92" rx="3" />
                  <path d={`M ${x - 8} ${baseY - 72} Q ${x} ${baseY - 84} ${x + 8} ${baseY - 72}`} class="wave" />
                  <line x1={x - 28} y1={baseY - 90} x2={x - 20} y2={baseY - 90} />
                  <line x1={x - 28} y1={baseY - 70} x2={x - 20} y2={baseY - 70} />
                  <line x1={x + 20} y1={baseY - 68} x2={x + 28} y2={baseY - 68} />
                </g>
              )}

              {/* 04 Shielded financial gateway & twin vault pillars */}
              {i === 3 && (
                <g class="city-glyph human">
                  <rect x={x - 42} y={baseY - 134} width="26" height="134" rx="3" />
                  <rect x={x + 16} y={baseY - 134} width="26" height="134" rx="3" />
                  <path d={`M ${x - 16} ${baseY - 104} H ${x + 16}`} />
                  <path d={`M ${x} ${baseY - 122} L ${x + 14} ${baseY - 114} V ${baseY - 98} C ${x + 14} ${baseY - 88} ${x} ${baseY - 82} ${x} ${baseY - 82} C ${x} ${baseY - 82} ${x - 14} ${baseY - 88} ${x - 14} ${baseY - 98} V ${baseY - 114} Z`} class="shield" />
                </g>
              )}

              {/* 05 Sovereign AI data center spire */}
              {i === 4 && (
                <g class="city-glyph ai">
                  <rect x={x - 44} y={baseY - 168} width="88" height="168" rx="4" />
                  <rect x={x - 28} y={baseY - 146} width="22" height="22" rx="2" />
                  <rect x={x + 6} y={baseY - 146} width="22" height="22" rx="2" />
                  <rect x={x - 28} y={baseY - 112} width="22" height="22" rx="2" />
                  <rect x={x + 6} y={baseY - 112} width="22" height="22" rx="2" />
                  <line x1={x} y1={baseY - 168} x2={x} y2={baseY - 196} />
                  <circle cx={x} cy={baseY - 202} r="6" class="beacon" />
                </g>
              )}

              <text x={x} y={baseY + 40} text-anchor="middle" class="stop-company">{t(s.company)}</text>
              <text x={x} y={baseY + 56} text-anchor="middle" class="stop-years">{s.start}–{s.end}</text>
              <text x={x} y={i === 4 ? baseY - 216 : i === 3 ? baseY - 150 : i === 2 ? baseY - 128 : i === 1 ? baseY - 124 : baseY - 62} text-anchor="middle" class="stop-scene">
                {t(s.scene)}
              </text>
            </g>
          );
        })}
      </svg>
    </div>

    <div id="stop-story" class="stop-story" aria-live="polite">
      {stops.map((s, i) => (
        <article class="story-card" data-story={s.slug} hidden={i !== last}>
          <span class:list={['scope-chip', s.scope]}>{t(s.scopeLabel)}</span>
          <h3>{t(s.company)} · {t(s.scene)}</h3>
          <p>{t(s.story)}</p>
          <div class="story-actions">
            <a class="toggle-btn" href="#act-3">
              {lang === 'zh' ? '展開此站實戰細節 ↓' : 'Inspect this stop below ↓'}
            </a>
            <button type="button" class="ghost-link" data-dossier-open={`dossier-stop-${s.slug}`} aria-haspopup="dialog" aria-controls="dossier">
              {t(journeyUi.dossier.openStop)}
            </button>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  const svg = document.getElementById('stops-svg');
  const nodes = [...document.querySelectorAll<SVGGElement>('[data-stop]')];
  const cards = [...document.querySelectorAll<HTMLElement>('[data-story]')];
  const rungs = [...document.querySelectorAll<HTMLElement>('[data-rung]')];

  const select = (node: SVGGElement, focus: boolean, broadcast = true) => {
    const selectedIdx = Number(node.dataset.index);
    nodes.forEach((n, idx) => {
      const on = n === node;
      n.classList.toggle('active', on);
      n.classList.toggle('lit', idx <= selectedIdx);
      n.setAttribute('aria-pressed', String(on));
      n.tabIndex = on ? 0 : -1;
    });
    cards.forEach((c) => (c.hidden = c.dataset.story !== node.dataset.stop));
    rungs.forEach((r) => r.classList.toggle('on', r.dataset.rung === node.dataset.scope));
    if (broadcast) {
      window.dispatchEvent(new CustomEvent('shin:stop-select', { detail: { index: selectedIdx, source: 'ch2' } }));
    }
    if (focus) node.focus();
  };

  window.addEventListener('shin:stop-select', (e: Event) => {
    const detail = (e as CustomEvent<{ index: number; source?: string }>).detail;
    if (detail?.source === 'ch3' && typeof detail.index === 'number' && nodes[detail.index]) {
      select(nodes[detail.index], false, false);
    }
  });

  nodes.forEach((node, i) => {
    node.addEventListener('click', () => select(node, false));
    node.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        select(node, false);
      } else if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const step = e.key === 'ArrowRight' ? 1 : -1;
        select(nodes[(i + step + nodes.length) % nodes.length], true);
      }
    });
  });
  if (svg && nodes.length) select(nodes[nodes.length - 1], false);
</script>

<style>
  .act-stops { padding: clamp(36px, 6vh, 68px) 0; }
  .ladder {
    list-style: none;
    margin: 0 0 16px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-family: var(--mono);
    font-size: 11.5px;
  }
  .ladder li {
    padding: 5px 10px;
    border: 1px solid var(--grid);
    border-radius: 999px;
    color: var(--mute);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .ladder li + li::before { content: '→ '; color: var(--grid); margin-right: 4px; }
  .ladder li.on { color: var(--human); border-color: var(--human); background: rgba(255, 181, 71, 0.1); }
  .stage-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .stops-svg { width: 100%; height: auto; display: block; }
  @media (max-width: 720px) { .stops-svg { min-width: 680px; } }

  .ground-line { stroke: var(--grid); stroke-width: 1.5; }
  .pipe-track { fill: none; stroke: var(--grid); stroke-width: 2; stroke-dasharray: 4 4; }
  .pipe-pulse {
    fill: none;
    stroke: var(--signal);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-dasharray: 48 800;
    animation: flow 3.8s linear infinite;
  }
  @keyframes flow { from { stroke-dashoffset: 848; } to { stroke-dashoffset: 0; } }

  .stop-node { cursor: pointer; opacity: 0.48; transition: opacity 0.25s ease; }
  .stop-node.lit { opacity: 0.78; }
  .stop-node:hover,
  .stop-node.active { opacity: 1; }

  .pipe-joint { fill: var(--grid); transition: fill 0.2s ease; }
  .stop-node.lit .pipe-joint { fill: var(--signal); }
  .stop-node.active .pipe-joint { fill: var(--ok); }

  .city-glyph {
    fill: rgba(62, 230, 255, 0.04);
    stroke: color-mix(in srgb, var(--signal) 55%, var(--grid));
    stroke-width: 1.6;
    stroke-linejoin: round;
    transition: stroke 0.25s ease, fill 0.25s ease;
  }
  .city-glyph.human {
    fill: rgba(255, 181, 71, 0.05);
    stroke: color-mix(in srgb, var(--human) 60%, var(--grid));
  }
  .city-glyph.ai {
    fill: rgba(92, 242, 154, 0.05);
    stroke: color-mix(in srgb, var(--ok) 60%, var(--grid));
  }
  .stop-node.active .city-glyph {
    fill: rgba(62, 230, 255, 0.12);
    stroke: var(--signal);
  }
  .stop-node.active .city-glyph.human {
    fill: rgba(255, 181, 71, 0.14);
    stroke: var(--human);
  }
  .stop-node.active .city-glyph.ai {
    fill: rgba(92, 242, 154, 0.14);
    stroke: var(--ok);
  }
  .wave { fill: none; }
  .beacon { fill: var(--signal); stroke: none; }
  .city-glyph.ai .beacon { fill: var(--ok); }
  .shield { fill: rgba(255, 181, 71, 0.14); }

  .stop-company { font-size: 12.5px; font-weight: 700; fill: var(--ink); }
  .stop-years { font-family: var(--mono); font-size: 9.5px; fill: var(--mute); }
  .stop-scene { font-family: var(--mono); font-size: 11px; fill: var(--mute); transition: fill 0.2s ease; }
  .stop-node.active .stop-scene { fill: var(--ink); font-weight: 700; }

  .stop-story { margin-top: 14px; border-top: 1px dashed var(--grid); padding-top: 16px; }
  .story-card { animation: fadeSlide 0.16s cubic-bezier(0.22, 1, 0.36, 1); }
  .scope-chip {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 9px;
    border-radius: 999px;
    border: 1px solid var(--grid);
    color: var(--signal);
    margin-bottom: 8px;
  }
  .scope-chip.lead,
  .scope-chip.architect {
    color: var(--human);
    border-color: color-mix(in srgb, var(--human) 45%, transparent);
    background: rgba(255, 181, 71, 0.12);
  }
  .story-card h3 { margin: 0 0 6px; font-size: 19px; }
  .story-card p { margin: 0 0 14px; font-size: 15px; line-height: 1.6; color: var(--mute); max-width: 62ch; }
  .story-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; }
  .story-actions .toggle-btn { text-decoration: none; }
  .ghost-link {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    cursor: pointer;
  }
  .ghost-link:hover { color: var(--ink); text-decoration: underline; }
  @media (prefers-reduced-motion: reduce) { .pipe-pulse { animation: none; } }
</style>
