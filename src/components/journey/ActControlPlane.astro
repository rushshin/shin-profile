---
import type { Lang } from '../../data/profile';
import { journeyUi, swapPairs, squad, principles, rcaSteps } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const a3 = journeyUi.act3;
---

<section id="act-3" class="act act-skills" aria-labelledby="act3-title" data-ready="60">
  <span class="kicker">{t(a3.kicker)}</span>
  <h2 id="act3-title">{t(a3.headline)}</h2>
  <p class="subline">{t(a3.subline)}</p>

  <div class="tabs" role="tablist" aria-label={t(a3.headline)} id="skill-tabs">
    {a3.tabs.map((tab, i) => (
      <button
        type="button"
        role="tab"
        id={`tab-${tab.id}`}
        data-tab={tab.id}
        aria-selected={i === 0}
        aria-controls={`panel-${tab.id}`}
        tabindex={i === 0 ? 0 : -1}
        class:list={['pill-tab', tab.kind, { active: i === 0 }]}
      >
        {t(tab.label)}
      </button>
    ))}
  </div>

  <div class="panel moment">
    <div id="panel-comm" role="tabpanel" aria-labelledby="tab-comm" data-panel="comm" data-plain="false">
      <div class="moment-head">
        <p class="hint">{t(a3.commHint)}</p>
        <button type="button" class="switch" role="switch" aria-checked="false" id="plain-switch">
          <span class="knob" aria-hidden="true"></span>
          <span>{t(a3.commToggle)}</span>
        </button>
      </div>
      <ul class="swap-list" aria-live="polite">
        {swapPairs.map((p) => (
          <li>
            <span class="j">{t(p.jargon)}</span>
            <span class="p">{t(p.plain)}</span>
          </li>
        ))}
      </ul>
    </div>

    <div id="panel-mgmt" role="tabpanel" aria-labelledby="tab-mgmt" data-panel="mgmt" hidden>
      <div class="moment-head">
        <p class="hint">{t(a3.squadHint)}</p>
        <button type="button" class="toggle-btn" id="squad-reset">{t(a3.reset)}</button>
      </div>
      <ul class="squad" aria-live="polite">
        {squad.map((e, i) => (
          <li class="lane" data-lane={e.id} data-state={i === 1 ? 'blocked' : 'running'}>
            <span class="eng">{e.name}</span>
            <span class="task">{t(e.task)}</span>
            <span class="state">
              <b class="s-run">{t(a3.running)}</b>
              <b class="s-blk">{t(a3.blocked)} · {t(e.blocker)}</b>
            </span>
            <button type="button" class="toggle-btn unblock" data-unblock={e.id}>
              {t(a3.unblock)}: {t(e.unblock)}
            </button>
          </li>
        ))}
      </ul>
      <h3 class="sub-h">{t(a3.principlesTitle)}</h3>
      <div class="chips" role="group" aria-label={t(a3.principlesTitle)}>
        {principles.map((p, i) => (
          <button type="button" class:list={['chip', i < 4 ? 'cap' : 'gov']} data-principle={i} aria-pressed="false" aria-controls="principle-detail">
            {String(i + 1).padStart(2, '0')} {t(p.name)}
          </button>
        ))}
      </div>
      <p id="principle-detail" class="principle-detail" aria-live="polite">
        {principles.map((p, i) => <span data-principle-text={i} hidden>{t(p.text)}</span>)}
      </p>
    </div>

    <div id="panel-rca" role="tabpanel" aria-labelledby="tab-rca" data-panel="rca" data-step="0" hidden>
      <div class="rca-steps" role="group" aria-label={t(a3.tabs[2].label)}>
        {rcaSteps.map((s, i) => (
          <button type="button" class:list={['rca-step', { on: i === 0 }]} data-rca={i} aria-pressed={i === 0}>{t(s.label)}</button>
        ))}
      </div>
      <div class="rca-grid" role="img" aria-label={`${t(a3.desired)} / ${t(a3.actual)}`}>
        <span class="rca-lbl">{t(a3.desired)}</span>
        <span class="cell ok"></span><span class="cell ok"></span><span class="cell ok"></span><span class="cell ok"></span>
        <span class="rca-lbl">{t(a3.actual)}</span>
        <span class="cell a" data-bad="0"></span><span class="cell a" data-bad="1"></span><span class="cell a" data-bad="0"></span><span class="cell a" data-bad="1"></span>
      </div>
      {rcaSteps.map((s, i) => (
        <div class="rca-body" data-rca-body={i} hidden={i !== 0}>
          <h3>{t(s.title)}</h3>
          <p>{t(s.body)}</p>
        </div>
      ))}
      <button type="button" class="toggle-btn" id="rca-next">{t(a3.rcaNext)} →</button>
    </div>
  </div>

  <div class="drawer-cta">
    <button type="button" class="toggle-btn" data-dossier-open="dossier-skills" aria-haspopup="dialog" aria-controls="dossier">
      {t(journeyUi.dossier.openSkills)}
    </button>
  </div>
</section>

<script>
  import { bindTabs } from '../../scripts/tabs';

  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const tabList = document.getElementById('skill-tabs');
  if (tabList) bindTabs(tabList, (id) => panels.forEach((p) => (p.hidden = p.dataset.panel !== id)));

  const comm = document.getElementById('panel-comm');
  const sw = document.getElementById('plain-switch');
  sw?.addEventListener('click', () => {
    const on = sw.getAttribute('aria-checked') !== 'true';
    sw.setAttribute('aria-checked', String(on));
    if (comm) comm.dataset.plain = String(on);
  });

  const lanes = [...document.querySelectorAll<HTMLElement>('[data-lane]')];
  const initial = lanes.map((l) => l.dataset.state);
  document.querySelectorAll<HTMLElement>('[data-unblock]').forEach((b) =>
    b.addEventListener('click', () => {
      const lane = lanes.find((l) => l.dataset.lane === b.dataset.unblock);
      if (lane) lane.dataset.state = 'running';
    })
  );
  document.getElementById('squad-reset')?.addEventListener('click', () =>
    lanes.forEach((l, i) => (l.dataset.state = initial[i] || 'running'))
  );

  const chips = [...document.querySelectorAll<HTMLElement>('[data-principle]')];
  const texts = [...document.querySelectorAll<HTMLElement>('[data-principle-text]')];
  chips.forEach((c) =>
    c.addEventListener('click', () => {
      chips.forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
      texts.forEach((x) => (x.hidden = x.dataset.principleText !== c.dataset.principle));
    })
  );

  const rca = document.getElementById('panel-rca');
  const steps = [...document.querySelectorAll<HTMLElement>('[data-rca]')];
  const bodies = [...document.querySelectorAll<HTMLElement>('[data-rca-body]')];
  const setStep = (n: number) => {
    if (rca) rca.dataset.step = String(n);
    steps.forEach((s, i) => {
      s.classList.toggle('on', i === n);
      s.setAttribute('aria-pressed', String(i === n));
    });
    bodies.forEach((b, i) => (b.hidden = i !== n));
  };
  steps.forEach((s, i) => s.addEventListener('click', () => setStep(i)));
  document.getElementById('rca-next')?.addEventListener('click', () => setStep(((Number(rca?.dataset.step) || 0) + 1) % 3));
</script>

<style>
  .act-skills { padding: clamp(36px, 6vh, 68px) 0; }
  .tabs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .moment-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .hint { margin: 0; max-width: 60ch; font-size: 13.5px; color: var(--mute); line-height: 1.6; }

  .switch {
    appearance: none;
    font: inherit;
    font-size: 12.5px;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: transparent;
    border: 1px solid var(--grid);
    border-radius: 999px;
    padding: 5px 14px 5px 6px;
    cursor: pointer;
  }
  .knob {
    width: 34px;
    height: 20px;
    border-radius: 999px;
    background: #1b2430;
    position: relative;
    transition: background 0.2s ease;
  }
  .knob::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--signal);
    transition: transform 0.22s cubic-bezier(0.22, 1, 0.36, 1), background 0.2s ease;
  }
  .switch[aria-checked='true'] { border-color: var(--human); }
  .switch[aria-checked='true'] .knob { background: rgba(255, 181, 71, 0.3); }
  .switch[aria-checked='true'] .knob::after { transform: translateX(14px); background: var(--human); }

  .swap-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .swap-list li { padding: 12px 14px; border: 1px solid var(--grid); border-radius: 10px; background: #0a0d12; font-size: 14px; line-height: 1.55; }
  .swap-list .j { font-family: var(--mono); font-size: 13px; color: var(--signal); }
  .swap-list .p { display: none; color: var(--human); }
  [data-plain='true'] .swap-list .j { display: none; }
  [data-plain='true'] .swap-list .p { display: inline; animation: fadeSlide 0.16s ease; }

  .squad { list-style: none; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; }
  .lane {
    display: grid;
    grid-template-columns: 56px minmax(0, 1.1fr) minmax(0, 1fr) auto;
    gap: 10px;
    align-items: center;
    padding: 10px 12px;
    border: 1px solid var(--grid);
    border-radius: 10px;
    background: #0a0d12;
    font-size: 13px;
  }
  .eng { font-family: var(--mono); color: var(--human); font-size: 12px; }
  .state b { font-family: var(--mono); font-size: 11.5px; font-weight: 600; }
  .s-run { color: var(--ok); }
  .s-blk { color: var(--warn, #ff7b72); }
  .lane[data-state='running'] .s-blk,
  .lane[data-state='running'] .unblock { display: none; }
  .lane[data-state='blocked'] .s-run { display: none; }
  .lane[data-state='blocked'] { border-color: color-mix(in srgb, var(--warn, #ff7b72) 55%, var(--grid)); }
  .lane[data-state='running'] { border-color: color-mix(in srgb, var(--ok) 35%, var(--grid)); }
  .unblock { font-size: 11.5px; color: var(--human); border-color: color-mix(in srgb, var(--human) 45%, transparent); background: rgba(255, 181, 71, 0.07); text-align: left; }
  .sub-h { margin: 0 0 8px; font-family: var(--mono); font-size: 11px; letter-spacing: 0.08em; color: var(--mute); font-weight: 500; }
  .chips { display: flex; flex-wrap: wrap; gap: 6px; }
  .chip {
    appearance: none;
    font: inherit;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ink);
    background: #0a0d12;
    border: 1px solid var(--grid);
    border-radius: 6px;
    padding: 5px 9px;
    cursor: pointer;
  }
  .chip.cap { border-color: color-mix(in srgb, var(--signal) 40%, var(--grid)); }
  .chip.gov { border-color: color-mix(in srgb, var(--human) 40%, var(--grid)); }
  .chip[aria-pressed='true'].cap { background: rgba(62, 230, 255, 0.12); }
  .chip[aria-pressed='true'].gov { background: rgba(255, 181, 71, 0.12); }
  .principle-detail { min-height: 22px; margin: 10px 0 0; font-size: 13.5px; color: var(--ink); }

  .rca-steps { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 14px; }
  .rca-step { appearance: none; font: inherit; font-family: var(--mono); font-size: 12px; color: var(--mute); background: #0a0d12; border: 1px solid var(--grid); border-radius: 8px; padding: 7px 12px; cursor: pointer; }
  .rca-step.on { color: var(--ink); border-color: var(--signal); background: rgba(62, 230, 255, 0.1); }
  .rca-grid { display: grid; grid-template-columns: 64px repeat(4, minmax(0, 1fr)); gap: 6px; align-items: center; max-width: 480px; margin-bottom: 14px; }
  .rca-lbl { font-family: var(--mono); font-size: 11px; color: var(--mute); }
  .cell { height: 22px; border-radius: 5px; border: 1px solid var(--grid); transition: background 0.35s ease, border-color 0.35s ease; }
  .cell.ok { background: rgba(92, 242, 154, 0.2); border-color: var(--ok); }
  .cell.a { background: rgba(92, 242, 154, 0.2); border-color: var(--ok); }
  #panel-rca[data-step='0'] .cell.a[data-bad='1'] { background: rgba(255, 123, 114, 0.22); border-color: var(--warn, #ff7b72); }
  #panel-rca[data-step='1'] .cell.a[data-bad='1'] { background: rgba(255, 181, 71, 0.25); border-color: var(--human); box-shadow: 0 0 0 2px rgba(255, 181, 71, 0.2); }
  .rca-body h3 { margin: 0 0 6px; font-size: 17px; }
  .rca-body p { margin: 0 0 14px; font-size: 14px; color: var(--mute); max-width: 60ch; line-height: 1.6; }
  .drawer-cta { margin-top: 16px; }

  @media (max-width: 720px) {
    .lane { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
