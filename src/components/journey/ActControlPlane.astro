---
import type { Lang } from '../../data/profile';
import { journeyUi, principles } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const a3 = journeyUi.act3;

const pillars = [
  {
    id: 'tech',
    code: '01 · TECH',
    kind: 'system',
    title: { zh: '系統架構與技術深度', en: 'Architecture & Technical Depth' },
    summary: {
      zh: '從裸機佈建、Kubernetes HA、GitOps 到企業資安與 AI 基礎設施，以程式碼確保環境可重複重建。',
      en: 'From bare-metal provisioning, Kubernetes HA, and GitOps to enterprise PKI and AI infra—built as code for repeatability.',
    },
    exampleLabel: { zh: '代表實作', en: 'In Practice' },
    example: {
      zh: 'Kubespray HA + Terraform / ArgoCD GitOps + OpenBao PKI + Go 離線安裝器',
      en: 'Kubespray HA + Terraform / ArgoCD GitOps + OpenBao PKI + Go air-gapped installer',
    },
  },
  {
    id: 'comm',
    code: '02 · COMMUNICATION',
    kind: 'human',
    title: { zh: '跨域溝通與決策對齊', en: 'Cross-Functional Alignment' },
    summary: {
      zh: '把底層架構限制轉譯為客戶、主管與資安都能理解的風險與取捨，縮短來回對齊成本。',
      en: 'Translates low-level technical constraints into clear trade-offs so clients, execs, and security can decide quickly.',
    },
    exampleLabel: { zh: '語言轉譯示例', en: 'Translation Example' },
    example: {
      zh: '「External Secrets 串 OpenBao」→「機密不進 Git 歷史，符合企業稽核並降低外洩風險」',
      en: '"External Secrets + OpenBao" → "Zero secrets in Git history, audit-ready by design"',
    },
  },
  {
    id: 'rca',
    code: '03 · PROBLEM SOLVING',
    kind: 'system',
    title: { zh: '問題拆解與根因收斂', en: 'Problem Solving & Root-Cause Analysis' },
    summary: {
      zh: '面對模糊或跨域卡關時，先釐清雙方期待與系統邊界，再收斂成標準化流程而非臨時補丁。',
      en: 'Resolves ambiguous technical and cross-team blockers by isolating root causes and turning fixes into repeatable specs.',
    },
    exampleLabel: { zh: '拆解路徑', en: 'Resolution Path' },
    example: {
      zh: '現況卡關（斷網交付／簽核不明）→ 釐清邊界與期望 → 沉澱為 SiteSpec 與 OpenTelemetry 追蹤標準',
      en: 'Blocker (air-gapped / unclear handoff) → Align boundaries → Standardized SiteSpec & OTel tracing',
    },
  },
  {
    id: 'mgmt',
    code: '04 · LEADERSHIP',
    kind: 'human',
    title: { zh: '團隊賦能與 AI 工作流治理', en: 'Team Leadership & AI Governance' },
    summary: {
      zh: '透過任務拆解、排除阻礙與開發內部工具放大團隊戰力，並建立安全可控的 AI 協作準則。',
      en: 'Multiplies team velocity by clearing blockers, building internal tools, and governing AI-assisted workflows.',
    },
    exampleLabel: { zh: '治理框架', en: 'Governance' },
    example: {
      zh: '帶領 5–8 人網銀 SRE 團隊；建立 8 個 AI 工作流準則與自動化工具（工時、憑證、MR 審查）',
      en: 'Led 5–8 banking SREs; established 8 AI-workflow principles & internal velocity tools',
    },
  },
];
---

<section id="act-3" class="act act-skills" aria-labelledby="act3-title" data-ready="75">
  <span class="kicker">{t(a3.kicker)}</span>
  <h2 id="act3-title">{t(a3.headline)}</h2>
  <p class="subline">{t(a3.subline)}</p>

  <div class="cap-grid">
    {pillars.map((p) => (
      <article class:list={['panel cap-card', p.kind]}>
        <div class="cap-head">
          <span class="cap-code">{p.code}</span>
          <span class:list={['cap-dot', p.kind]} aria-hidden="true"></span>
        </div>
        <h3>{t(p.title)}</h3>
        <p class="cap-sum">{t(p.summary)}</p>
        <div class="cap-proof">
          <span class="proof-lbl">{t(p.exampleLabel)}</span>
          <p class="proof-txt">{t(p.example)}</p>
        </div>
      </article>
    ))}
  </div>

  <!-- Optional expandable 8 AI principles summary -->
  <details class="panel principles-box">
    <summary class="pr-summary">
      <span>{t(a3.principlesTitle)}</span>
      <span class="pr-hint">{lang === 'zh' ? '點擊展開 8 項準則' : 'Expand 8 principles'} ▾</span>
    </summary>
    <div class="pr-grid">
      {principles.map((p, i) => (
        <div class="pr-item">
          <span class:list={['pr-num', i < 4 ? 'cap' : 'gov']}>{String(i + 1).padStart(2, '0')} · {t(p.name)}</span>
          <p>{t(p.text)}</p>
        </div>
      ))}
    </div>
  </details>

  <div class="drawer-cta">
    <button type="button" class="toggle-btn" data-dossier-open="dossier-skills" aria-haspopup="dialog" aria-controls="dossier">
      {t(journeyUi.dossier.openSkills)}
    </button>
  </div>
</section>

<style>
  .act-skills { padding: clamp(36px, 6vh, 68px) 0; }
  .cap-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 14px;
  }
  .cap-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 20px;
    transition: border-color 0.22s ease, transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .cap-card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--signal) 50%, var(--grid));
  }
  .cap-card.human:hover {
    border-color: color-mix(in srgb, var(--human) 55%, var(--grid));
  }
  .cap-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .cap-code {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    color: var(--mute);
  }
  .cap-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }
  .cap-dot.system { background: var(--signal); }
  .cap-dot.human { background: var(--human); }

  .cap-card h3 {
    margin: 0 0 8px;
    font-size: 17.5px;
    color: var(--ink);
  }
  .cap-sum {
    margin: 0 0 14px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--mute);
  }
  .cap-proof {
    padding-top: 12px;
    border-top: 1px dashed var(--grid);
  }
  .proof-lbl {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--signal);
    margin-bottom: 4px;
  }
  .cap-card.human .proof-lbl {
    color: var(--human);
  }
  .proof-txt {
    margin: 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--ink);
  }

  .principles-box {
    padding: 14px 18px;
  }
  .pr-summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    cursor: pointer;
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink);
    list-style: none;
  }
  .pr-summary::-webkit-details-marker { display: none; }
  .pr-hint {
    color: var(--signal);
    font-size: 11.5px;
  }
  .pr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px 18px;
    margin-top: 14px;
    padding-top: 14px;
    border-top: 1px dashed var(--grid);
  }
  .pr-num {
    display: block;
    font-family: var(--mono);
    font-size: 11.5px;
    font-weight: 700;
    margin-bottom: 2px;
  }
  .pr-num.cap { color: var(--signal); }
  .pr-num.gov { color: var(--human); }
  .pr-item p {
    margin: 0;
    font-size: 13px;
    color: var(--mute);
    line-height: 1.5;
  }

  .drawer-cta {
    margin-top: 16px;
  }

  @media (max-width: 780px) {
    .cap-grid,
    .pr-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
