---
import type { Lang } from '../../data/profile';
import { profile } from '../../data/profile';
import { journeyUi, stops } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const workHref = (slug: string) => `${lang === 'zh' ? '' : '/en'}/work/${slug}/`;
const tagsBySlug = new Map(profile.experience.map((e) => [e.slug, e.tags]));
const last = stops.length - 1;

const header = {
  kicker: { zh: '03 · 站點實戰展開', en: '03 · STATION DEEP DIVE' },
  headline: { zh: '每一座街區背後，當時如何把事做成', en: 'Inside each district: challenge, trade-off, and outcome' },
  subline: {
    zh: '直接承接上方所選的職涯站點——展開該階段真實面對的限制、架構取捨與交付成果。',
    en: 'Synced with your selected district above—inspect the real constraints, trade-offs, and deliverables.',
  },
};
---

<section id="act-3" class="act act-deep" aria-labelledby="act3-title" data-ready="75">
  <span class="kicker">{t(header.kicker)}</span>
  <h2 id="act3-title">{t(header.headline)}</h2>
  <p class="subline">{t(header.subline)}</p>

  <!-- Synced 5-station selector -->
  <div class="station-tabs" role="tablist" aria-label={t(header.headline)}>
    {stops.map((s, i) => (
      <button
        type="button"
        role="tab"
        data-deep-tab={s.slug}
        data-index={i}
        aria-selected={i === last}
        tabindex={i === last ? 0 : -1}
        class:list={['pill-tab', { active: i === last }]}
      >
        {String(i + 1).padStart(2, '0')} · {t(s.company)}
      </button>
    ))}
  </div>

  <div class="panel deep-stage" aria-live="polite">
    {stops.map((s, i) => {
      const tags = tagsBySlug.get(s.slug) ?? [];
      return (
        <article class="deep-pane" data-deep-pane={s.slug} hidden={i !== last}>
          <div class="dp-head">
            <div>
              <span class="dp-meta">{s.start} — {s.end} · {t(s.scopeLabel)}</span>
              <h3>{t(s.company)} — {t(s.role)}</h3>
              <p class="dp-team">{t(s.team)}</p>
            </div>
            <a class="case-btn" href={workHref(s.slug)}>{t(journeyUi.act2.caseLink)}</a>
          </div>

          <div class="dp-grid">
            <div class="dp-cell">
              <span class="cell-lbl">{t(journeyUi.act2.challenge)}</span>
              <p>{t(s.challenge)}</p>
            </div>
            <div class="dp-cell accent">
              <span class="cell-lbl">{t(journeyUi.act2.decision)}</span>
              <p>{t(s.decision)}</p>
            </div>
            <div class="dp-cell human">
              <span class="cell-lbl">{t(journeyUi.act2.tradeoff)}</span>
              <p>{t(s.tradeoff)}</p>
            </div>
            <div class="dp-cell ok">
              <span class="cell-lbl">{t(journeyUi.act2.result)}</span>
              <p>{t(s.result)}</p>
            </div>
          </div>

          {tags.length > 0 && (
            <div class="dp-tags">
              {tags.map((tag) => <span class="dp-tag">{tag}</span>)}
            </div>
          )}
        </article>
      );
    })}
  </div>

  <div class="drawer-cta">
    <button type="button" class="toggle-btn" data-dossier-open="dossier-skills" aria-haspopup="dialog" aria-controls="dossier">
      {t(journeyUi.dossier.openSkills)}
    </button>
  </div>
</section>

<script>
  const tabs = [...document.querySelectorAll<HTMLElement>('[data-deep-tab]')];
  const panes = [...document.querySelectorAll<HTMLElement>('[data-deep-pane]')];

  const activateIndex = (idx: number, broadcast: boolean) => {
    const target = tabs[idx];
    if (!target) return;
    const slug = target.dataset.deepTab!;
    tabs.forEach((b, i) => {
      const on = i === idx;
      b.classList.toggle('active', on);
      b.setAttribute('aria-selected', String(on));
      b.tabIndex = on ? 0 : -1;
    });
    panes.forEach((p) => (p.hidden = p.dataset.deepPane !== slug));
    if (broadcast) {
      window.dispatchEvent(new CustomEvent('shin:stop-select', { detail: { index: idx, source: 'ch3' } }));
    }
  };

  tabs.forEach((btn, i) => {
    btn.addEventListener('click', () => activateIndex(i, true));
    btn.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const next = (i + (e.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
        activateIndex(next, true);
        tabs[next].focus();
      }
    });
  });

  // Sync automatically when Ch 2 selects a city district
  window.addEventListener('shin:stop-select', (e: Event) => {
    const detail = (e as CustomEvent<{ index: number; source?: string }>).detail;
    if (detail?.source !== 'ch3' && typeof detail?.index === 'number') {
      activateIndex(detail.index, false);
    }
  });
</script>

<style>
  .act-deep { padding: clamp(36px, 6vh, 68px) 0; }
  .station-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }
  .deep-stage { padding: 22px; }
  .deep-pane { animation: fadeSlide 0.16s cubic-bezier(0.22, 1, 0.36, 1); }

  .dp-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 14px;
    border-bottom: 1px dashed var(--grid);
    margin-bottom: 16px;
  }
  .dp-meta {
    display: block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
    margin-bottom: 4px;
  }
  .dp-head h3 { margin: 0 0 4px; font-size: 20px; color: var(--ink); }
  .dp-team { margin: 0; font-size: 13.5px; color: var(--mute); }
  .case-btn {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ok);
    text-decoration: none;
    border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent);
    border-radius: 999px;
    padding: 6px 13px;
  }
  .case-btn:hover { background: rgba(92, 242, 154, 0.1); }

  .dp-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 14px;
  }
  .dp-cell {
    border: 1px solid var(--grid);
    border-radius: 12px;
    background: rgba(10, 14, 22, 0.42);
    padding: 14px 16px;
  }
  .dp-cell.accent { border-color: color-mix(in srgb, var(--signal) 40%, var(--grid)); }
  .dp-cell.human { border-color: color-mix(in srgb, var(--human) 40%, var(--grid)); }
  .dp-cell.ok { border-color: color-mix(in srgb, var(--ok) 40%, var(--grid)); }

  .cell-lbl {
    display: block;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.08em;
    color: var(--mute);
    margin-bottom: 6px;
  }
  .dp-cell.accent .cell-lbl { color: var(--signal); }
  .dp-cell.human .cell-lbl { color: var(--human); }
  .dp-cell.ok .cell-lbl { color: var(--ok); }
  .dp-cell p { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--ink); }

  .dp-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .dp-tag {
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--grid);
    color: var(--mute);
  }
  .drawer-cta { margin-top: 16px; }

  @media (max-width: 780px) {
    .dp-grid { grid-template-columns: 1fr; }
  }
</style>
