---
import { profile, ui, type Lang } from '../../data/profile';
import { journeyUi, roleLenses } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
const ext = (href: string) => (href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
---

<section id="act-4" class="act act-value" aria-labelledby="act4-title">
  <span class="kicker ok">{t(journeyUi.act4.kicker)}</span>
  <h2 id="act4-title">{t(journeyUi.act4.headline)}</h2>
  <p class="subline">{t(journeyUi.act4.subline)}</p>

  <div class="panel role-panel">
    <div class="role-tabs" role="tablist" aria-label={t(journeyUi.act4.roleLabel)}>
      {roleLenses.map((r, idx) => (
        <button
          type="button"
          role="tab"
          id={`role-tab-${r.id}`}
          aria-controls={`role-panel-${r.id}`}
          aria-selected={idx === 0}
          tabindex={idx === 0 ? 0 : -1}
          class:list={['role-btn', { active: idx === 0 }]}
          data-tab={r.id}
          data-role-btn={r.id}
        >
          {t(r.label)}
        </button>
      ))}
    </div>

    <div class="lens-body">
      {roleLenses.map((r, idx) => (
        <div
          id={`role-panel-${r.id}`}
          role="tabpanel"
          aria-labelledby={`role-tab-${r.id}`}
          class="role-tabpanel"
          data-role-panel={r.id}
          hidden={idx !== 0}
        >
          <h3>{t(r.headline)}</h3>
          <ul class="roi-list">
            {r.bullets[lang].map((b) => (
              <li>{b}</li>
            ))}
          </ul>
          <div class="stack-drawer" data-stack-drawer hidden>
            {r.stack.map((s) => (
              <span class="stack-chip">{s}</span>
            ))}
          </div>
        </div>
      ))}

      <button
        type="button"
        class="toggle-btn"
        id="stack-toggle"
        aria-expanded="false"
        data-show={t(journeyUi.act4.stackShow)}
        data-hide={t(journeyUi.act4.stackHide)}
      >
        {t(journeyUi.act4.stackShow)}
      </button>
    </div>
  </div>

  <div class="closing-cta">
    <p class="closing-line">{t(journeyUi.act4.closing)}</p>
    <div class="cta-row">
      <a class="btn-ok" href="mailto:pig840814@gmail.com">{t(journeyUi.act4.cta)} →</a>
      <a class="btn-ghost" href={resumeHref} download>{t(ui.resumePdf)}</a>
      {profile.links.slice(0, 2).map((l) => (
        <a class="btn-ghost" href={l.href} {...ext(l.href)}>{l.label} ↗</a>
      ))}
      <button type="button" class="btn-ghost" data-open-dossier>{t(journeyUi.dossier.open)}</button>
    </div>
  </div>
</section>

<script>
  import { bindTabs } from '../../scripts/tabs';

  const roleList = document.querySelector<HTMLElement>('.role-tabs');
  const rolePanels = document.querySelectorAll<HTMLElement>('[data-role-panel]');
  if (roleList) {
    bindTabs(roleList, (id) => {
      rolePanels.forEach((p) => {
        p.hidden = p.dataset.rolePanel !== id;
      });
    });
  }

  const stackToggle = document.getElementById('stack-toggle');
  const drawers = document.querySelectorAll<HTMLElement>('[data-stack-drawer]');
  stackToggle?.addEventListener('click', () => {
    const next = stackToggle.getAttribute('aria-expanded') !== 'true';
    stackToggle.setAttribute('aria-expanded', String(next));
    drawers.forEach((d) => (d.hidden = !next));
    stackToggle.textContent = next ? stackToggle.dataset.hide || '' : stackToggle.dataset.show || '';
  });
</script>

<style>
  .act-value {
    padding: clamp(44px, 7vh, 76px) 0 clamp(56px, 9vh, 92px);
  }
  .kicker.ok {
    color: var(--ok);
  }
  .role-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .role-tabs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    margin-bottom: 18px;
  }
  .role-btn {
    appearance: none;
    font: inherit;
    font-size: 12.5px;
    color: var(--mute);
    background: #0a0d12;
    border: 1px solid var(--grid);
    border-radius: 10px;
    padding: 10px 8px;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease;
  }
  .role-btn:hover {
    color: var(--ink);
  }
  .role-btn.active {
    color: var(--ink);
    border-color: var(--ok);
    background: rgba(92, 242, 154, 0.1);
    font-weight: 600;
  }
  .role-tabpanel {
    animation: fadeSlide 0.16s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .role-tabpanel h3 {
    margin: 0 0 12px;
    font-size: 19px;
    line-height: 1.4;
  }
  .roi-list {
    margin: 0 0 16px;
    padding-left: 18px;
    display: grid;
    gap: 9px;
    font-size: 14.5px;
    color: var(--mute);
  }
  .stack-drawer {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-bottom: 16px;
  }
  .stack-chip {
    font-family: var(--mono);
    font-size: 11px;
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid var(--grid);
    color: var(--signal);
    background: rgba(62, 230, 255, 0.05);
  }

  .closing-cta {
    margin-top: 28px;
    border-top: 1px solid var(--grid);
    padding-top: 26px;
    text-align: center;
  }
  .closing-line {
    margin: 0 0 18px;
    font-size: clamp(1.3rem, 2.6vw, 1.85rem);
    font-weight: 750;
    color: var(--ink);
  }
  .cta-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .btn-ok {
    display: inline-flex;
    align-items: center;
    padding: 10px 18px;
    border-radius: 10px;
    background: var(--ok);
    color: #06130b;
    font-weight: 700;
    font-size: 13.5px;
    text-decoration: none;
  }
  .closing-cta .btn-ghost {
    appearance: none;
    background: transparent;
    font-family: inherit;
    cursor: pointer;
  }

  @media (max-width: 720px) {
    .role-tabs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
