---
import { profile, ui, type Lang } from '../../data/profile';
import { journeyUi, valuePillars } from '../../data/journey';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
---

<section id="act-1" class="act act-identity" aria-labelledby="act1-title">
  <span class="kicker">{t(journeyUi.act1.kicker)}</span>
  <h2 id="act1-title">{t(journeyUi.act1.headline)}</h2>
  <p class="subline">{t(journeyUi.act1.subline)}</p>

  <div class="value-pillars" role="list" aria-label={lang === 'zh' ? '核心價值面向' : 'Core value pillars'}>
    {valuePillars.map((vp, idx) => (
      <article class="pillar-card" role="listitem">
        <span class="pillar-num">0{idx + 1}</span>
        <h3>{t(vp.title)}</h3>
        <p>{t(vp.body)}</p>
      </article>
    ))}
  </div>

  <aside class="dossier-strip" aria-label={t(journeyUi.act1.essentialsTitle)}>
    <div class="strip-head">
      <span class="strip-tag">DOSSIER // VERIFIED PROFILE</span>
      <span class="strip-trust">{t(journeyUi.act1.trust)}</span>
    </div>
    <div class="strip-meta">
      <span>{t(profile.education[0].school)} {t(profile.education[0].degree)}</span>
      <span>{t(profile.location)} · {t(profile.workMode)} · {lang === 'zh' ? '中英雙語' : 'Bilingual (zh/en)'}</span>
    </div>
    <div class="strip-links">
      <button type="button" class="link-btn" data-open-dossier>{lang === 'zh' ? '展開完整履歷實證 →' : 'Open full dossier →'}</button>
      <a href={resumeHref} download>{t(ui.resumePdf)} ↓</a>
      {profile.links.slice(0, 2).map((l) => (
        <a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a>
      ))}
    </div>
  </aside>

  <div class="section-next">
    <a class="next-btn" href="#act-2">{t(journeyUi.act1.ctaStart)}</a>
  </div>
</section>

<style>
  .act-identity {
    padding: clamp(48px, 8vh, 88px) 0 clamp(36px, 6vh, 64px);
  }
  .value-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-bottom: 20px;
  }
  .pillar-card {
    border: 1px solid var(--grid);
    border-radius: 16px;
    background: rgba(12, 16, 23, 0.78);
    backdrop-filter: blur(8px);
    padding: 20px;
    transition: border-color 0.22s ease, transform 0.22s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .pillar-card:hover {
    border-color: color-mix(in srgb, var(--signal) 55%, var(--grid));
    transform: translateY(-2px);
  }
  .pillar-num {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
    margin-bottom: 8px;
  }
  .pillar-card h3 {
    margin: 0 0 8px;
    font-size: 16.5px;
    color: var(--ink);
  }
  .pillar-card p {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--mute);
  }

  .dossier-strip {
    border: 1px solid color-mix(in srgb, var(--ok) 32%, var(--grid));
    border-radius: 14px;
    background: rgba(10, 15, 22, 0.85);
    backdrop-filter: blur(8px);
    padding: 16px 20px;
    font-family: var(--mono);
    font-size: 12px;
  }
  .strip-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 8px;
  }
  .strip-tag {
    font-size: 10.5px;
    letter-spacing: 0.1em;
    color: var(--ok);
  }
  .strip-trust {
    color: var(--ink);
  }
  .strip-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    color: var(--mute);
    margin-bottom: 12px;
  }
  .strip-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
  }
  .strip-links a,
  .link-btn {
    appearance: none;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: var(--signal);
    text-decoration: none;
    cursor: pointer;
  }
  .strip-links a:hover,
  .link-btn:hover {
    text-decoration: underline;
  }

  .section-next {
    margin-top: 22px;
  }
  .next-btn {
    display: inline-flex;
    align-items: center;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--grid);
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .next-btn:hover {
    border-color: var(--signal);
    color: var(--signal);
  }

  @media (max-width: 860px) {
    .value-pillars {
      grid-template-columns: 1fr;
    }
  }
</style>
