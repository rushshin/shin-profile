---
import { profile, ui, type Lang } from '../../data/profile';
import { journeyUi, essentials } from '../../data/journey';
import IsoStack from './IsoStack.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
const quick = [essentials[1], essentials[4]];
---

<section id="act-1" class="act act-identity" aria-labelledby="act1-title" data-ready="0">
  <div class="act-grid">
    <div class="copy-col">
      <span class="kicker">{t(journeyUi.act1.kicker)}</span>
      <h1 id="act1-title">{t(journeyUi.act1.headline)}</h1>
      <p class="subline">{t(journeyUi.act1.subline)}</p>

      <ul class="value-row">
        {journeyUi.act1.values.map((v) => <li>{t(v)}</li>)}
      </ul>

      <div class="hero-cta">
        <a class="btn-signal" href="#act-2" id="fire-request">{t(journeyUi.act1.ctaStart)}</a>
        <button type="button" class="toggle-btn" data-dossier-open="dossier-essentials" aria-haspopup="dialog" aria-controls="dossier">
          {t(journeyUi.dossier.open)}
        </button>
      </div>

      <div class="ds-strip" aria-label={journeyUi.dossier.header}>
        <span class="ds-strip-tag">{journeyUi.dossier.header}</span>
        <p class="ds-strip-trust">{t(journeyUi.act1.trust)}</p>
        <ul class="ds-strip-meta">
          {quick.map((q) => <li>{t(q.value)}</li>)}
          <li><a href={resumeHref} download>{t(ui.resumePdf)}</a></li>
          {profile.links.slice(0, 2).map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="visual-col">
      <div class="blueprint-box">
        <div class="bp-bar">
          <span>{t(journeyUi.storyTitle)}</span>
          <span>0% · {lang === 'zh' ? '暗' : 'DARK'}</span>
        </div>
        <IsoStack lang={lang} mode="dark" />
      </div>
    </div>
  </div>
</section>

<style>
  .act-identity {
    padding: clamp(28px, 6vh, 64px) 0 clamp(40px, 7vh, 72px);
  }
  .act-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(24px, 4vw, 52px);
    align-items: center;
  }
  h1 {
    margin: 0 0 14px;
    font-size: clamp(2rem, 4.2vw, 3.1rem);
    font-weight: 750;
    line-height: 1.12;
    letter-spacing: -0.025em;
  }
  .subline {
    max-width: 48ch;
    font-size: 15.5px;
  }
  .value-row {
    list-style: none;
    margin: 0 0 18px;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .value-row li {
    padding: 5px 11px;
    border: 1px solid color-mix(in srgb, var(--human) 45%, transparent);
    border-radius: 999px;
    background: rgba(255, 181, 71, 0.08);
    color: var(--human);
    font-size: 12.5px;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 22px;
  }
  .ds-strip {
    border: 1px solid #26323f;
    border-left: 3px solid var(--ok);
    border-radius: 8px;
    background: #0b0f14;
    padding: 10px 14px 12px;
    font-family: var(--mono);
    max-width: 52ch;
  }
  .ds-strip-tag {
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--ok);
  }
  .ds-strip-trust {
    margin: 6px 0 8px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--ink);
  }
  .ds-strip-meta {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    font-size: 11.5px;
    color: var(--mute);
  }
  .ds-strip-meta a {
    color: var(--signal);
    text-decoration: none;
  }
  .ds-strip-meta a:hover { text-decoration: underline; }
  .blueprint-box {
    border: 1px solid var(--grid);
    border-radius: 18px;
    background:
      linear-gradient(to right, rgba(62, 230, 255, 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      linear-gradient(to bottom, rgba(62, 230, 255, 0.04) 1px, transparent 1px) 0 0 / 28px 28px,
      rgba(13, 18, 25, 0.9);
    padding: 14px 18px 10px;
  }
  .bp-bar {
    display: flex;
    justify-content: space-between;
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--mute);
    margin-bottom: 6px;
  }
  @media (max-width: 900px) {
    .act-grid { grid-template-columns: 1fr; }
  }
</style>
