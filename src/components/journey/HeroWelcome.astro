---
import { profile, ui, type Lang } from '../../data/profile';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;

const copy = {
  eyebrow: {
    zh: 'SHIN LIN · 個人架構履歷與實證',
    en: 'SHIN LIN · ARCHITECTURE & LEADERSHIP',
  },
  headline: {
    zh: '把複雜基礎設施，轉化為商業落地、團隊戰力與營運效率。',
    en: 'Turning complex infrastructure into business velocity, team leverage, and operational resilience.',
  },
  explore: {
    zh: '開始探索 ↓',
    en: 'Explore ↓',
  },
  dossier: {
    zh: '履歷實證',
    en: 'Dossier',
  },
};
---

<section id="hero" class="hero-welcome" aria-labelledby="hero-name">
  <div class="hero-inner">
    <span class="hero-eyebrow">{t(copy.eyebrow)}</span>
    <h1 id="hero-name">{t(profile.name)}</h1>
    <p class="hero-role">{t(profile.title)}</p>
    <p class="hero-headline">{t(copy.headline)}</p>

    <div class="hero-actions">
      <a class="btn-signal" href="#act-1">{t(copy.explore)}</a>
      <button type="button" class="btn-ghost" data-dossier-open="dossier-essentials">{t(copy.dossier)}</button>
      <a class="btn-ghost" href={resumeHref} download>{t(ui.resumePdf)}</a>
    </div>
  </div>

  <a class="scroll-cue" href="#act-1" aria-label={t(copy.explore)}>
    <span class="cue-line" aria-hidden="true"></span>
    <span>SCROLL</span>
  </a>
</section>

<style>
  .hero-welcome {
    min-height: calc(100svh - 60px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    position: relative;
    padding: clamp(32px, 6vh, 64px) 0 72px;
  }
  .hero-inner {
    max-width: 680px;
  }
  .hero-eyebrow {
    display: inline-block;
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.16em;
    color: var(--signal);
    margin-bottom: 14px;
  }
  h1 {
    margin: 0 0 8px;
    font-size: clamp(2.8rem, 6.5vw, 4.6rem);
    font-weight: 800;
    line-height: 1.04;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .hero-role {
    margin: 0 0 22px;
    font-family: var(--mono);
    font-size: clamp(0.92rem, 1.5vw, 1.08rem);
    color: var(--human);
  }
  .hero-headline {
    margin: 0 0 28px;
    font-size: clamp(1.25rem, 2.3vw, 1.6rem);
    font-weight: 600;
    line-height: 1.45;
    color: var(--ink);
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .hero-actions .btn-ghost {
    appearance: none;
    background: rgba(10, 14, 22, 0.36);
    backdrop-filter: blur(8px);
    font-family: inherit;
    cursor: pointer;
  }
  .scroll-cue {
    position: absolute;
    bottom: 24px;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--mono);
    font-size: 10.5px;
    letter-spacing: 0.18em;
    color: var(--mute);
    text-decoration: none;
  }
  .scroll-cue:hover {
    color: var(--signal);
  }
  .cue-line {
    width: 28px;
    height: 1px;
    background: var(--signal);
    display: inline-block;
  }
</style>
