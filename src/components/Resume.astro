---
import { profile, ui, type Lang } from '../data/profile';
import { journeyUi } from '../data/journey';
import '../components/journey/journey.css';
import ActIdentity from './journey/ActIdentity.astro';
import Dossier from './journey/Dossier.astro';
import ActHops from './journey/ActHops.astro';
import ActControlPlane from './journey/ActControlPlane.astro';
import ActValue from './journey/ActValue.astro';
import Bgm from './Bgm.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'zh' ? '/en/' : '/';
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
const ext = (href: string) => (href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
---

<div class="journey-shell" id="journey-shell" data-ready="0">
  <div class="room-glow" aria-hidden="true"></div>
  <canvas id="packet-canvas" class="packet-canvas" aria-hidden="true"></canvas>

  <div class="spine-rail" aria-hidden="true">
    <div class="spine-fill"></div>
    <span class="spine-pct" id="spine-pct">0%</span>
  </div>

  <header class="nav">
    <a href="#act-1" class="brand">SL<span class="cursor">_</span></a>
    <nav aria-label={lang === 'zh' ? '故事章節' : 'Story beats'}>
      {journeyUi.nav.map((item) => (
        <a href={`#${item.id}`} data-act-nav={item.id}>
          <span class="nav-code">{item.code}</span>
          <span>{t(item.label)}</span>
        </a>
      ))}
    </nav>
    <div class="actions">
      <button type="button" class="icon-btn dossier-btn" data-dossier-open="dossier-essentials" aria-haspopup="dialog" aria-controls="dossier">
        {t(journeyUi.dossier.open)}
      </button>
      <button class="icon-btn" id="palette-btn" type="button" aria-label="Quick jump"><kbd>⌘K</kbd></button>
      <a class="lang" href={other} hreflang={lang === 'zh' ? 'en' : 'zh-Hant'}>{t(ui.switchLang)}</a>
    </div>
  </header>

  <main id="top" class="journey-main">
    <ActIdentity lang={lang} />
    <ActHops lang={lang} />
    <ActControlPlane lang={lang} />
    <ActValue lang={lang} />
  </main>

  <nav class="act-bar" aria-label={lang === 'zh' ? '章節導覽' : 'Beat navigation'}>
    <span class="act-bar-fill" aria-hidden="true"></span>
    {journeyUi.nav.map((item) => (
      <a href={`#${item.id}`} data-act-nav={item.id}>
        <span class="nav-code">{item.ready}%</span>
        <span>{t(item.label)}</span>
      </a>
    ))}
  </nav>

  <Dossier lang={lang} />

  <Bgm />

  <footer>© {new Date().getFullYear()} Shin Lin · The Night the Room Goes Live</footer>
</div>

<dialog id="palette" aria-label="Command palette">
  <input
    id="palette-input"
    type="text"
    aria-label={lang === 'zh' ? '搜尋章節或連結' : 'Search act or action'}
    placeholder={lang === 'zh' ? '跳轉章節或開啟連結…' : 'Jump to act or action…'}
    autocomplete="off"
  />
  <ul id="palette-list">
    {journeyUi.nav.map((item) => (
      <li>
        <a href={`#${item.id}`} data-cmd>
          {item.code} · {t(item.label)} <small>#{item.id}</small>
        </a>
      </li>
    ))}
    <li>
      <a href="#dossier" data-dossier-open="dossier-essentials" data-cmd>
        {t(journeyUi.dossier.open)} <small>dossier</small>
      </a>
    </li>
    {profile.links.map((l) => (
      <li>
        <a href={l.href} {...ext(l.href)} data-cmd>
          {l.label} <small>link</small>
        </a>
      </li>
    ))}
    <li>
      <a href={resumeHref} download data-cmd>
        {t(ui.resumePdf)} <small>PDF</small>
      </a>
    </li>
    <li>
      <a href={other} data-cmd>
        {lang === 'zh' ? 'Switch to English' : '切換為中文'} <small>lang</small>
      </a>
    </li>
  </ul>
</dialog>

<script>
  import { mountPacketCanvas } from '../scripts/motion/packet';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('packet-canvas') as HTMLCanvasElement | null;
  if (canvas) mountPacketCanvas(canvas, reduced);

  const shell = document.getElementById('journey-shell');
  const pct = document.getElementById('spine-pct');
  const setReady = (n: number) => {
    shell?.style.setProperty('--ready', String(n));
    if (pct) pct.textContent = `${n}%`;
  };
  setReady(0);

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-act-nav]');
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        navLinks.forEach((a) => {
          const on = a.dataset.actNav === en.target.id;
          a.classList.toggle('active', on);
          on ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current');
        });
        setReady(Number((en.target as HTMLElement).dataset.ready) || 0);
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  document.querySelectorAll('section[id^="act-"]').forEach((sec) => spy.observe(sec));

  const palette = document.getElementById('palette') as HTMLDialogElement | null;
  const dossier = document.getElementById('dossier');
  const backdrop = document.getElementById('dossier-backdrop');
  let opener: HTMLElement | null = null;
  const closeDossier = () => {
    if (!dossier || dossier.hidden) return;
    dossier.hidden = true;
    if (backdrop) backdrop.hidden = true;
    document.body.style.overflow = '';
    opener?.focus();
  };
  const openDossier = (targetId: string | undefined, from: HTMLElement) => {
    if (!dossier) return;
    opener = from;
    dossier.hidden = false;
    if (backdrop) backdrop.hidden = false;
    document.body.style.overflow = 'hidden';
    dossier.querySelectorAll('.focus').forEach((el) => el.classList.remove('focus'));
    const target = targetId ? document.getElementById(targetId) : null;
    if (target) {
      target.classList.add('focus');
      target.scrollIntoView({ block: 'start' });
    } else {
      dossier.scrollTop = 0;
    }
    dossier.focus({ preventScroll: true });
  };
  document.querySelectorAll<HTMLElement>('[data-dossier-open]').forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      palette?.open && palette.close();
      openDossier(el.dataset.dossierOpen, el);
    })
  );
  document.getElementById('dossier-close')?.addEventListener('click', closeDossier);
  backdrop?.addEventListener('click', closeDossier);
  dossier?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDossier();
      return;
    }
    if (e.key !== 'Tab') return;
    const f = [...dossier.querySelectorAll<HTMLElement>('a[href], button, input, [tabindex]:not([tabindex="-1"])')].filter((x) => !x.closest('[hidden]'));
    if (!f.length) return;
    const first = f[0];
    const last = f[f.length - 1];
    if (e.shiftKey && (document.activeElement === first || document.activeElement === dossier)) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  // Command palette
  const paletteInput = document.getElementById('palette-input') as HTMLInputElement | null;
  const paletteBtn = document.getElementById('palette-btn');
  const filter = () => {
    if (!palette || !paletteInput) return;
    const q = paletteInput.value.toLowerCase();
    palette.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.hidden = !li.textContent?.toLowerCase().includes(q);
    });
  };
  const open = () => {
    if (!palette || !paletteInput) return;
    palette.showModal();
    paletteInput.value = '';
    filter();
    paletteInput.focus();
  };
  paletteBtn?.addEventListener('click', open);
  paletteInput?.addEventListener('input', filter);
  palette?.addEventListener('click', (e) => {
    if (e.target === palette) palette.close();
  });
  palette?.querySelectorAll('[data-cmd]').forEach((a) => a.addEventListener('click', () => palette.close()));
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      palette?.open ? palette.close() : open();
    }
  });
</script>

<style is:global>
  @property --ready {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }
</style>

<style>
  /* Dark-blueprint palette locked for the interactive journey */
  .journey-shell {
    --bg: #0a0d12;
    --grid: #16202b;
    --signal: #3ee6ff;
    --human: #ffb547;
    --ok: #5cf29a;
    --ink: #e6edf3;
    --mute: #7d8b99;
    --warn: #ff7b72;
    --ready: 0;
    --text: #e6edf3;
    --muted: #7d8b99;
    --line: #1f2b38;
    --surface: #0f151f;
    --accent: #3ee6ff;
    --accent-soft: rgba(62, 230, 255, 0.1);
    --font: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'Noto Sans TC', 'PingFang TC', 'Microsoft JhengHei', sans-serif;
    font-family: var(--font);
    transition: --ready 0.9s ease;
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
  }

  .packet-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .spine-rail {
    position: fixed;
    top: 64px;
    bottom: 24px;
    left: clamp(8px, 1.8vw, 24px);
    width: 2px;
    background: var(--grid);
    z-index: 20;
    pointer-events: none;
  }
  .spine-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, var(--signal), var(--ok));
    transform-origin: 50% 0%;
    transform: scaleY(calc(var(--ready) / 100));
  }
  .spine-pct {
    position: absolute;
    bottom: -18px;
    left: -6px;
    font-family: var(--mono);
    font-size: 9px;
    color: var(--ok);
  }
  .room-glow {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 80% 60% at 50% 38%, rgba(92, 242, 154, 0.16), rgba(62, 230, 255, 0.07) 45%, transparent 75%);
    opacity: calc(var(--ready) / 100);
  }
  .dossier-btn {
    color: var(--ok);
    border-color: color-mix(in srgb, var(--ok) 45%, var(--grid));
    font-family: var(--mono);
  }

  .act-bar {
    display: none;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px clamp(20px, 5vw, 56px);
    background: rgba(10, 13, 18, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--grid);
  }
  .brand {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink);
  }
  .cursor {
    color: var(--signal);
  }
  .nav nav {
    display: flex;
    gap: 18px;
    font-size: 13px;
  }
  .nav nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--mute);
    transition: color 0.2s ease;
  }
  .nav nav a:hover,
  .nav nav a.active {
    color: var(--ink);
  }
  .nav-code {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn,
  .lang {
    font: inherit;
    font-size: 12px;
    color: var(--mute);
    background: transparent;
    border: 1px solid var(--grid);
    border-radius: 999px;
    padding: 5px 10px;
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:hover,
  .lang:hover {
    color: var(--ink);
    border-color: var(--signal);
  }
  .icon-btn kbd {
    font-family: var(--mono);
    font-size: 11px;
  }

  .journey-main {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 56px);
  }

  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 28px 20px 44px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    border-top: 1px solid var(--grid);
  }

  dialog {
    width: min(460px, 92vw);
    border: 1px solid var(--grid);
    border-radius: 14px;
    background: #0d1219;
    color: #e6edf3;
    padding: 10px;
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  #palette-input {
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1px solid #16202b;
    background: transparent;
    color: inherit;
    font: inherit;
    outline: none;
  }
  #palette-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  #palette-list a {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13.5px;
    color: inherit;
  }
  #palette-list a:hover {
    background: rgba(62, 230, 255, 0.1);
  }
  #palette-list small {
    font-family: var(--mono);
    color: #7d8b99;
  }

  @media (max-width: 720px) {
    .nav nav,
    .spine-rail {
      display: none;
    }
    .dossier-btn {
      padding: 5px 8px;
      font-size: 11px;
    }
    .act-bar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 45;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      background: rgba(10, 13, 18, 0.94);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--grid);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .act-bar a {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
      padding: 7px 2px 8px;
      font-size: 11px;
      color: var(--mute);
      text-decoration: none;
    }
    .act-bar a.active {
      color: var(--ink);
    }
    .act-bar a.active .nav-code {
      color: var(--ok);
    }
    .act-bar-fill {
      position: absolute;
      top: -1px;
      left: 0;
      height: 2px;
      width: calc(var(--ready) * 1%);
      background: linear-gradient(to right, var(--signal), var(--ok));
    }
    footer {
      padding-bottom: 76px;
    }
  }
</style>
