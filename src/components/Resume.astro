---
import { profile, ui, type Lang } from '../data/profile';
import { chapters } from '../data/story';
import {
  blueprintModules,
  blueprintUi,
  capabilityPillars,
  valueOutcomes,
  type ModuleId,
} from '../data/blueprint';
import BlueprintOverview from './BlueprintOverview.astro';
import SkillStack from './SkillStack.astro';
import Bgm from './Bgm.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'zh' ? '/en/' : '/';
const t = (o: Record<Lang, string>) => o[lang];
const workHref = (slug: string) => `${lang === 'zh' ? '' : '/en'}/work/${slug}/`;
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
// mailto must not open a blank tab.
const ext = (href: string) => (href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
const arrow = (href: string) => (href.startsWith('mailto:') ? '' : ' ↗');

const mottoParts = t(profile.motto)
  .split(/(\[[^\]]+\])/)
  .filter(Boolean)
  .map((p) => ({ text: p.replace(/^\[|\]$/g, ''), hl: p.startsWith('[') }));

const chapterBySlug = new Map(chapters.map((c) => [c.slug, c]));
const initialModule: ModuleId = 'identity';
---

<header class="nav">
  <a href="#top" class="brand">SL<span class="cursor">_</span></a>
  <nav aria-label="Modules">
    {blueprintModules.map((m) => (
      <a href={`#${m.id}`} data-nav-module={m.id}>
        <span class="nav-code">{m.code}</span>
        <span>{t(m.title)}</span>
      </a>
    ))}
  </nav>
  <div class="actions">
    <button class="icon-btn" id="palette-btn" type="button" aria-label={t(blueprintUi.palette)}>
      <kbd>⌘K</kbd>
    </button>
    <button class="icon-btn" id="theme-btn" type="button" aria-label="Toggle theme">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="9" />
        <path d="M12 3a9 9 0 0 0 0 18z" fill="currentColor" />
      </svg>
    </button>
    <a class="lang" href={other} hreflang={lang === 'zh' ? 'en' : 'zh-Hant'}>{t(ui.switchLang)}</a>
  </div>
</header>

<main id="top">
  <!-- Layer 1: Focused First-Screen Hook + 4-Module Animated Blueprint -->
  <section class="hero-stage">
    <div class="hero-copy">
      <a class="status-pill" href={workHref('metamec')}>
        <span class="dot" aria-hidden="true"></span>
        <span>{t(blueprintUi.badge)}</span>
        <span aria-hidden="true">→</span>
      </a>
      <h1 id="name">{t(profile.name)}</h1>
      <p class="hero-hook">{t(blueprintUi.hook)}</p>
      <p class="hero-sub">{t(blueprintUi.subhook)}</p>
      <div class="hero-actions">
        <a class="btn primary" href={resumeHref} download>{t(ui.resumePdf)}</a>
        {profile.links.map((l) => (
          <a class="btn" href={l.href} {...ext(l.href)}>
            {l.label}{arrow(l.href)}
          </a>
        ))}
      </div>
    </div>

    <div class="hero-visual">
      <BlueprintOverview lang={lang} initial={initialModule} />
    </div>
  </section>

  <!-- Layer 2: Progressive Disclosure Explorer Stage -->
  <section id="explorer" class="explorer" aria-label={lang === 'zh' ? '詳細架構展開區' : 'Module explorer'}>
    <div class="tab-bar" role="tablist" aria-label={lang === 'zh' ? '四大模組切換' : 'Switch module'}>
      {blueprintModules.map((m) => (
        <button
          type="button"
          role="tab"
          id={`tab-${m.id}`}
          aria-selected={m.id === initialModule}
          aria-controls={`panel-${m.id}`}
          class:list={['tab-btn', { active: m.id === initialModule }]}
          data-tab-module={m.id}
        >
          <span class="tab-code">{m.code}</span>
          <span class="tab-label">{t(m.title)}</span>
        </button>
      ))}
    </div>

    <div class="panels">
      <!-- 01 · Identity -->
      <div
        id="panel-identity"
        role="tabpanel"
        aria-labelledby="tab-identity"
        class="panel active"
        data-panel-module="identity"
      >
        <div class="bento-identity">
          <article class="bento-card span-2">
            <span class="card-kicker">01 · CORE STATEMENT</span>
            <h2 class="motto-line">
              {mottoParts.map((p) => (
                <span class:list={{ hl: p.hl }}>{p.text}</span>
              ))}
            </h2>
            <p class="lead-text">{t(profile.intro)}</p>
            <div class="meta-row">
              <span>📍 {t(profile.location)}</span>
              <span>·</span>
              <span>{t(profile.workMode)}</span>
            </div>
          </article>

          <article class="bento-card stats-card">
            <span class="card-kicker">METRICS</span>
            <div class="stats-grid">
              {profile.stats.map((s) => (
                <div class="stat-item">
                  <strong data-count={s.value}>{s.value}</strong>
                  <span>{t(s.label)}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="bento-card span-2">
            <span class="card-kicker">{t(ui.nav.education).toUpperCase()}</span>
            <div class="edu-list">
              {profile.education.map((ed) => (
                <div class="edu-item">
                  <div>
                    <strong>{t(ed.school)}</strong>
                    <span class="edu-deg">{t(ed.degree)}</span>
                  </div>
                  <span class="mono-dim">{ed.period}</span>
                </div>
              ))}
            </div>
          </article>

          <article class="bento-card contact-card">
            <span class="card-kicker">{t(ui.contactTitle).toUpperCase()}</span>
            <p class="muted-sm">{t(ui.contactText)}</p>
            <div class="mini-links">
              {profile.links.map((l) => (
                <a class="chip-link" href={l.href} {...ext(l.href)}>
                  {l.label}{arrow(l.href)}
                </a>
              ))}
            </div>
          </article>
        </div>
      </div>

      <!-- 02 · Track Record -->
      <div
        id="panel-experience"
        role="tabpanel"
        aria-labelledby="tab-experience"
        class="panel"
        data-panel-module="experience"
        hidden
      >
        <p class="panel-hint">{t(blueprintUi.stationPrompt)}</p>
        <div class="exp-layout">
          <div class="station-list" role="tablist" aria-label={lang === 'zh' ? '職涯站點' : 'Career stops'}>
            {profile.experience.map((job, idx) => {
              const ch = chapterBySlug.get(job.slug);
              return (
                <button
                  type="button"
                  role="tab"
                  aria-selected={idx === 0}
                  class:list={['station-btn', { active: idx === 0 }]}
                  data-station-btn={job.slug}
                >
                  <div class="st-top">
                    <span class="st-company">{t(job.company)}</span>
                    <span class="st-period">{job.period}</span>
                  </div>
                  <span class="st-story">{ch ? t(ch.title) : t(job.role)}</span>
                </button>
              );
            })}
          </div>

          <div class="station-detail">
            {profile.experience.map((job, idx) => {
              const ch = chapterBySlug.get(job.slug);
              return (
                <article
                  class:list={['detail-card', { active: idx === 0 }]}
                  data-station-panel={job.slug}
                  hidden={idx !== 0}
                >
                  <div class="detail-head">
                    <div>
                      {ch && <span class="card-kicker">{t(ch.label)} · {t(ch.title)}</span>}
                      <h3>{t(job.role)}</h3>
                      <p class="detail-sub">
                        {t(job.company)}
                        {job.team && ` · ${t(job.team)}`}
                      </p>
                    </div>
                    <span class="period-pill">{job.period}</span>
                  </div>
                  {ch && <p class="story-line">“{t(ch.line)}”</p>}
                  <ul class="impact-list">
                    {job.points[lang].slice(0, 4).map((pt) => (
                      <li>{pt}</li>
                    ))}
                  </ul>
                  <div class="detail-foot">
                    <div class="tags">
                      {job.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                    <a class="case-link" href={workHref(job.slug)}>
                      {t(blueprintUi.caseStudy)}
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </div>

      <!-- 03 · Capabilities (Tech, Communication, Problem Solving, Management) -->
      <div
        id="panel-capabilities"
        role="tabpanel"
        aria-labelledby="tab-capabilities"
        class="panel"
        data-panel-module="capabilities"
        hidden
      >
        <div class="bento-2x2">
          {capabilityPillars.map((cap) => (
            <article class="bento-card cap-card">
              <div class="cap-head">
                <span class="node-code">{cap.code}</span>
                <h3>{t(cap.title)}</h3>
              </div>
              <p class="cap-summary">{t(cap.summary)}</p>
              <ul class="impact-list">
                {cap.highlights[lang].map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            </article>
          ))}
        </div>

        <div class="matrix-drawer">
          <button
            type="button"
            class="drawer-toggle"
            id="matrix-toggle"
            aria-expanded="false"
            aria-controls="matrix-body"
          >
            <span data-label-open={t(blueprintUi.matrixToggle)} data-label-close={t(blueprintUi.matrixHide)}>
              {t(blueprintUi.matrixToggle)}
            </span>
            <span class="chevron" aria-hidden="true">▾</span>
          </button>
          <div id="matrix-body" class="matrix-body" hidden>
            <SkillStack lang={lang} />
          </div>
        </div>
      </div>

      <!-- 04 · Value & ROI for Audience -->
      <div
        id="panel-impact"
        role="tabpanel"
        aria-labelledby="tab-impact"
        class="panel"
        data-panel-module="impact"
        hidden
      >
        <div class="bento-2x2">
          {valueOutcomes.map((val) => (
            <a class="bento-card roi-card" href={`${lang === 'zh' ? '' : '/en'}${val.href}`}>
              <div class="roi-top">
                <span class="card-kicker">{t(val.tag)}</span>
                <span class="roi-arrow" aria-hidden="true">↗</span>
              </div>
              <h3>{t(val.title)}</h3>
              <p class="cap-summary">{t(val.outcome)}</p>
              <div class="tags">
                {val.proof.map((p) => (
                  <span class="tag">{p}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</main>

<Bgm />

<footer>© {new Date().getFullYear()} Shin Lin · Architecture Blueprint v2.0</footer>

<dialog id="palette" aria-label="Command palette">
  <input
    id="palette-input"
    type="text"
    placeholder={lang === 'zh' ? '輸入模組或指令…' : 'Jump to module or action…'}
    autocomplete="off"
  />
  <ul id="palette-list">
    {blueprintModules.map((m) => (
      <li>
        <a href={`#${m.id}`} data-cmd data-jump-module={m.id}>
          {m.code} · {t(m.title)} <small>{t(m.subtitle)}</small>
        </a>
      </li>
    ))}
    {profile.links.map((l) => (
      <li>
        <a href={l.href} {...ext(l.href)} data-cmd>
          {l.label} <small>{arrow(l.href) || 'mail'}</small>
        </a>
      </li>
    ))}
    <li>
      <a href={resumeHref} download data-cmd>
        {t(ui.resumePdf)} <small>PDF</small>
      </a>
    </li>
    <li>
      <a href={other} data-cmd>
        {lang === 'zh' ? 'Switch to English' : '切換為中文'} <small>lang</small>
      </a>
    </li>
    <li>
      <a href="#" data-cmd data-action="theme">
        {lang === 'zh' ? '切換深淺色' : 'Toggle theme'} <small>theme</small>
      </a>
    </li>
  </ul>
</dialog>

<script>
  const root = document.documentElement;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Pointer spotlight
  addEventListener('pointermove', (e) => {
    root.style.setProperty('--mx', e.clientX + 'px');
    root.style.setProperty('--my', e.clientY + 'px');
  });

  // Scroll progress bar
  const bar = document.querySelector<HTMLElement>('.progress');
  if (bar) {
    const onScroll = () => {
      const max = document.documentElement.scrollHeight - innerHeight;
      bar.style.transform = `scaleX(${max > 0 ? scrollY / max : 0})`;
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }

  // Theme toggle
  const themeBtn = document.getElementById('theme-btn');
  const toggleTheme = () => {
    const dark = root.dataset.theme
      ? root.dataset.theme === 'dark'
      : matchMedia('(prefers-color-scheme: dark)').matches;
    const next = dark ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  };
  themeBtn?.addEventListener('click', toggleTheme);

  // Module switching across Blueprint nodes, Top Nav, and Explorer Tabs
  const validModules = new Set(['identity', 'experience', 'capabilities', 'impact']);
  const explorer = document.getElementById('explorer');
  const blueprintNodes = document.querySelectorAll<HTMLElement>('[data-select-module]');
  const tabBtns = document.querySelectorAll<HTMLElement>('[data-tab-module]');
  const panels = document.querySelectorAll<HTMLElement>('[data-panel-module]');
  const navLinks = document.querySelectorAll<HTMLElement>('[data-nav-module]');

  const activateModule = (id: string, scrollIntoView = false) => {
    if (!validModules.has(id)) return;
    blueprintNodes.forEach((el) => el.classList.toggle('active', el.dataset.selectModule === id));
    tabBtns.forEach((el) => {
      const active = el.dataset.tabModule === id;
      el.classList.toggle('active', active);
      el.setAttribute('aria-selected', String(active));
    });
    panels.forEach((el) => {
      const active = el.dataset.panelModule === id;
      el.classList.toggle('active', active);
      el.hidden = !active;
    });
    navLinks.forEach((el) => el.classList.toggle('active', el.dataset.navModule === id));
    try {
      history.replaceState(null, '', `#${id}`);
    } catch {}
    if (scrollIntoView && explorer) {
      explorer.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }
  };

  blueprintNodes.forEach((el) =>
    el.addEventListener('click', () => activateModule(el.dataset.selectModule!, true))
  );
  tabBtns.forEach((el) =>
    el.addEventListener('click', () => activateModule(el.dataset.tabModule!, false))
  );
  navLinks.forEach((el) =>
    el.addEventListener('click', (e) => {
      e.preventDefault();
      activateModule(el.dataset.navModule!, true);
    })
  );

  // Restore module from URL hash on load
  const initialHash = location.hash.replace('#', '');
  if (validModules.has(initialHash)) {
    activateModule(initialHash, false);
  }

  // Station selector inside 02 Track Record
  const stationBtns = document.querySelectorAll<HTMLElement>('[data-station-btn]');
  const stationPanels = document.querySelectorAll<HTMLElement>('[data-station-panel]');
  stationBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const slug = btn.dataset.stationBtn;
      stationBtns.forEach((b) => {
        const active = b.dataset.stationBtn === slug;
        b.classList.toggle('active', active);
        b.setAttribute('aria-selected', String(active));
      });
      stationPanels.forEach((p) => {
        const active = p.dataset.stationPanel === slug;
        p.classList.toggle('active', active);
        p.hidden = !active;
      });
    });
  });

  // Expandable Skill Matrix drawer inside 03 Capabilities
  const matrixToggle = document.getElementById('matrix-toggle');
  const matrixBody = document.getElementById('matrix-body');
  if (matrixToggle && matrixBody) {
    const labelSpan = matrixToggle.querySelector<HTMLElement>('span[data-label-open]');
    matrixToggle.addEventListener('click', () => {
      const expanded = matrixToggle.getAttribute('aria-expanded') === 'true';
      const next = !expanded;
      matrixToggle.setAttribute('aria-expanded', String(next));
      matrixBody.hidden = !next;
      if (labelSpan) {
        labelSpan.textContent = next
          ? labelSpan.dataset.labelClose || ''
          : labelSpan.dataset.labelOpen || '';
      }
    });
  }

  // Command palette (Cmd/Ctrl + K)
  const palette = document.getElementById('palette') as HTMLDialogElement | null;
  const paletteInput = document.getElementById('palette-input') as HTMLInputElement | null;
  const paletteBtn = document.getElementById('palette-btn');
  const openPalette = () => {
    if (!palette || !paletteInput) return;
    palette.showModal();
    paletteInput.value = '';
    filterPalette();
    paletteInput.focus();
  };
  const filterPalette = () => {
    if (!palette || !paletteInput) return;
    const q = paletteInput.value.toLowerCase();
    palette.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.hidden = !li.textContent?.toLowerCase().includes(q);
    });
  };
  paletteBtn?.addEventListener('click', openPalette);
  paletteInput?.addEventListener('input', filterPalette);
  palette?.addEventListener('click', (e) => {
    if (e.target === palette) palette.close();
  });
  palette?.querySelectorAll<HTMLElement>('[data-cmd]').forEach((a) => {
    a.addEventListener('click', (e) => {
      if (a.dataset.action === 'theme') {
        e.preventDefault();
        toggleTheme();
      } else if (a.dataset.jumpModule) {
        e.preventDefault();
        activateModule(a.dataset.jumpModule, true);
      }
      palette.close();
    });
  });
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      palette?.open ? palette.close() : openPalette();
    }
  });
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px clamp(20px, 5vw, 56px);
    background: color-mix(in srgb, var(--bg) 84%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .brand {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-decoration: none;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink { 50% { opacity: 0; } }

  .nav nav {
    display: flex;
    gap: 18px;
    font-size: 13px;
  }
  .nav nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--muted);
    transition: color 0.2s ease;
  }
  .nav nav a:hover,
  .nav nav a.active {
    color: var(--text);
  }
  .nav-code {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn,
  .lang {
    font: inherit;
    font-size: 12px;
    color: var(--muted);
    background: transparent;
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 5px 10px;
    text-decoration: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .icon-btn:hover,
  .lang:hover {
    color: var(--text);
    border-color: var(--text);
  }
  .icon-btn kbd {
    font-family: var(--mono);
    font-size: 11px;
  }

  main {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
  }

  /* Layer 1: Hero + Blueprint Stage */
  .hero-stage {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.28fr);
    gap: clamp(24px, 4vw, 48px);
    align-items: center;
    padding: clamp(28px, 5vh, 52px) 0 clamp(28px, 4vh, 44px);
  }
  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    text-decoration: none;
    margin-bottom: 16px;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  .status-pill:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--ok) 24%, transparent);
  }

  h1 {
    margin: 0 0 10px;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 750;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .hero-hook {
    margin: 0 0 10px;
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 550;
    line-height: 1.45;
    color: var(--text);
  }
  .hero-sub {
    margin: 0 0 22px;
    font-size: 13.5px;
    color: var(--muted);
    line-height: 1.55;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    padding: 8px 14px;
    border-radius: 10px;
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.2s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.2s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
    border-color: var(--text);
  }
  .btn.primary {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  /* Layer 2: Explorer Stage */
  .explorer {
    padding: 20px 0 64px;
    scroll-margin-top: 68px;
  }
  .tab-bar {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
    padding: 6px;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: var(--surface);
    margin-bottom: 20px;
  }
  .tab-btn {
    appearance: none;
    font: inherit;
    color: var(--muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: 10px;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    cursor: pointer;
    transition:
      background 0.22s ease,
      color 0.22s ease,
      border-color 0.22s ease,
