---
import { profile, ui, type Lang } from '../data/profile';
import { journeyUi } from '../data/journey';
import ActIdentity from './journey/ActIdentity.astro';
import ActHops from './journey/ActHops.astro';
import ActControlPlane from './journey/ActControlPlane.astro';
import ActValue from './journey/ActValue.astro';
import Bgm from './Bgm.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'zh' ? '/en/' : '/';
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
const ext = (href: string) => (href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
---

<div class="journey-shell">
  <!-- Single DPR-capped Canvas 2D ambient packet overlay -->
  <canvas id="packet-canvas" class="packet-canvas" aria-hidden="true"></canvas>

  <!-- Continuous Signal Spine threading all 4 acts -->
  <div class="spine-rail" aria-hidden="true">
    <div class="spine-fill" id="spine-fill"></div>
  </div>

  <header class="nav">
    <a href="#act-1" class="brand">SL<span class="cursor">_</span></a>
    <nav aria-label="Journey acts">
      {journeyUi.nav.map((item) => (
        <a href={`#${item.id}`} data-act-nav={item.id}>
          <span class="nav-code">{item.code}</span>
          <span>{t(item.label)}</span>
        </a>
      ))}
    </nav>
    <div class="actions">
      <button class="icon-btn" id="palette-btn" type="button" aria-label="Quick jump">
        <kbd>⌘K</kbd>
      </button>
      <a class="lang" href={other} hreflang={lang === 'zh' ? 'en' : 'zh-Hant'}>{t(ui.switchLang)}</a>
    </div>
  </header>

  <main id="top" class="journey-main">
    <ActIdentity lang={lang} />
    <ActHops lang={lang} />
    <ActControlPlane lang={lang} />
    <ActValue lang={lang} />
  </main>

  <Bgm />

  <footer>© {new Date().getFullYear()} Shin Lin · The Living Request</footer>
</div>

<dialog id="palette" aria-label="Command palette">
  <input
    id="palette-input"
    type="text"
    aria-label={lang === 'zh' ? '搜尋章節或連結' : 'Search act or action'}
    placeholder={lang === 'zh' ? '跳轉章節或開啟連結…' : 'Jump to act or action…'}
    autocomplete="off"
  />
  <ul id="palette-list">
    {journeyUi.nav.map((item) => (
      <li>
        <a href={`#${item.id}`} data-cmd>
          {item.code} · {t(item.label)} <small>#{item.id}</small>
        </a>
      </li>
    ))}
    {profile.links.map((l) => (
      <li>
        <a href={l.href} {...ext(l.href)} data-cmd>
          {l.label} <small>link</small>
        </a>
      </li>
    ))}
    <li>
      <a href={resumeHref} download data-cmd>
        {t(ui.resumePdf)} <small>PDF</small>
      </a>
    </li>
    <li>
      <a href={other} data-cmd>
        {lang === 'zh' ? 'Switch to English' : '切換為中文'} <small>lang</small>
      </a>
    </li>
  </ul>
</dialog>

<script>
  import { mountPacketCanvas } from '../scripts/motion/packet';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const canvas = document.getElementById('packet-canvas') as HTMLCanvasElement | null;
  if (canvas) mountPacketCanvas(canvas, reduced);

  // Scroll-bound Signal Spine progress
  const spineFill = document.getElementById('spine-fill');
  const onScroll = () => {
    if (!spineFill) return;
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(Math.max(scrollY / max, 0), 1) : 0;
    spineFill.style.transform = `scaleY(${p})`;
  };
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Active act indicator in top nav
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-act-nav]');
  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (en.isIntersecting) {
          navLinks.forEach((a) => a.classList.toggle('active', a.dataset.actNav === en.target.id));
        }
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  document.querySelectorAll('section[id^="act-"]').forEach((s) => spy.observe(s));

  // Command palette
  const palette = document.getElementById('palette') as HTMLDialogElement | null;
  const paletteInput = document.getElementById('palette-input') as HTMLInputElement | null;
  const paletteBtn = document.getElementById('palette-btn');
  const filter = () => {
    if (!palette || !paletteInput) return;
    const q = paletteInput.value.toLowerCase();
    palette.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.hidden = !li.textContent?.toLowerCase().includes(q);
    });
  };
  const open = () => {
    if (!palette || !paletteInput) return;
    palette.showModal();
    paletteInput.value = '';
    filter();
    paletteInput.focus();
  };
  paletteBtn?.addEventListener('click', open);
  paletteInput?.addEventListener('input', filter);
  palette?.addEventListener('click', (e) => {
    if (e.target === palette) palette.close();
  });
  palette?.querySelectorAll('[data-cmd]').forEach((a) => a.addEventListener('click', () => palette.close()));
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      palette?.open ? palette.close() : open();
    }
  });
</script>

<style>
  /* Dark-blueprint palette locked for the interactive journey */
  .journey-shell {
    --bg: #0a0d12;
    --grid: #16202b;
    --signal: #3ee6ff;
    --human: #ffb547;
    --ok: #5cf29a;
    --ink: #e6edf3;
    --mute: #7d8b99;
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
  }

  .packet-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .spine-rail {
    position: fixed;
    top: 64px;
    bottom: 24px;
    left: clamp(8px, 1.8vw, 24px);
    width: 2px;
    background: var(--grid);
    z-index: 20;
    pointer-events: none;
  }
  .spine-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, var(--signal), var(--ok));
    transform-origin: 50% 0%;
    transform: scaleY(0);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px clamp(20px, 5vw, 56px);
    background: rgba(10, 13, 18, 0.86);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--grid);
  }
  .brand {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink);
  }
  .cursor {
    color: var(--signal);
  }
  .nav nav {
    display: flex;
    gap: 18px;
    font-size: 13px;
  }
  .nav nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--mute);
    transition: color 0.2s ease;
  }
  .nav nav a:hover,
  .nav nav a.active {
    color: var(--ink);
  }
  .nav-code {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .icon-btn,
  .lang {
    font: inherit;
    font-size: 12px;
    color: var(--mute);
    background: transparent;
    border: 1px solid var(--grid);
    border-radius: 999px;
    padding: 5px 10px;
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:hover,
  .lang:hover {
    color: var(--ink);
    border-color: var(--signal);
  }
  .icon-btn kbd {
    font-family: var(--mono);
    font-size: 11px;
  }

  .journey-main {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 56px);
  }

  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 28px 20px 44px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    border-top: 1px solid var(--grid);
  }

  dialog {
    width: min(460px, 92vw);
    border: 1px solid var(--grid);
    border-radius: 14px;
    background: #0d1219;
    color: #e6edf3;
    padding: 10px;
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  #palette-input {
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1px solid #16202b;
    background: transparent;
    color: inherit;
    font: inherit;
    outline: none;
  }
  #palette-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  #palette-list a {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13.5px;
    color: inherit;
  }
  #palette-list a:hover {
    background: rgba(62, 230, 255, 0.1);
  }
  #palette-list small {
    font-family: var(--mono);
    color: #7d8b99;
  }

  @media (max-width: 720px) {
    .nav nav,
    .spine-rail {
      display: none;
    }
  }
</style>
