---
import { profile, ui, type Lang } from '../data/profile';
import { journeyUi } from '../data/journey';
import HeroWelcome from './journey/HeroWelcome.astro';
import ActIdentity from './journey/ActIdentity.astro';
import ActHops from './journey/ActHops.astro';
import ActControlPlane from './journey/ActControlPlane.astro';
import ActValue from './journey/ActValue.astro';
import Dossier from './journey/Dossier.astro';
import Bgm from './Bgm.astro';
import './journey/journey.css';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other = lang === 'zh' ? '/en/' : '/';
const t = (o: Record<Lang, string>) => o[lang];
const resumeHref = `/Shin-Lin-Resume-${lang}.pdf`;
const ext = (href: string) => (href.startsWith('mailto:') ? {} : { target: '_blank', rel: 'noopener' });
---

<div class="journey-shell" style="--ready: 0">
  <!-- Interactive Three.js 3D lattice & particle constellation -->
  <div id="scene-3d" class="scene-3d" aria-hidden="true"></div>

  <div class="spine-rail" aria-hidden="true">
    <div class="spine-fill" id="spine-fill"></div>
    <span class="spine-pct" id="spine-pct">0%</span>
  </div>

  <header class="nav">
    <a href="#hero" class="brand">SL<span class="cursor">_</span></a>
    <nav aria-label={lang === 'zh' ? '章節導覽' : 'Sections'}>
      {journeyUi.nav.map((item) => (
        <a href={`#${item.id}`} data-act-nav={item.id}>
          <span class="nav-code">{item.code}</span>
          <span>{t(item.label)}</span>
        </a>
      ))}
    </nav>
    <div class="actions">
      <button type="button" class="dossier-nav-btn" data-open-dossier>
        {t(journeyUi.dossier.open)}
      </button>
      <button class="icon-btn" id="palette-btn" type="button" aria-label="Quick jump">
        <kbd>⌘K</kbd>
      </button>
      <a class="lang" href={other} hreflang={lang === 'zh' ? 'en' : 'zh-Hant'}>{t(ui.switchLang)}</a>
    </div>
  </header>

  <main id="top" class="journey-main">
    <HeroWelcome lang={lang} />
    <ActIdentity lang={lang} />
    <ActHops lang={lang} />
    <ActControlPlane lang={lang} />
    <ActValue lang={lang} />
  </main>

  <nav class="mobile-act-bar" aria-label={lang === 'zh' ? '章節進度' : 'Section progress'}>
    {journeyUi.nav.map((item) => (
      <a href={`#${item.id}`} data-act-nav={item.id}>
        <span>{item.code}</span>
        <small>{t(item.label)}</small>
      </a>
    ))}
    <button type="button" class="mob-dossier" data-open-dossier>
      <span>+</span>
      <small>{lang === 'zh' ? '實證' : 'Dossier'}</small>
    </button>
  </nav>

  <Dossier lang={lang} />
  <Bgm />

  <footer>© {new Date().getFullYear()} Shin Lin · {t(journeyUi.storyLabel)}</footer>
</div>

<dialog id="palette" aria-label="Command palette">
  <input
    id="palette-input"
    type="text"
    aria-label={lang === 'zh' ? '搜尋章節或連結' : 'Search section or action'}
    placeholder={lang === 'zh' ? '跳轉章節、開啟實證或連結…' : 'Jump to section, dossier, or link…'}
    autocomplete="off"
  />
  <ul id="palette-list">
    {journeyUi.nav.map((item) => (
      <li>
        <a href={`#${item.id}`} data-cmd>
          {item.code} · {t(item.label)} <small>#{item.id}</small>
        </a>
      </li>
    ))}
    <li>
      <a href="#dossier" data-cmd data-open-dossier>
        {t(journeyUi.dossier.open)} <small>drawer</small>
      </a>
    </li>
    {profile.links.map((l) => (
      <li>
        <a href={l.href} {...ext(l.href)} data-cmd>
          {l.label} <small>link</small>
        </a>
      </li>
    ))}
    <li>
      <a href={resumeHref} download data-cmd>
        {t(ui.resumePdf)} <small>PDF</small>
      </a>
    </li>
    <li>
      <a href={other} data-cmd>
        {lang === 'zh' ? 'Switch to English' : '切換為中文'} <small>lang</small>
      </a>
    </li>
  </ul>
</dialog>

<script>
  import { mountScene3D } from '../scripts/scene3d';

  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sceneEl = document.getElementById('scene-3d');
  if (sceneEl) mountScene3D(sceneEl, reduced);

  const shell = document.querySelector<HTMLElement>('.journey-shell');
  const spineFill = document.getElementById('spine-fill');
  const spinePct = document.getElementById('spine-pct');

  const setReadiness = (pct: number) => {
    const clamped = Math.max(0, Math.min(100, Math.round(pct)));
    if (shell) shell.style.setProperty('--ready', String(clamped));
    if (spineFill) spineFill.style.transform = `scaleY(${clamped / 100})`;
    if (spinePct) spinePct.textContent = `${clamped}%`;
  };

  const navLinks = document.querySelectorAll<HTMLAnchorElement>('[data-act-nav]');
  const sectionMap = new Map<string, number>([
    ['hero', 0],
    ['act-1', 25],
    ['act-2', 50],
    ['act-3', 75],
    ['act-4', 100],
  ]);

  const spy = new IntersectionObserver(
    (entries) => {
      entries.forEach((en) => {
        if (!en.isIntersecting) return;
        const id = en.target.id;
        navLinks.forEach((a) => a.classList.toggle('active', a.dataset.actNav === id));
        const targetReady = sectionMap.get(id);
        if (targetReady !== undefined) setReadiness(targetReady);
      });
    },
    { rootMargin: '-40% 0px -50% 0px' }
  );
  document.querySelectorAll('section[id]').forEach((s) => spy.observe(s));

  // Dossier drawer controller with focus return
  const dossier = document.getElementById('dossier-drawer');
  const dossierClose = document.getElementById('dossier-close');
  let lastTrigger: HTMLElement | null = null;

  const openDossier = (stopSlug?: string, openSkills = false) => {
    if (!dossier) return;
    lastTrigger = document.activeElement as HTMLElement | null;
    dossier.hidden = false;
    document.body.style.overflow = 'hidden';

    if (openSkills) {
      const sk = document.getElementById('dossier-skills') as HTMLDetailsElement | null;
      if (sk) {
        sk.open = true;
        sk.scrollIntoView({ block: 'start' });
      }
    } else if (stopSlug) {
      const target = dossier.querySelector<HTMLElement>(`[data-dossier-stop="${stopSlug}"]`);
      if (target) {
        dossier.querySelectorAll('[data-dossier-stop]').forEach((el) => el.classList.remove('highlight'));
        target.classList.add('highlight');
        target.scrollIntoView({ block: 'center' });
      }
    }
    dossierClose?.focus();
  };

  const closeDossier = () => {
    if (!dossier || dossier.hidden) return;
    dossier.hidden = true;
    document.body.style.overflow = '';
    lastTrigger?.focus();
  };

  document.querySelectorAll<HTMLElement>('[data-open-dossier]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      openDossier(btn.dataset.dossierStop, btn.dataset.dossierSkills === 'true');
    });
  });
  dossierClose?.addEventListener('click', closeDossier);
  dossier?.querySelector('[data-dossier-backdrop]')?.addEventListener('click', closeDossier);
  addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && dossier && !dossier.hidden) closeDossier();
  });

  // Command palette
  const palette = document.getElementById('palette') as HTMLDialogElement | null;
  const paletteInput = document.getElementById('palette-input') as HTMLInputElement | null;
  const paletteBtn = document.getElementById('palette-btn');
  const filter = () => {
    if (!palette || !paletteInput) return;
    const q = paletteInput.value.toLowerCase();
    palette.querySelectorAll<HTMLElement>('li').forEach((li) => {
      li.hidden = !li.textContent?.toLowerCase().includes(q);
    });
  };
  const openPalette = () => {
    if (!palette || !paletteInput) return;
    palette.showModal();
    paletteInput.value = '';
    filter();
    paletteInput.focus();
  };
  paletteBtn?.addEventListener('click', openPalette);
  paletteInput?.addEventListener('input', filter);
  palette?.addEventListener('click', (e) => {
    if (e.target === palette) palette.close();
  });
  palette?.querySelectorAll('[data-cmd]').forEach((a) => a.addEventListener('click', () => palette.close()));
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      palette?.open ? palette.close() : openPalette();
    }
  });
</script>

<style>
  .journey-shell {
    --bg: #0a0d12;
    --grid: #16202b;
    --signal: #3ee6ff;
    --human: #ffb547;
    --ok: #5cf29a;
    --ink: #e6edf3;
    --mute: #7d8b99;
    position: relative;
    min-height: 100vh;
    background: var(--bg);
    color: var(--ink);
  }
  .scene-3d {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    opacity: 0.9;
  }

  .spine-rail {
    position: fixed;
    top: 64px;
    bottom: 24px;
    left: clamp(8px, 1.8vw, 24px);
    width: 2px;
    background: var(--grid);
    z-index: 20;
    pointer-events: none;
  }
  .spine-fill {
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, var(--signal), var(--ok));
    transform-origin: 50% 0%;
    transform: scaleY(0);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .spine-pct {
    position: absolute;
    bottom: -18px;
    left: -6px;
    font-family: var(--mono);
    font-size: 9.5px;
    color: var(--ok);
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px clamp(20px, 5vw, 56px);
    background: rgba(10, 13, 18, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--grid);
  }
  .brand {
    font-family: var(--mono);
    font-weight: 700;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--ink);
  }
  .cursor {
    color: var(--signal);
  }
  .nav nav {
    display: flex;
    gap: 18px;
    font-size: 13px;
  }
  .nav nav a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: var(--mute);
    transition: color 0.2s ease;
  }
  .nav nav a:hover,
  .nav nav a.active {
    color: var(--ink);
  }
  .nav-code {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--signal);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dossier-nav-btn {
    appearance: none;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--ok);
    background: rgba(92, 242, 154, 0.08);
    border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent);
    border-radius: 999px;
    padding: 5px 11px;
    cursor: pointer;
  }
  .icon-btn,
  .lang {
    font: inherit;
    font-size: 12px;
    color: var(--mute);
    background: transparent;
    border: 1px solid var(--grid);
    border-radius: 999px;
    padding: 5px 10px;
    text-decoration: none;
    cursor: pointer;
  }
  .icon-btn:hover,
  .lang:hover {
    color: var(--ink);
    border-color: var(--signal);
  }
  .icon-btn kbd {
    font-family: var(--mono);
    font-size: 11px;
  }

  .journey-main {
    position: relative;
    z-index: 1;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 clamp(24px, 5vw, 56px);
  }

  .mobile-act-bar {
    display: none;
  }

  footer {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 28px 20px 44px;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--mute);
    border-top: 1px solid var(--grid);
  }

  dialog {
    width: min(460px, 92vw);
    border: 1px solid var(--grid);
    border-radius: 14px;
    background: #0d1219;
    color: #e6edf3;
    padding: 10px;
  }
  dialog::backdrop {
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(4px);
  }
  #palette-input {
    width: 100%;
    padding: 10px 12px;
    border: 0;
    border-bottom: 1px solid #16202b;
    background: transparent;
    color: inherit;
    font: inherit;
    outline: none;
  }
  #palette-list {
    list-style: none;
    margin: 6px 0 0;
    padding: 0;
  }
  #palette-list a {
    display: flex;
    justify-content: space-between;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 13.5px;
    color: inherit;
  }
  #palette-list a:hover {
    background: rgba(62, 230, 255, 0.1);
  }
  #palette-list small {
    font-family: var(--mono);
    color: #7d8b99;
  }

  @media (max-width: 720px) {
    .nav nav,
    .spine-rail {
      display: none;
    }
    .mobile-act-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 45;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      background: rgba(10, 13, 18, 0.94);
      backdrop-filter: blur(12px);
      border-top: 1px solid var(--grid);
      padding: 6px 6px calc(6px + env(safe-area-inset-bottom));
    }
    .mobile-act-bar a,
    .mob-dossier {
      appearance: none;
      background: none;
      border: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1px;
      text-decoration: none;
      color: var(--mute);
      font-family: var(--mono);
      font-size: 10px;
      padding: 4px 2px;
      cursor: pointer;
    }
    .mobile-act-bar a.active {
      color: var(--signal);
    }
    .mob-dossier {
      color: var(--ok);
    }
    .mobile-act-bar small {
      font-family: var(--font);
      font-size: 10px;
    }
    footer {
      padding-bottom: 84px;
    }
  }
</style>
