---
import { roles, requirements, type RoleId } from '../data/fit';

interface Props { lang: 'zh' | 'en' }
const { lang } = Astro.props;
const labels = {
  kicker: { zh: '我能帶來什麼', en: 'What I bring' },
  title: { zh: '對應市場最需要的兩種角色', en: 'Built for two roles the market needs now' },
  footer: { zh: '項核心要求，每一項都有實際經歷佐證', en: 'core requirements, each backed by real work' },
};
const initialRole: RoleId = 'delivery';
const initialCount = requirements.filter((item) => item.roles.includes(initialRole)).length;
---

<section class="fit-panel" data-fit-panel aria-labelledby={`fit-title-${lang}`}>
  <div class="heading">
    <div>
      <p class="kicker">{labels.kicker[lang]}</p>
      <h2 id={`fit-title-${lang}`}>{labels.title[lang]}</h2>
    </div>
    <div class="tabs" role="tablist" aria-label={labels.title[lang]}>
      {roles.map((role) => (
        <button type="button" role="tab" data-role={role.id} aria-selected={role.id === initialRole} tabindex={role.id === initialRole ? 0 : -1}>
          {role.name[lang]}
        </button>
      ))}
    </div>
  </div>
  <div class="rows">
    {requirements.map((item) => (
      <a class:list={['row', { active: item.roles.includes(initialRole) }]} data-roles={item.roles.join(' ')} href={`${lang === 'en' ? '/en' : ''}${item.href}`}>
        <span class="check" aria-hidden="true">✓</span>
        <span class="copy"><strong>{item.need[lang]}</strong><span>{item.evidence[lang]}</span></span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </div>
  <p class="footer" aria-live="polite"><span data-count>{initialCount}</span> {labels.footer[lang]}</p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-fit-panel]').forEach((panel) => {
    const tabs = [...panel.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const rows = [...panel.querySelectorAll<HTMLAnchorElement>('.row')];
    const count = panel.querySelector<HTMLElement>('[data-count]');
    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((candidate) => {
        const selected = candidate === tab;
        candidate.setAttribute('aria-selected', String(selected));
        candidate.tabIndex = selected ? 0 : -1;
      });
      let activeCount = 0;
      rows.forEach((row) => {
        const active = row.dataset.roles?.split(' ').includes(tab.dataset.role ?? '') ?? false;
        row.classList.toggle('active', active);
        if (active) activeCount++;
      });
      if (count) count.textContent = String(activeCount);
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (event) => {
        const offset = event.key === 'ArrowRight' ? 1 : event.key === 'ArrowLeft' ? -1 : 0;
        if (!offset) return;
        event.preventDefault();
        const next = tabs[(index + offset + tabs.length) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>

<style>
  .fit-panel { min-width: 0; padding: 24px; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 22px; }
  .kicker { margin: 0 0 6px; color: var(--muted); font-size: 13px; }
  h2 { margin: 0; font-size: clamp(23px, 3vw, 32px); line-height: 1.3; }
  .tabs { display: inline-flex; max-width: 100%; padding: 3px; border: 1px solid var(--line); border-radius: 999px; }
  .tabs button { min-width: 0; padding: 7px 13px; border: 0; border-radius: 999px; background: transparent; color: var(--muted); font: 600 13px var(--font); cursor: pointer; }
  .tabs button[aria-selected="true"] { background: var(--accent); color: #fff; }
  .tabs button:focus-visible, .row:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .rows { display: grid; gap: 6px; }
  .row { display: flex; min-width: 0; align-items: center; gap: 14px; padding: 13px 12px; border-left: 3px solid transparent; border-radius: 8px; color: var(--text); text-decoration: none; opacity: .35; transition: opacity .25s, border-color .25s, background-color .25s; }
  .row.active { border-left-color: var(--accent); opacity: 1; }
  .row:hover, .row:focus-visible { background: var(--accent-soft); opacity: 1; }
  .check { display: grid; flex: 0 0 28px; height: 28px; place-items: center; border: 1.5px solid var(--accent); border-radius: 50%; color: var(--accent); font-size: 15px; font-weight: 700; }
  .active .check { background: var(--accent); color: var(--surface); }
  .copy { display: grid; min-width: 0; gap: 2px; overflow-wrap: anywhere; }
  .copy strong { font-size: 16px; line-height: 1.45; }
  .copy span { color: var(--muted); font-size: 14px; line-height: 1.5; }
  .arrow { flex: none; margin-left: auto; color: var(--accent); font-size: 22px; }
  .footer { margin: 18px 0 0; padding-top: 14px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
  @media (max-width: 480px) { .fit-panel { padding: 20px; } .row { gap: 10px; padding: 12px 7px; } .tabs { width: 100%; } .tabs button { flex: 1; padding-inline: 8px; } }
  @media (prefers-reduced-motion: reduce) { .row { transition: none; } }
</style>
